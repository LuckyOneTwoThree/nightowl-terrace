<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 动态环境微光 -->
  <view class="glow glow-amber"></view>
  <view class="glow glow-teal"></view>

  <!-- ==================== 1. 顶栏天梯标题 ==================== -->
  <view class="hero-head">
    <view class="hh-title-wrap">
      <text class="hero-title hl">夜猫风云榜</text>
      <text class="mono muted hh-sub">NIGHTOWL ARENA LADDER</text>
    </view>
    <view class="chip chip-amber hl board-top-tag">
      <view class="v-icon v-trophy text-amber"></view>
      <text>{{curTab === 'season' ? '赛季争霸' : curTab === 'guess' ? '本周预言' : '深夜修仙'}}</text>
    </view>
  </view>

  <!-- ==================== 2. 榜单 Tab 切换器 ==================== -->
  <view class="board-tabs">
    <view class="btab {{curTab === item.id ? 'active floodlight-glow' : ''}}"
          wx:for="{{tabList}}" wx:key="id"
          data-tab="{{item.id}}" bindtap="onSwitchTab">
      <text class="hl">{{item.zh}}</text>
    </view>
  </view>

  <!-- 动态规则透视条 (Rule Strip) -->
  <view class="board-rule-strip card-low">
    <view class="v-icon {{curTab === 'season' ? 'v-trophy text-amber' : curTab === 'guess' ? 'v-bolt text-teal' : 'v-moon text-amber'}} rule-strip-ic"></view>
    <text class="mono muted rule-strip-txt" wx:if="{{curTab === 'season'}}">全季 1,752 场预测积分滚雪球累计 · 争夺赛季预言之神</text>
    <text class="mono muted rule-strip-txt" wx:elif="{{curTab === 'guess'}}">统计本周所有场次预测积分 · 每周一 00:00 开启新周冲刺</text>
    <text class="mono muted rule-strip-txt" wx:else>统计本周深夜场次看球成本 · 评选最狠一夜硬核老猫</text>
  </view>
  
  <!-- 修仙打卡专属统计（仅在夜猫榜展示） -->
  <view class="stat card-highest floodlight-glow" wx:if="{{curTab === 'owl'}}">
    <text class="mono muted stat-sub">本周我的修仙战报</text>
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{stats.n}}</text>
        <text class="mono muted stat-u">场已熬</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{stats.hours}}</text>
        <text class="mono muted stat-u">累计耗时</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-teal score-sm">{{stats.streak}}</text>
        <text class="mono muted stat-u">周连熬</text>
      </view>
    </view>
  </view>

  <!-- 赛季积分专属统计（仅在赛季总榜展示） -->
  <view class="stat card-highest floodlight-glow" wx:if="{{curTab === 'season'}}">
    <text class="mono muted stat-sub">2026/27 赛季预言战绩总览 (全季通算)</text>
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{myVal || '0 分'}}</text>
        <text class="mono muted stat-u">我的赛季总分</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-teal score-sm">{{mySeasonRateText || '0%'}}</text>
        <text class="mono muted stat-u">赛季命中率</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{mySeasonHitText || '0 场'}}</text>
        <text class="mono muted stat-u">已猜中场次</text>
      </view>
    </view>
  </view>

  <!-- 盲评周榜专属统计 -->
  <view class="stat card-highest floodlight-glow" wx:if="{{curTab === 'guess'}}">
    <text class="mono muted stat-sub">本周预测战绩总览 (当周所有场次)</text>
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{myVal || '0 分'}}</text>
        <text class="mono muted stat-u">本周已获积分</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-teal score-sm">{{myWeekRateText || '0%'}}</text>
        <text class="mono muted stat-u">本周命中率</text>
      </view>
      <view class="stat-div"></view>
      <view class="stat-item">
        <text class="stat-num hl text-amber score-sm">{{myWeekHitText || '0 场'}}</text>
        <text class="mono muted stat-u">本周猜中场次</text>
      </view>
    </view>
  </view>

  <!-- 打卡卡：开球后 30 分钟内（仅在夜猫榜展示） -->
  <block wx:if="{{curTab === 'owl'}}">
    <view class="live card-highest floodlight-glow" wx:if="{{live}}" data-id="{{live.id}}" bindtap="goDetail">
      <view class="accent-bar"></view>
      <view class="live-status">
        <view class="dot-amber animate-pulse"></view>
        <text class="mono text-amber">正在开球 · 30分钟内打卡锁定成就</text>
      </view>
      
      <view class="live-vs">
        <view class="lv-side">
          <image class="crest-md" src="{{live.home.logo}}" mode="aspectFill" wx:if="{{live.home.logo}}" /><view class="circle-md crest-fb" wx:else style="background: {{live.home.bg}}; border-color: {{live.home.bd}};">{{live.home.id}}</view>
          <text class="lv-name hl">{{live.home.zh}}</text>
        </view>
        <view class="lv-mid">
          <text class="score-m sm hl text-amber">{{live.hm}}</text>
          <view class="chip chip-solid">{{live.lgZh}}</view>
        </view>
        <view class="lv-side">
          <image class="crest-md" src="{{live.away.logo}}" mode="aspectFill" wx:if="{{live.away.logo}}" /><view class="circle-md crest-fb" wx:else style="background: {{live.away.bg}}; border-color: {{live.away.bd}};">{{live.away.id}}</view>
          <text class="lv-name hl">{{live.away.zh}}</text>
        </view>
      </view>
      
      <button class="btn-amber {{checked ? 'done' : 'floodlight-glow'}}" catchtap="checkin">
        <view class="v-icon v-check" wx:if="{{checked}}"></view>
        <view class="v-icon v-moon" wx:else></view>
        <text>{{checked ? '已成功打卡 ✓' : '我在修仙 · 累计 +' + live.cost + 'h'}}</text>
      </button>
      <text class="live-note mono muted">S2及以上凌晨场开球后30分钟内有效</text>
    </view>

    <!-- 无可打卡：今晚凌晨档预告 -->
    <view class="live card-low" wx:elif="{{preview}}" data-id="{{preview.id}}" bindtap="goDetail">
      <view class="accent-bar gray"></view>
      <view class="live-status">
        <view class="dot-teal"></view>
        <text class="mono muted">今晚修仙场预告</text>
      </view>
      <view class="live-vs">
        <view class="lv-side">
          <image class="crest-md" src="{{preview.home.logo}}" mode="aspectFill" wx:if="{{preview.home.logo}}" /><view class="circle-md crest-fb" wx:else style="background: {{preview.home.bg}}; border-color: {{preview.home.bd}};">{{preview.home.id}}</view>
          <text class="lv-name hl">{{preview.home.zh}}</text>
        </view>
        <view class="lv-mid">
          <text class="hl hl-md match-time">{{preview.dayLabel}} {{preview.hm}}</text>
          <view class="chip chip-ghost">{{preview.lgZh}}</view>
        </view>
        <view class="lv-side">
          <image class="crest-md" src="{{preview.away.logo}}" mode="aspectFill" wx:if="{{preview.away.logo}}" /><view class="circle-md crest-fb" wx:else style="background: {{preview.away.bg}}; border-color: {{preview.away.bd}};">{{preview.away.id}}</view>
          <text class="lv-name hl">{{preview.away.zh}}</text>
        </view>
      </view>
      <text class="live-note mono muted">开球后 30 分钟内回来打卡</text>
    </view>
  </block>

  <!-- ==================== 3. 榜单行展示 ==================== -->
  <view class="sect sect-gap">
    <view class="sect-head-row">
      <text class="sect-title">{{curTab === 'season' ? '赛季总积分榜 Top 50' : curTab === 'guess' ? '本周盲评风云榜' : '本周修仙肝度榜'}}</text>
      <text class="chip chip-teal demo-chip" wx:if="{{ranks.length}}">● 实时天梯</text>
    </view>
    <view class="sect-line"></view>
  </view>

  <view class="rank-card card-low">
    <!-- 空榜引导 -->
    <view class="rank-empty" wx:if="{{!ranks.length}}">
      <view class="v-icon v-moon rank-empty-icon text-amber"></view>
      <text class="rank-empty-title hl">天梯虚位以待</text>
      <text class="rank-empty-sub mono muted">{{curTab === 'season' ? '封存预言 · 结算后赛季积分自动登榜' : curTab === 'guess' ? '本周盲评第一人，虚位以待' : '看球打卡 · 做本周熬得最狠的夜猫'}}</text>
    </view>

    <view class="rank-row {{item.rank <= 3 ? 'podium-' + item.rank : ''}}" wx:for="{{ranks}}" wx:key="rank">
      <view class="rk-no-wrap">
        <text class="rk-no rank-{{item.rank}} hl">{{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : item.rank === 3 ? '🥉' : item.rank}}</text>
      </view>
      <view class="circle-sm rk-avatar">{{item.name[0]}}</view>
      <view class="rk-info">
        <text class="rk-name hl">{{item.name}}</text>
        <text class="mono muted rk-s">{{item.sub}}</text>
      </view>
      <text class="rk-h hl text-amber mono">{{item.val}}</text>
    </view>

    <!-- 我的排位行 -->
    <view class="rank-row user-row card-high">
      <text class="rk-no user-rank hl">{{myRankNo || '-'}}</text>
      <view class="circle-sm user-avatar">
        <view class="v-icon v-paw text-amber" style="width: 26rpx; height: 26rpx;"></view>
      </view>
      <view class="rk-info">
        <text class="rk-name hl text-amber">我 ({{myNick}})</text>
        <text class="mono muted rk-s">{{mySub || (curTab === 'season' ? '赛季累积分数' : curTab === 'guess' ? '本周预测记录' : '连续修仙记录')}}</text>
      </view>
      <text class="rk-h hl text-amber mono">{{myVal || (curTab === 'owl' ? stats.hours + 'h' : '-')}}</text>
    </view>
  </view>

  <!-- ==================== 4. 微信群友 PK 互动面板 ==================== -->
  <view class="group-pk-card card-highest floodlight-glow">
    <view class="gpk-head">
      <view class="v-icon v-gift text-amber"></view>
      <text class="hl hl-md">微信群友看球 PK 赛</text>
    </view>
    <text class="gpk-sub mono muted">转发本榜至微信群，与看球搭子实时比拼盲评命中与积分！</text>
    <view class="gpk-acts">
      <button class="btn-amber gpk-btn" open-type="share">
        <view class="v-icon v-paw"></view>
        <text>分享榜单至群</text>
      </button>
      <button class="btn-teal-ghost gpk-btn" bindtap="share">
        <view class="v-icon v-bolt text-teal"></view>
        <text>复制专属战报</text>
      </button>
    </view>
  </view>

  <!-- 周报卡片 -->
  <view class="report card-low" wx:if="{{worst}}">
    <view class="rp-head">
      <view class="v-icon v-fire text-error rp-ic"></view>
      <text class="hl">本周极限修仙记录</text>
    </view>
    <view class="rp-worst">
      <text class="rp-worst-text mono">最狠一夜: {{worst.names}} · 耗费 {{worst.cost}}h</text>
    </view>
  </view>
</view>


