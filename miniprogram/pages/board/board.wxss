.page { padding: 24rpx 32rpx 48rpx; }

/* hero */
.hero-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 8rpx 8rpx 16rpx; }
.hero-title { font-family: var(--font-mono); font-size: 64rpx; font-weight: 700; color: var(--primary-container); letter-spacing: 2rpx; }
.hero-moon { font-size: 56rpx; }
.stat { border-radius: var(--r-xl); padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 8rpx; }
.stat-row { display: flex; align-items: baseline; gap: 12rpx; }
.stat-u { color: var(--on-surface-variant); font-size: 26rpx; }
.stat-dot { width: 10rpx; height: 10rpx; border-radius: var(--r-full); background: var(--outline); align-self: center; }
.teal { color: var(--secondary); }
.amber { color: var(--primary); }

/* 打卡卡 */
.live { position: relative; overflow: hidden; margin-top: 24rpx; padding: 28rpx 32rpx; }
.accent-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--secondary); }
.accent-bar.gray { background: var(--outline-variant); }
.live-status { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.live-status .mono { font-size: 22rpx; }
.pulse-dot { width: 16rpx; height: 16rpx; border-radius: var(--r-full); background: var(--primary-container); box-shadow: 0 0 12rpx rgba(255,178,36,.8); }
.live-vs { display: flex; align-items: center; }
.lv-side { display: flex; flex-direction: column; align-items: center; gap: 12rpx; width: 30%; }
.lv-side .circle-md { border: 1rpx solid var(--sc-variant); }
.lv-name { font-size: 24rpx; }
.lv-mid { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.score-m.sm { font-size: 44rpx; }
.live .btn-amber { margin-top: 28rpx; }
.live .btn-amber.done { opacity: .55; box-shadow: none; }
.live-note { display: block; text-align: center; margin-top: 16rpx; color: var(--on-surface-variant); font-size: 22rpx; }

/* 排名 */
.sect { margin: 40rpx 0 20rpx; }
.rank { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 28rpx; margin-bottom: 16rpx; }
.rk-no { width: 56rpx; text-align: center; font-family: var(--font-mono); font-size: 44rpx; font-weight: 700; color: var(--primary-container); }
.rk-no.teal { color: var(--secondary); }
.rk-ava { width: 72rpx; height: 72rpx; font-size: 26rpx; }
.rk-ava-me { background: var(--secondary-container); color: #004D44; }
.rk-name { flex: 1; font-size: 30rpx; }
.rank.me { border-color: var(--secondary); box-shadow: 0 0 24rpx rgba(68,226,205,.15); }
.rk-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.rk-h { font-family: var(--font-mono); font-size: 30rpx; font-weight: 700; color: var(--primary-container); }
.rk-h.teal { color: var(--secondary); }
.rk-s { font-size: 22rpx; }
.rank-note { display: block; text-align: center; color: var(--outline); font-size: 20rpx; margin: 8rpx 0 16rpx; }

/* 周报 */
.report { margin-top: 24rpx; padding: 40rpx 32rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.rp-ic { font-size: 56rpx; }
.rp-sub { font-size: 26rpx; }
.rp-worst {
  display: flex; align-items: center; gap: 10rpx;
  margin-top: 4rpx; padding: 8rpx 24rpx; border-radius: var(--r-full);
  background: rgba(255,178,36,.08); border: 1rpx solid rgba(255,178,36,.3);
}
.rp-worst-ic { font-size: 24rpx; }
.rp-worst-text { font-size: 22rpx; color: var(--primary); }
.rp-btn {
  margin-top: 16rpx; display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 56rpx; border-radius: var(--r-full);
  box-shadow: inset 0 0 0 2rpx var(--primary-container); color: var(--primary-container);
  font-family: var(--font-headline); font-size: 30rpx; font-weight: 600;
}
