.page { padding: 24rpx 32rpx 80rpx; min-height: 100vh; box-sizing: border-box; }

/* 动态微光 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.08); }
.glow-teal { bottom: -200rpx; left: -200rpx; background: rgba(20,224,191,.06); }

/* hero */
.hero-head {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 4rpx 20rpx;
}
.hh-title-wrap { display: flex; flex-direction: column; gap: 4rpx; }
.hero-title { font-size: 40rpx; font-weight: 800; color: var(--on-surface); line-height: 52rpx; }
.hh-sub { font-size: 20rpx; letter-spacing: 2rpx; }
.board-top-tag { font-size: 22rpx; padding: 6rpx 20rpx; border-radius: var(--r-full); }

/* 榜单 Tab 切换器 */
.board-tabs {
  position: relative; z-index: 1;
  display: flex; gap: 12rpx; margin-bottom: 24rpx; background: var(--sc-low);
  padding: 8rpx; border-radius: var(--r-full); border: 1rpx solid var(--hairline);
}
.btab {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--r-full);
  font-size: 24rpx; color: var(--on-surface-variant); transition: all .2s ease;
  white-space: nowrap;
}
.btab.active {
  background: var(--primary-container); color: var(--on-primary); font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(255,178,36,.3);
}

.stat {
  position: relative; z-index: 1;
  border-radius: var(--r-xl, 28rpx); padding: 24rpx 28rpx;
  display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 24rpx;
  border: 1rpx solid rgba(255,178,36,.3);
}
.stat-sub { font-size: 20rpx; }
.stat-row { display: flex; align-items: center; justify-content: space-around; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-u { font-size: 20rpx; }
.stat-div { width: 2rpx; height: 48rpx; background: var(--sc-highest); }

/* 打卡卡 */
.live {
  position: relative; z-index: 1; overflow: hidden; margin-bottom: 24rpx;
  padding: 28rpx 32rpx; border-radius: var(--r-xl, 28rpx);
  border: 1rpx solid rgba(255,178,36,.3);
}
.accent-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--secondary); box-shadow: 0 0 12rpx rgba(20,224,191,.5); }
.accent-bar.gray { background: var(--outline-muted); box-shadow: none; }
.live-status { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.live-status .mono { font-size: 22rpx; }

.live-vs { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0 20rpx; }
.lv-side { display: flex; flex-direction: column; align-items: center; gap: 12rpx; width: 160rpx; flex-shrink: 0; }
.lv-name { font-size: 26rpx; font-weight: 700; color: var(--on-surface); text-align: center; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lv-mid { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.score-m.sm { font-size: 44rpx; white-space: nowrap; }
.match-time { font-size: 32rpx; font-weight: 700; white-space: nowrap; }

.live .btn-amber { margin-top: 24rpx; border-radius: var(--r-full); }
.live .btn-amber.done { opacity: .55; box-shadow: none; }
.live-note { display: block; text-align: center; margin-top: 16rpx; font-size: 22rpx; }

/* 排名 */
.sect-gap { margin: 32rpx 0 16rpx; }
.sect-head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.rank-card {
  position: relative; z-index: 1;
  padding: 6rpx 0; overflow: hidden; border-radius: var(--r-xl, 28rpx);
  border: 1rpx solid var(--hairline); background: var(--sc-low);
}
.rank-row {
  display: flex; align-items: center; gap: 20rpx; padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--outline-muted);
}
.rank-row:last-child { border-bottom: none; }
.rk-no-wrap { width: 52rpx; text-align: center; }
.rk-no { font-size: 30rpx; color: var(--on-surface-variant); }
.podium-1 { background: rgba(255,178,36,.06); }
.podium-2 { background: rgba(224,226,234,.04); }
.podium-3 { background: rgba(205,127,50,.04); }

.rk-avatar { flex-shrink: 0; font-size: 20rpx; }
.rk-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.rk-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.rk-s { font-size: 20rpx; }
.user-row {
  margin: 14rpx; padding: 22rpx 28rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 178, 36, 0.09);
  border: 1rpx solid rgba(255, 178, 36, 0.45);
  box-shadow: 0 0 16rpx rgba(255, 178, 36, 0.15);
}
.user-rank { color: var(--primary-container); font-size: 32rpx; font-weight: 800; }
.user-avatar { background: var(--primary-container); color: var(--on-primary); }

/* 群友 PK 互动卡片 */
.group-pk-card {
  position: relative; z-index: 1;
  margin-top: 36rpx; padding: 32rpx 28rpx; border-radius: var(--r-xl, 28rpx);
  border: 1rpx solid rgba(255,178,36,.35); display: flex; flex-direction: column; gap: 14rpx;
}
.gpk-head { display: flex; align-items: center; gap: 12rpx; }
.gpk-sub { font-size: 22rpx; line-height: 32rpx; }
.gpk-acts { display: flex; gap: 14rpx; margin-top: 12rpx; }
.gpk-btn {
  flex: 1; height: 80rpx; line-height: 80rpx; font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  white-space: nowrap !important; padding: 0 8rpx !important; border-radius: var(--r-full);
}

/* 周报卡片 */
.report {
  position: relative; z-index: 1;
  margin-top: 24rpx; padding: 24rpx 28rpx; display: flex; flex-direction: column; gap: 10rpx;
  border-radius: var(--r-xl, 28rpx); border: 1rpx solid var(--hairline);
}
.rp-head { display: flex; align-items: center; gap: 12rpx; }
.rp-ic { width: 36rpx; height: 36rpx; }
.rp-worst {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 20rpx; border-radius: var(--r-full);
  background: rgba(255,180,171,.08); border: 1rpx solid rgba(255,180,171,.3);
}
.rp-worst-text { font-size: 22rpx; color: var(--error); }

.demo-chip { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: var(--r-full); }

/* 空榜引导态 */
.rank-empty {
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx; padding: 56rpx 32rpx;
}
.rank-empty-icon { width: 56rpx; height: 56rpx; opacity: .8; }
.rank-empty-title { font-size: 30rpx; font-weight: 700; color: var(--on-surface); }
.rank-empty-sub { font-size: 22rpx; text-align: center; }
