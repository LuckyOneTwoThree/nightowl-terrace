.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; }

/* Hero */
.hero { position: relative; padding: 32rpx; overflow: hidden; margin-bottom: 12rpx; border-radius: var(--r-xl); }
.hero.dim { opacity: .92; }
.accent-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--secondary); box-shadow: 0 0 12rpx rgba(68,226,205,.5); }
.hero-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; padding-left: 12rpx; }
.hh-left { display: flex; align-items: center; gap: 16rpx; }
.stars-row { display: flex; align-items: center; gap: 4rpx; }
.star-on { color: var(--primary-container); font-size: 28rpx; }

.vs { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 8rpx 36rpx; }
.side { width: 30%; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.side-name { font-size: 28rpx; font-weight: 600; text-align: center; color: var(--on-surface); }
.mid { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.match-time { font-size: 34rpx; color: var(--on-surface); font-weight: 700; }
.cd-pill {
  padding: 6rpx 20rpx; border-radius: var(--r-full);
  background: rgba(255,178,36,.12); border: 1rpx solid rgba(255,178,36,.4);
}
.cal-chip {
  padding: 6rpx 20rpx; border-radius: var(--r-full);
  display: inline-flex; align-items: center; gap: 8rpx; font-size: 22rpx;
  background: var(--sc-high);
}
.cal-s { width: 24rpx; height: 24rpx; }

.hero-chips { display: flex; flex-wrap: wrap; gap: 12rpx; padding-left: 6rpx; }

/* 看点 */
.sect-gap { margin: 40rpx 0 20rpx; }
.points { padding: 24rpx 28rpx; display: flex; flex-direction: column; gap: 16rpx; border-radius: var(--r-lg); }
.point { display: flex; gap: 14rpx; align-items: flex-start; }
.p-dot { width: 8rpx; height: 8rpx; border-radius: var(--r-full); background: var(--primary-container); margin-top: 14rpx; flex-shrink: 0; box-shadow: 0 0 6rpx rgba(255,178,36,.6); }
.p-text { color: var(--on-surface-variant); font-size: 26rpx; line-height: 38rpx; font-family: var(--font-body); }

/* 絮语 */
.quote {
  display: flex; align-items: flex-start; gap: 16rpx;
  margin-top: 24rpx; padding: 22rpx 26rpx; border-left: 6rpx solid var(--primary-container);
}
.paw-s { width: 30rpx; height: 30rpx; margin-top: 4rpx; }
.q-text { font-size: 26rpx; font-style: italic; line-height: 38rpx; color: var(--on-surface-variant); }
.quote-strong { font-style: normal; font-weight: 700; color: var(--on-surface); margin-right: 8rpx; }

/* 行按钮 */
.acts { display: flex; gap: 16rpx; margin-top: 32rpx; }
.act {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  padding: 22rpx 0; border-radius: var(--r-lg);
  font-size: 24rpx; transition: transform .15s ease;
}
.act:active { transform: scale(0.98); }
.act-main {
  background: var(--primary-container); color: var(--on-primary-container);
  box-shadow: 0 4rpx 20rpx rgba(255,178,36,.2);
}
.act-sub {
  background: var(--sc-low); border: 1rpx solid var(--outline-muted);
  color: var(--on-surface);
}

/* 信息 bento 3宫格 */
.bento { display: flex; gap: 16rpx; margin-top: 28rpx; }
.b-card {
  flex: 1; position: relative; overflow: hidden;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  padding: 24rpx 12rpx; border-radius: var(--r-lg);
}
.b-head-row { display: flex; align-items: center; gap: 8rpx; }
.b-label { font-size: 20rpx; }
.b-val { display: flex; align-items: baseline; gap: 4rpx; }
.b-tv { font-size: 24rpx; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }

/* 已赛结算条 */
.verdict {
  margin-top: 28rpx; padding: 24rpx 32rpx; border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx;
}
.v-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; }
.v-ok { font-weight: 700; margin-left: 4rpx; }
.v-no { font-weight: 700; margin-left: 4rpx; }
.v-div { width: 2rpx; height: 32rpx; background: var(--sc-highest); }
.v-note { width: 100%; font-size: 20rpx; text-align: center; }
