<view class="page {{theme === 'light' ? 'theme-light' : ''}}" wx:if="{{m}}">
  <!-- 环境微光 -->
  <view class="glow glow-amber"></view>

  <!-- ==================== 1. 比赛对决沉浸式 Header (Match Hero) ==================== -->
  <view class="hero {{m.finished ? 'card-low dim' : 'card-highest floodlight-glow'}}">
    <view class="accent-bar" style="background: {{m.finished ? '#334155' : m.lgSolid || 'var(--secondary)'}};"></view>
    <view class="hero-head">
      <view class="hh-left">
        <view class="lg-chip" style="background: {{m.lgSolid}};">{{m.lgZh}}</view>
        <view class="stars-row" wx:if="{{m.stars}}">
          <text class="star-on mono text-amber">{{m.stars}}</text>
        </view>
      </view>
      <view class="chip chip-ghost" wx:if="{{m.finished}}">全场结束</view>
      <view class="focal mono" wx:elif="{{m.star >= 3}}">
        <view class="dot-teal animate-pulse"></view>
        <text>焦点决战</text>
      </view>
    </view>

    <view class="vs">
      <view class="side">
        <image class="crest-xl" src="{{m.home.logo}}" mode="aspectFill" wx:if="{{m.home.logo}}" />
        <view class="circle-xl crest-fb" wx:else style="background: {{m.home.bg}}; border-color: {{m.home.bd}};">{{m.home.id}}</view>
        <text class="side-name hl">{{m.home.zh}}</text>
      </view>
      <view class="mid">
        <block wx:if="{{m.finished}}">
          <text class="score-m text-glow hl">{{m.scH}} - {{m.scA}}</text>
          <text class="mono muted">已完赛</text>
        </block>
        <block wx:else>
          <text class="hl hl-md match-time">{{m.dayLabel}} {{m.hm}}</text>
          <view class="cd-pill floodlight-glow"><text class="mono text-glow text-amber">{{countdownText}}</text></view>
          <view class="cal-chip chip chip-solid" wx:if="{{!m.tbd}}" bindtap="onCalendar">
            <view class="v-icon v-cal cal-s text-amber"></view>
            <text class="mono text-amber">加入日历</text>
          </view>
        </block>
      </view>
      <view class="side">
        <image class="crest-xl" src="{{m.away.logo}}" mode="aspectFill" wx:if="{{m.away.logo}}" />
        <view class="circle-xl crest-fb" wx:else style="background: {{m.away.bg}}; border-color: {{m.away.bd}};">{{m.away.id}}</view>
        <text class="side-name hl">{{m.away.zh}}</text>
      </view>
    </view>

    <view class="hero-chips">
      <view class="chip chip-amber">
        <view class="v-icon v-bolt text-amber"></view>
        <text>夜猫指数 {{m.indexText}}</text>
      </view>
      <view class="chip chip-teal" wx:for="{{m.storyNames}}" wx:key="*this"
            data-id="{{m.storyIds[index]}}" bindtap="goStory">
        <text>{{item}}</text>
        <view class="v-icon v-chev text-teal"></view>
      </view>
      <view class="chip chip-red" wx:if="{{m.rivalry}}">🔥 {{m.rivalry}}</view>
    </view>
  </view>

  <!-- ==================== 2. 本场战术看点与夜猫絮语 ==================== -->
  <block wx:if="{{m.points.length}}">
    <view class="sect sect-gap"><text class="sect-title">战术看点与深夜锦囊</text><view class="sect-line"></view></view>
    <view class="card-low points">
      <view class="point" wx:for="{{m.points}}" wx:key="*this">
        <view class="p-dot"></view>
        <text class="p-text">{{item}}</text>
      </view>
    </view>
  </block>

  <!-- 夜猫絮语金句 -->
  <view class="quote card-low" wx:if="{{quip}}">
    <view class="v-icon v-paw text-amber paw-s"></view>
    <text class="q-text"><text class="quote-strong">夜猫絮语:</text>“{{quip}}”</text>
  </view>

  <!-- ==================== 3. 本场单场盲评预测卡片 ==================== -->
  <block wx:if="{{myPred}}">
    <!-- 状态 1: 已完赛且此前已封存预言 -->
    <view class="card-low pred-box {{myPred.hit ? 'sealed-box' : ''}}" wx:if="{{myPred.finished && myPred.sealed}}">
      <view class="pb-head">
        <view class="pb-title-row">
          <view class="v-icon v-bolt {{myPred.hit ? 'text-teal' : 'text-amber'}}"></view>
          <text class="hl {{myPred.hit ? 'text-teal' : 'text-amber'}}">盲评结算 · {{myPred.hit ? '预言应验 👏' : '遗憾翻车 💔'}}</text>
        </view>
        <view class="chip {{myPred.hit ? 'chip-teal' : 'chip-ghost'}}">{{myPred.ptsText}}</view>
      </view>
      <view class="pb-body">
        <text class="pb-result hl {{myPred.hit ? 'text-teal' : 'text-amber'}}">我的预测: {{myPred.pickZh}}{{myPred.scoreH !== '' ? ' (' + myPred.scoreH + '-' + myPred.scoreA + ')' : ''}}</text>
        <text class="mono muted pb-tip">全场比分 {{m.scH}} - {{m.scA}} · 战绩已同步至赛季风云榜</text>
      </view>
    </view>

    <!-- 状态 2: 已完赛但未参与预测 -->
    <view class="card-low pred-box" wx:elif="{{myPred.finished}}">
      <view class="pb-head">
        <view class="pb-title-row">
          <view class="v-icon v-trophy text-amber"></view>
          <text class="hl">本场已完赛</text>
        </view>
        <view class="chip chip-ghost">全场 {{m.scH}} - {{m.scA}}</view>
      </view>
      <view class="pb-body" bindtap="goPredict">
        <text class="mono muted pb-tip">终场哨响已封箱结算 · 点击前往盲评大厅预言下一场 ›</text>
      </view>
    </view>

    <!-- 状态 3: 未完赛且已封存 -->
    <view class="card-low pred-box sealed-box" wx:elif="{{myPred.sealed}}">
      <view class="pb-head">
        <view class="pb-title-row">
          <view class="v-icon v-bolt text-teal"></view>
          <text class="hl text-teal">已封存本场预言</text>
        </view>
        <view class="chip chip-teal">加盐哈希上锁</view>
      </view>
      <view class="pb-body">
        <text class="pb-result hl text-amber">我的预测: {{myPred.pickZh}}{{myPred.scoreH !== '' ? ' (' + myPred.scoreH + '-' + myPred.scoreA + ')' : ''}}</text>
        <text class="mono muted pb-tip">终场哨响自动开箱结算 · 命中自动累入赛季总榜</text>
      </view>
    </view>

    <!-- 状态 4: 未完赛但已开球截止 -->
    <view class="card-low pred-box" wx:elif="{{myPred.closed}}">
      <view class="pb-head">
        <view class="pb-title-row">
          <view class="v-icon v-moon text-muted"></view>
          <text class="hl muted">比赛进行中 · 预测已截止</text>
        </view>
        <view class="chip chip-ghost">封停开箱中</view>
      </view>
      <view class="pb-body">
        <text class="mono muted pb-tip">比赛已开球打响，无法再修改或新增预测。赛后自动结算战果。</text>
      </view>
    </view>

    <!-- 状态 5: 未完赛可预测（单场即时预测面板） -->
    <view class="card-low pred-box" wx:else>
      <view class="pb-head">
        <view class="pb-title-row">
          <view class="v-icon v-fire text-amber"></view>
          <text class="hl">单场预言 · 押上尊严</text>
        </view>
        <text class="mono muted pb-sub">猜中 +3分 · 精确比分 +2分</text>
      </view>

      <view class="pb-opts">
        <view class="pb-opt {{inputPick === 'h' ? 'on floodlight-glow' : ''}}" data-key="h" bindtap="onSelectPick">
          <text class="hl">{{m.home.zh}} 胜</text>
        </view>
        <view class="pb-opt {{inputPick === 'd' ? 'on floodlight-glow' : ''}}" data-key="d" bindtap="onSelectPick">
          <text class="hl">平局</text>
        </view>
        <view class="pb-opt {{inputPick === 'a' ? 'on floodlight-glow' : ''}}" data-key="a" bindtap="onSelectPick">
          <text class="hl">{{m.away.zh}} 胜</text>
        </view>
      </view>

      <view class="pb-score-row" wx:if="{{inputPick}}">
        <view class="pb-score-in">
          <text class="mono muted">精确比分:</text>
          <input class="pb-in mono hl" type="number" value="{{inputScoreH}}" data-side="h" bindinput="onInputScore" placeholder="-" />
          <text class="mono muted">:</text>
          <input class="pb-in mono hl" type="number" value="{{inputScoreA}}" data-side="a" bindinput="onInputScore" placeholder="-" />
        </view>
        <button class="btn-amber pb-seal-btn floodlight-glow" bindtap="onSealSingle">
          <text>安全封存</text>
        </button>
      </view>
    </view>
  </block>

  <!-- ==================== 4. 底部三联快捷操作岛 ==================== -->
  <view class="acts">
    <view class="act act-main floodlight-glow" bindtap="goPredict">
      <view class="v-icon v-soccer"></view>
      <text class="hl">{{myPred && myPred.sealed ? '全部盲评单' : '去盲评大厅'}}</text>
    </view>
    <view class="act act-sub" bindtap="goCourt">
      <view class="v-icon v-gavel text-amber"></view>
      <text class="mono">{{m.finished ? '法庭判例' : '留句狂言'}}</text>
    </view>
    <view class="act act-sub" bindtap="goPoster">
      <view class="v-icon v-trophy text-teal"></view>
      <text class="mono">{{m.finished ? '战报海报' : '生成海报'}}</text>
    </view>
  </view>

  <!-- ==================== 5. 信息 Bento 3 宫格 ==================== -->
  <view class="bento">
    <view class="b-card card-low">
      <view class="b-head-row">
        <view class="v-icon v-moon text-amber"></view>
        <text class="b-label mono muted">熬夜成本</text>
      </view>
      <view class="b-val"><text class="hl hl-md">{{m.tierLabel}}</text><text class="b-sub mono text-amber"> {{m.cost}}h</text></view>
    </view>
    <view class="b-card card-low">
      <view class="b-head-row">
        <view class="v-icon v-cal text-teal"></view>
        <text class="b-label mono muted">当地时间</text>
      </view>
      <text class="hl hl-md">{{m.local}}</text>
    </view>
    <view class="b-card card-low">
      <view class="b-head-row">
        <view class="v-icon v-tune text-muted"></view>
        <text class="b-label mono muted">直播平台</text>
      </view>
      <text class="hl hl-md b-tv">{{m.tv || '咪咕 / 爱奇艺'}}</text>
    </view>
  </view>

  <!-- ==================== 6. 已赛：法庭结算条 ==================== -->
  <view class="verdict card-low" wx:if="{{m.finished}}">
    <view class="v-item">
      <view class="v-icon v-check text-teal"></view>
      <text class="mono">法庭应验 <text class="v-ok hl text-teal">8</text> 人</text>
    </view>
    <view class="v-div"></view>
    <view class="v-item">
      <view class="v-icon v-cross text-error"></view>
      <text class="mono">翻车 <text class="v-no hl text-error">3</text> 人</text>
    </view>
    <text class="v-note mono muted">已封存开箱</text>
  </view>
</view>

