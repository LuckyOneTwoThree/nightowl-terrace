page { background: var(--bg); }
.page { position: relative; padding: 32rpx 32rpx 240rpx; overflow: hidden; }

/* 光晕 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.06); }
.glow-teal { bottom: -200rpx; left: -200rpx; background: rgba(68,226,205,.05); }

/* 头部 */
.head { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 12rpx; padding-top: 16rpx; }
.skip-btn {
  align-self: flex-end; padding: 8rpx 24rpx; border-radius: var(--r-full);
  border: 1rpx solid rgba(81,69,51,.3); background: rgba(24,28,33,.5);
  color: var(--on-surface-variant); letter-spacing: 2rpx; font-size: 20rpx;
}
.head-sub { color: var(--on-surface-variant); font-size: 26rpx; margin-top: 8rpx; }

/* 分组 */
.groups { position: relative; z-index: 1; margin-top: 40rpx; display: flex; flex-direction: column; gap: 40rpx; }
.g-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.g-ic { font-size: 32rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }

.tchip {
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 8rpx 24rpx 8rpx 8rpx; border-radius: var(--r-full);
  border: 2rpx solid var(--outline-variant); background: rgba(24,28,33,.5);
  color: var(--on-surface-variant);
}
.tchip.on {
  border-color: var(--primary-container); background: rgba(255,178,36,.08);
  color: var(--on-surface); box-shadow: 0 0 20rpx rgba(255,178,36,.12);
}
.t-ava {
  width: 56rpx; height: 56rpx; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 18rpx;
  background: var(--sc-highest); border: 1rpx solid var(--hairline);
}
.t-ava.gray { filter: grayscale(1); opacity: .7; }
.t-name { font-size: 26rpx; }
.tchip.on .t-name { font-weight: 700; }
.t-check { color: var(--primary-container); font-size: 26rpx; font-weight: 700; }

/* 底部栏 */
.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; }
.bar-fade { height: 96rpx; background: linear-gradient(transparent, var(--sc-lowest)); }
.bar-main {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx 40rpx; border-top: 1rpx solid rgba(81,69,51,.2);
  background: rgba(10,14,19,.85); backdrop-filter: blur(20rpx);
}
.bar-count { display: flex; flex-direction: column; gap: 4rpx; }
.bar-label { color: var(--on-surface-variant); font-size: 24rpx; }
.bar-num { font-family: var(--font-headline); font-size: 34rpx; }
.bar-num .n { color: var(--primary); font-weight: 700; }
.done-btn {
  display: flex; align-items: center; gap: 12rpx;
  padding: 24rpx 72rpx; border-radius: var(--r-xl);
  background: var(--primary-container); color: var(--on-primary);
  font-family: var(--font-headline); font-size: 32rpx; font-weight: 700;
  box-shadow: 0 0 32rpx rgba(255,178,36,.25);
}
.d-arrow { font-size: 32rpx; }
