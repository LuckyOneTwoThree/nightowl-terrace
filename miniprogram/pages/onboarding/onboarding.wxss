.page { position: relative; padding: 24rpx 32rpx 240rpx; min-height: 100vh; overflow: hidden; }

/* 光晕 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.1); }
.glow-teal { bottom: -200rpx; left: -200rpx; background: rgba(68,226,205,.08); }

/* 头部 */
.head { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8rpx; padding-top: 16rpx; }
.skip-btn { align-self: flex-end; font-size: 22rpx; padding: 6rpx 20rpx; }
.onb-title { font-size: 44rpx; font-weight: 700; color: var(--on-surface); margin-top: 8rpx; }
.head-sub { font-size: 24rpx; line-height: 36rpx; }

/* 分组 */
.groups { position: relative; z-index: 1; margin-top: 36rpx; display: flex; flex-direction: column; gap: 36rpx; }
.g-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.g-ic { width: 36rpx; height: 36rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }

.tchip {
  display: inline-flex; align-items: center; gap: 14rpx;
  padding: 10rpx 24rpx 10rpx 12rpx; border-radius: var(--r-full);
  border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); transition: all .2s ease;
}
.tchip.on {
  border-color: rgba(255,178,36,.6); background: rgba(255,178,36,.12);
  color: var(--primary-container);
}
.t-ava { font-size: 18rpx; flex-shrink: 0; }
.t-name { font-size: 26rpx; }
.t-check { width: 28rpx; height: 28rpx; }

/* 底部栏 */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  border-top: 1rpx solid var(--outline-muted);
}
.bar-main {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.bar-count { display: flex; flex-direction: column; gap: 4rpx; }
.bar-label { font-size: 22rpx; }
.bar-num { font-size: 32rpx; }
.bar-num .n { font-size: 38rpx; font-weight: 700; margin-right: 4rpx; }
.done-btn {
  display: flex; align-items: center; gap: 8rpx;
  padding: 24rpx 56rpx; border-radius: var(--r-xl); font-size: 30rpx;
}
