.page { position: relative; padding: 24rpx 32rpx 240rpx; min-height: 100vh; overflow: hidden; }

/* 光晕 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.1); }
.glow-teal { bottom: -200rpx; left: -200rpx; background: rgba(20,224,191,.08); }

/* 头部 */
.head { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10rpx; padding-top: 12rpx; }
.head-top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.step-pill { font-size: 20rpx; padding: 4rpx 16rpx; }
.back-btn { font-size: 22rpx; padding: 6rpx 20rpx; }
.skip-btn { font-size: 22rpx; padding: 6rpx 20rpx; }
.onb-title { font-size: 42rpx; font-weight: 700; color: var(--on-surface); margin-top: 4rpx; }
.head-sub { font-size: 24rpx; line-height: 36rpx; color: var(--on-surface-variant); }

/* 快捷操作栏 */
.quick-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 32rpx; margin-bottom: 20rpx;
}
.quick-hint { font-size: 22rpx; color: var(--outline); }
.quick-btns { display: flex; align-items: center; gap: 12rpx; }
.quick-chip { font-size: 20rpx; padding: 6rpx 18rpx; border-radius: var(--r-full); }

/* 联赛卡片网格（Step 1） */
.league-grid {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; gap: 20rpx;
}
.lg-card {
  position: relative;
  display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-xl);
  border: 1rpx solid var(--outline-muted);
  transition: all .25s ease;
  overflow: hidden;
}
.lg-card.on {
  border-color: rgba(255,178,36,.55);
  background: rgba(255,178,36,.08);
}
.theme-light .lg-card.on {
  border-color: rgba(217,119,6,.6);
  background: rgba(254,243,199,.6);
}
.lg-color-bar {
  width: 8rpx; height: 72rpx; border-radius: 4rpx; flex-shrink: 0;
}
.lg-info {
  flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0;
}
.lg-name-row {
  display: flex; align-items: baseline; gap: 14rpx;
}
.lg-title {
  font-size: 32rpx; font-weight: 700; color: var(--on-surface);
}
.lg-en {
  font-size: 22rpx; color: var(--outline);
}
.lg-tagline {
  font-size: 24rpx; color: var(--primary-container); font-weight: 600;
}
.lg-desc {
  font-size: 20rpx; color: var(--on-surface-variant);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lg-check-box {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 2rpx solid var(--outline-muted);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all .2s ease;
}
.lg-check-box.checked {
  border-color: var(--primary); background: rgba(255,178,36,.2);
}
.lg-check-ic {
  width: 28rpx; height: 28rpx;
}

/* 球队分组（Step 2） */
.groups { position: relative; z-index: 1; margin-top: 36rpx; display: flex; flex-direction: column; gap: 36rpx; }
.g-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.gh-left { display: flex; align-items: center; gap: 14rpx; }
.lg-tag-solid {
  font-size: 20rpx; font-weight: 700; color: #fff;
  padding: 4rpx 14rpx; border-radius: 8rpx;
}
.g-count { font-size: 22rpx; margin-left: 4rpx; }
.g-picked-badge { font-size: 18rpx; padding: 2rpx 12rpx; border-radius: var(--r-full); }
.g-quick-btn { font-size: 18rpx; padding: 4rpx 16rpx; border-radius: var(--r-full); }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }

.tchip {
  display: inline-flex; align-items: center; gap: 14rpx;
  padding: 10rpx 24rpx 10rpx 12rpx; border-radius: var(--r-full);
  border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); transition: all .2s ease;
}
.tchip.on {
  border-color: rgba(255,178,36,.6); background: rgba(255,178,36,.12);
  color: var(--primary-container);
}
.theme-light .tchip.on {
  border-color: rgba(217,119,6,.6); background: rgba(254,243,199,.7);
}
.t-ava { font-size: 18rpx; flex-shrink: 0; }
.t-name { font-size: 26rpx; }
.t-check { width: 28rpx; height: 28rpx; }

/* 底部栏 */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  border-top: 1rpx solid var(--outline-muted);
}
.bar-main {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.bar-count { display: flex; flex-direction: column; gap: 4rpx; }
.bar-label { font-size: 22rpx; }
.bar-num { font-size: 32rpx; }
.bar-num .n { font-size: 38rpx; font-weight: 700; margin-right: 4rpx; }
.done-btn {
  display: flex; align-items: center; gap: 8rpx;
  padding: 22rpx 48rpx; border-radius: var(--r-xl); font-size: 28rpx;
}
