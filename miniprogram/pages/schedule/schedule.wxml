<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 顶部吸顶控制区（Sticky Header：精简视图切换 + 日期条 + 联赛筛选） -->
  <view class="sticky-bar">
    <!-- 顶部工具条：左侧日历/轮次分段切换 + 右侧星级精选 -->
    <view class="top-toolbar">
      <view class="vtoggle">
        <view class="vt-btn {{viewMode === 'day' ? 'on' : ''}}" data-mode="day" bindtap="onSwitchView">
          <text>日历</text>
        </view>
        <view class="vt-btn {{viewMode === 'round' ? 'on' : ''}}" data-mode="round" bindtap="onSwitchView">
          <text>轮次</text>
        </view>
      </view>
      <view class="star-filter-chip {{selStar ? 'on floodlight-glow' : ''}}" bindtap="onStarFilter">
        <view class="v-icon v-star {{selStar ? 'text-amber' : ''}}"></view>
        <text class="mono">{{starLabel}}</text>
      </view>
    </view>

    <!-- 日期条（横滑日选） -->
    <scroll-view scroll-x class="dstrip" enhanced show-scrollbar="{{false}}" scroll-into-view="{{dchipId}}" scroll-with-animation wx:if="{{viewMode === 'day'}}">
      <view
        wx:for="{{days}}" wx:key="day"
        id="dchip-{{item.day}}"
        class="dchip {{selDay === item.day ? 'on floodlight-glow' : ''}}"
        data-day="{{item.day}}" bindtap="onPickDay">
        <view class="dchip-dot dot-amber" wx:if="{{selDay === item.day}}"></view>
        <text class="dchip-wd">{{item.isToday ? '今天' : '周' + item.wd}}</text>
        <text class="dchip-md mono">{{item.short}}</text>
        <text class="dchip-count mono muted">{{item.count}}场</text>
      </view>
    </scroll-view>

    <!-- 轮次条（轮次视图） -->
    <scroll-view scroll-x class="dstrip" enhanced show-scrollbar="{{false}}" wx:if="{{viewMode === 'round'}}">
      <view
        wx:for="{{rounds}}" wx:key="*this"
        class="dchip {{selRound === item ? 'on floodlight-glow' : ''}}"
        data-r="{{item}}" bindtap="onPickRound">
        <text class="dchip-wd">第{{item}}轮</text>
      </view>
    </scroll-view>

    <!-- 联赛横滑筛选药丸 -->
    <scroll-view scroll-x class="pills" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{leagues}}" wx:key="id"
        wx:if="{{viewMode === 'day' || item.id !== 'ALL'}}"
        class="fpill on-{{selLg === item.id ? item.id : 'none'}}"
        data-lg="{{item.id}}" bindtap="onPickLg">{{item.zh}}</view>
    </scroll-view>
  </view>

  <!-- 分组列表 -->
  <view class="list">
    <view class="group" wx:for="{{viewGroups}}" wx:key="day" id="d-{{item.day}}">
      <view class="g-head" wx:if="{{(selLg === 'ALL' || item.matches.length)}}">
        <text class="g-date hl">{{item.label.md}}</text>
        <text class="mono muted g-week">{{item.label.week}}</text>
        <view class="g-line"></view>
      </view>
      <view
        class="match card-low {{mt.followed ? 'followed-card' : ''}}"
        wx:for="{{item.matches}}" wx:for-item="mt" wx:key="id"
        wx:if="{{(selLg === 'ALL' || mt.lg === selLg) && (!selStar || mt.star >= selStar)}}"
        data-id="{{mt.id}}" bindtap="goDetail">
        <view class="m-accent" style="background: {{mt.accent}};"></view>
        <view class="m-body">
          <view class="m-top">
            <view class="m-top-left">
              <text class="mono m-lg-name">{{mt.lgZh}}</text>
              <view class="chip chip-amber m-status-chip m-followed-chip" wx:if="{{mt.followed}}">🌟 主队</view>
              <view class="chip chip-teal m-status-chip" wx:if="{{mt.finished}}">完场</view>
              <view class="chip chip-ghost m-status-chip" wx:elif="{{mt.tbd}}">时间待定</view>
            </view>
            <view class="m-top-right mono">
              <text class="muted local-txt" wx:if="{{!mt.tbd}}">当地 {{mt.local}}</text>
              <text class="m-hm text-amber">{{mt.hmText}}</text>
            </view>
          </view>
          
          <view class="t-row">
            <text class="t-name {{mt.homeWin ? 't-win' : ''}}">{{mt.home.zh}}</text>
            <view class="m-team-info">
              <image class="crest-sm" src="{{mt.home.logo}}" mode="aspectFit" wx:if="{{mt.home.logo}}" /><view class="circle-sm crest-fb" wx:else style="background: {{mt.home.bg}}; border-color: {{mt.home.bd}};">{{mt.home.id}}</view>
              <text class="score mono {{mt.homeWin ? 'score-win' : (mt.finished ? 'ft' : 'dim')}}">{{mt.finished ? mt.scH : '-'}}</text>
            </view>
          </view>
          <view class="t-row">
            <text class="t-name dim2 {{mt.awayWin ? 't-win' : ''}}">{{mt.away.zh}}</text>
            <view class="m-team-info">
              <image class="crest-sm" src="{{mt.away.logo}}" mode="aspectFit" wx:if="{{mt.away.logo}}" /><view class="circle-sm crest-fb" wx:else style="background: {{mt.away.bg}}; border-color: {{mt.away.bd}};">{{mt.away.id}}</view>
              <text class="score mono {{mt.awayWin ? 'score-win' : (mt.finished ? 'ft' : 'dim')}}">{{mt.finished ? mt.scA : '-'}}</text>
            </view>
          </view>
        </view>

        <view class="m-side">
          <view class="stars-col">
            <text class="star-gold mono">{{mt.stars}}</text>
          </view>
          <view class="st-btn" data-id="{{mt.id}}" catchtap="onCalendarAdd" hover-class="st-btn-active">
            <view class="v-icon v-cal st-icon"></view>
          </view>
        </view>
      </view>

      <view class="g-empty card-low" wx:if="{{selLg !== 'ALL' && !item.matches.length}}">
        <text class="mono muted">当日无{{selLg === 'ALL' ? '' : '该联赛'}}赛事</text>
      </view>
    </view>

    <view class="foot mono muted">— 全季 1,752 场 · 实时精准更新 —</view>
  </view>

  <!-- 快速回到今天悬浮按钮 (FAB) -->
  <view class="today-fab floodlight-glow" wx:if="{{viewMode === 'day' && !isViewingToday}}" bindtap="onGoToday">
    <view class="v-icon v-cal fab-icon"></view>
    <text class="mono">回到今天</text>
  </view>
</view>

