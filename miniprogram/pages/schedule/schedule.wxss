.page { padding-bottom: 48rpx; }

/* 日期条 */
.dstrip { white-space: nowrap; padding: 24rpx 32rpx 8rpx; width: 100%; box-sizing: border-box; }
.dchip {
  display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx;
  width: 128rpx; padding: 16rpx 0; margin-right: 16rpx;
  border-radius: var(--r-md); background: var(--sc-low); border: 1rpx solid var(--sc-variant);
}
.dchip-wd { font-size: 22rpx; color: var(--on-surface-variant); }
.dchip-md { font-family: var(--font-mono); font-size: 24rpx; }
.dchip.on { background: var(--primary-container); border-color: transparent; box-shadow: 0 0 24rpx rgba(255,178,36,.2); }
.dchip.on .dchip-wd, .dchip.on .dchip-md { color: var(--on-primary); font-weight: 700; }

/* 联赛药丸 */
.pills { display: flex; white-space: nowrap; padding: 16rpx 32rpx; width: 100%; box-sizing: border-box; }
.pills .fpill { display: inline-flex; margin-right: 16rpx; }

/* 分组 */
.list { padding: 8rpx 32rpx 0; }
.group { scroll-margin-top: 20rpx; }
.g-head { display: flex; align-items: baseline; gap: 16rpx; padding: 24rpx 0 16rpx; }
.g-date { font-family: var(--font-headline); font-size: 34rpx; font-weight: 600; }
.g-line { flex: 1; height: 2rpx; background: var(--sc-high); }

/* 赛卡（_4：左联赛色条 + 时间列 + 双队行 + 星标） */
.match {
  position: relative; display: flex; align-items: center;
  margin-bottom: 16rpx; padding: 0; overflow: hidden;
}
.m-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }
.m-body { flex: 1; padding: 20rpx 24rpx 20rpx 32rpx; }
.m-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; gap: 8rpx; }
.m-top .mono:first-child { flex-shrink: 0; }
.tbd-chip { padding: 4rpx 12rpx; font-size: 18rpx; flex-shrink: 0; }
.local-txt { font-size: 20rpx; margin-left: auto; flex-shrink: 0; }
.t-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.t-row:last-child { margin-bottom: 0; }
.t-name { font-size: 28rpx; font-weight: 500; }
.dim2 { color: var(--on-surface-variant); }
.m-right { display: flex; align-items: center; gap: 16rpx; }
.score { font-family: var(--font-mono); font-size: 28rpx; color: var(--on-surface-variant); width: 32rpx; text-align: center; }
.score.ft { color: var(--on-surface); font-weight: 700; }
.m-side {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding-right: 24rpx;
}
.stars-sm { color: var(--primary-container); font-size: 20rpx; letter-spacing: 2rpx; }
.st-btn { color: var(--outline); font-size: 32rpx; }

.g-empty { padding: 32rpx; text-align: center; margin-bottom: 16rpx; }
.foot { text-align: center; padding: 32rpx 0; font-size: 20rpx; }
