.page { padding-bottom: 64rpx; min-height: 100vh; }

/* 顶部吸顶控制栏 (Sticky Header) */
.sticky-bar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--outline-muted);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

/* 顶部工具条：视图分段 + 星级筛选 */
.top-toolbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 28rpx 8rpx; gap: 12rpx; box-sizing: border-box;
}
.vtoggle { display: flex; gap: 8rpx; flex-shrink: 0; }
.vt-btn {
  padding: 8rpx 20rpx; border-radius: var(--r-full);
  background: var(--surface-2); border: 1rpx solid var(--hairline);
  color: var(--on-surface-variant); font-size: 24rpx; font-weight: 500;
  transition: all .15s ease; white-space: nowrap;
}
.vt-btn:active { background: var(--sc-high); transform: scale(0.97); }
.vt-btn.on {
  background: rgba(255,178,36,.14); border-color: rgba(255,178,36,.45);
  color: var(--primary-container); font-weight: 700;
}

.top-actions { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.star-filter-chip {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 8rpx 18rpx; border-radius: var(--r-full);
  background: var(--surface-2); border: 1rpx solid var(--hairline);
  color: var(--on-surface-variant); font-size: 22rpx; font-weight: 600;
  transition: all .15s ease; white-space: nowrap; flex-shrink: 0;
}
.star-filter-chip:active { transform: scale(0.96); }
.star-filter-chip.on {
  background: rgba(255,178,36,.14); border-color: rgba(255,178,36,.45);
  color: var(--primary-container); font-weight: 700;
}
.exp-chip:active { background: rgba(0, 240, 255, 0.12); border-color: rgba(0, 240, 255, 0.4); }

/* 日期条 */
.dstrip { white-space: nowrap; padding: 10rpx 32rpx 8rpx; width: 100%; box-sizing: border-box; }
.dchip {
  position: relative; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  width: 128rpx; padding: 14rpx 0; margin-right: 14rpx;
  border-radius: var(--r-lg); background: var(--sc-low); border: 1rpx solid var(--outline-muted);
  transition: all .2s ease;
}
.dchip-dot { position: absolute; top: 8rpx; right: 10rpx; width: 8rpx; height: 8rpx; }
.dchip-wd { font-size: 22rpx; color: var(--on-surface-variant); font-weight: 500; }
.dchip-md { font-size: 26rpx; font-weight: 700; }
.dchip-count { font-size: 19rpx; }
.dchip.on {
  background: var(--primary-container); border-color: transparent;
  box-shadow: 0 4rpx 20rpx rgba(255,178,36,.3);
}
.dchip.on .dchip-wd, .dchip.on .dchip-md, .dchip.on .dchip-count {
  color: var(--on-primary); font-weight: 700;
}

/* 联赛药丸 */
.pills { display: flex; white-space: nowrap; padding: 6rpx 32rpx 14rpx; width: 100%; box-sizing: border-box; }
.pills .fpill { display: inline-flex; margin-right: 14rpx; }


/* 分组 */
.list { padding: 4rpx 28rpx 0; box-sizing: border-box; }
.group { scroll-margin-top: 20rpx; margin-bottom: 32rpx; }
.g-head { display: flex; align-items: baseline; gap: 16rpx; padding: 20rpx 0 16rpx; }
.g-date { font-size: 34rpx; font-weight: 700; color: var(--on-surface); }
.g-week { font-size: 24rpx; }
.g-line { flex: 1; height: 2rpx; background: linear-gradient(90deg, var(--line-strong) 0%, var(--outline-muted) 100%); }

/* 赛卡 */
.match {
  position: relative; display: flex; align-items: center;
  margin-bottom: 20rpx; padding: 0; overflow: hidden;
  border-radius: var(--r-xl);
  transition: transform .15s ease;
  box-sizing: border-box;
  width: 100%;
}
.match:active { transform: scale(0.99); background: var(--sc); }
.match.followed-card {
  border: 1rpx solid rgba(255, 184, 0, 0.4);
  background: rgba(255, 184, 0, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(255, 184, 0, 0.08);
}
.m-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }
.m-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx 22rpx 28rpx;
  box-sizing: border-box;
}

.m-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
  min-width: 0;
}
.m-top-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}
.m-lg-name {
  font-size: 22rpx;
  color: var(--on-surface-variant);
  font-weight: 600;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.m-status-chip {
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 28rpx;
}
.m-followed-chip {
  background: rgba(255, 184, 0, 0.18);
  border: 1rpx solid rgba(255, 184, 0, 0.45);
  color: var(--primary-container);
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}
.m-top-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.local-txt {
  font-size: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.m-hm {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}

.t-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  min-width: 0;
}
.t-row:last-child { margin-bottom: 0; }
.t-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--on-surface);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 14rpx;
}
.t-name.t-win { color: var(--on-surface); font-weight: 800; }
.dim2 { color: var(--on-surface-variant); font-weight: 400; }
.m-team-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}
.score {
  font-size: 32rpx;
  width: 38rpx;
  text-align: center;
  flex-shrink: 0;
}
.score.ft { color: var(--on-surface-variant); font-weight: 600; }
.score.score-win { color: var(--primary-container); font-weight: 800; font-size: 34rpx; }
.score.dim { color: var(--on-surface-variant); opacity: .6; }

.m-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 20rpx 0 10rpx;
  border-left: 1rpx solid var(--outline-muted);
  flex-shrink: 0;
}
.stars-col { display: flex; flex-direction: column; gap: 2rpx; }
.star-gold { color: var(--primary-container); font-size: 20rpx; line-height: 1; }
.st-btn { padding: 12rpx; border-radius: var(--r-full); background: rgba(255,255,255,0.03); transition: all .15s ease; }
.st-btn:active, .st-btn-active { background: rgba(255, 184, 0, 0.2); transform: scale(0.92); }
.st-icon { width: 32rpx; height: 32rpx; color: var(--on-surface-variant); }

/* 移动端窄屏响应式（iPhone SE / 320px~360px 宽度） */
@media (max-width: 360px) {
  .list { padding: 4rpx 16rpx 0; }
  .top-toolbar { padding: 12rpx 16rpx 6rpx; gap: 8rpx; }
  .vt-btn { padding: 6rpx 16rpx; font-size: 22rpx; }
  .star-filter-chip { padding: 6rpx 14rpx; font-size: 20rpx; }
  .m-body { padding: 18rpx 14rpx 18rpx 20rpx; }
  .m-side { padding: 0 14rpx 0 8rpx; }
  .t-name { font-size: 26rpx; margin-right: 10rpx; }
}

@media (max-width: 330px) {
  .local-txt { display: none; }
}

.g-empty { padding: 36rpx; text-align: center; margin-bottom: 16rpx; }
.foot { text-align: center; padding: 36rpx 0 16rpx; font-size: 22rpx; }

/* 快速回到今天悬浮按钮 */
.today-fab {
  position: fixed; right: 32rpx; bottom: 48rpx; z-index: 120;
  display: flex; align-items: center; gap: 8rpx;
  background: var(--primary-container); color: var(--on-primary);
  padding: 16rpx 28rpx; border-radius: var(--r-full);
  font-size: 24rpx; font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(255, 184, 0, 0.45);
  animation: fabIn .25s ease-out;
}
.today-fab:active { transform: scale(0.94); }
.fab-icon { width: 28rpx; height: 28rpx; color: var(--on-primary); }

@keyframes fabIn {
  from { opacity: 0; transform: translateY(30rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* 浅色主题适配 */
.theme-light .match.followed-card {
  background: rgba(255, 184, 0, 0.08);
  border-color: rgba(255, 184, 0, 0.5);
}
.theme-light .today-fab {
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.35);
}

