<view class="page">
  <!-- 头部（_18：头像 + 昵称 + 设置） -->
  <view class="head">
    <view class="avatar">🦉</view>
    <view class="h-col">
      <text class="h-name">{{nickname}}</text>
      <text class="mono muted">看台第 1 排 · 本季追剧中</text>
    </view>
    <text class="h-set">⚙️</text>
  </view>

  <!-- 统计（_18） -->
  <view class="stats card-low">
    <view class="stat">
      <text class="s-num">{{stats.hours}}</text>
      <text class="s-label mono">熬夜时长</text>
    </view>
    <view class="s-div"></view>
    <view class="stat">
      <text class="s-num">{{stats.preds}}</text>
      <text class="s-label mono">预测</text>
    </view>
    <view class="s-div"></view>
    <view class="stat">
      <text class="s-num">{{stats.hit}}</text>
      <text class="s-label mono">应验率</text>
    </view>
  </view>

  <!-- 关注球队（_18：多选 chips） -->
  <view class="sect sect-gap">
    <text class="sect-title">关注球队</text>
    <view class="sect-line"></view>
  </view>
  <view class="follow card-low">
    <view class="f-group" wx:for="{{groups}}" wx:key="id">
      <text class="mono muted f-lg">{{item.zh}}</text>
      <view class="f-chips">
        <view
          class="f-chip {{team.on ? 'on' : ''}}"
          wx:for="{{item.teams}}" wx:for-item="team" wx:key="id"
          data-id="{{team.id}}" bindtap="onToggle">
          <view class="f-dot" style="background: {{team.dot}};"></view>
          <text>{{team.zh}}</text>
          <text class="f-new" wx:if="{{team.isNew}}">新</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 菜单（_18） -->
  <view class="sect sect-gap">
    <text class="sect-title">我的记录</text>
    <view class="sect-line"></view>
  </view>
  <view class="menu card-low">
    <view class="menu-row" wx:for="{{menu}}" wx:key="id" data-id="{{item.id}}" bindtap="onMenu">
      <view class="m-left">
        <text class="m-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
      <text class="m-arrow">›</text>
    </view>
  </view>

  <text class="ver mono">夜猫看台 · v0.1 体验版</text>
</view>
