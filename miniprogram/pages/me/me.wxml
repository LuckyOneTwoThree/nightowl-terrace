<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 用户卡（_18） -->
  <view class="profile card-low" bindtap="onEditNick">
    <view class="avatar-wrap">
      <view class="circle-xl avatar-box text-amber">
        <view class="v-icon v-paw brand-avatar-icon text-amber"></view>
      </view>
      <view class="dot-teal dot-pos animate-pulse"></view>
    </view>
    <view class="prof-mid">
      <view class="nick-row">
        <text class="hl nick-text">{{nickname}}</text>
        <view class="chip chip-amber lv-chip">Lv.3 夜猫子</view>
      </view>
      <text class="mono muted sign-text">“看球是生活的解药”</text>
    </view>
    <view class="edit-btn">
      <view class="v-icon v-tune text-muted"></view>
    </view>
  </view>

  <!-- 3列数据看板（_18 带顶部金线） -->
  <view class="stats-grid">
    <view class="stat-card card-low glow-top-gold">
      <text class="stat-num hl text-amber score-sm">{{stats.hours}}</text>
      <text class="mono muted stat-lbl">累计修仙</text>
    </view>
    <view class="stat-card card-low glow-top-teal">
      <text class="stat-num hl text-teal score-sm">{{stats.preds}}</text>
      <text class="mono muted stat-lbl">盲评参与</text>
    </view>
    <view class="stat-card card-low glow-top-gold">
      <text class="stat-num hl text-amber score-sm">{{stats.hit}}</text>
      <text class="mono muted stat-lbl">预测胜率</text>
    </view>
  </view>

  <!-- 关注主队（已关注列表 + 去管理入口） -->
  <view class="sect sect-gap">
    <text class="sect-title">关注主队</text>
    <view class="sect-line"></view>
    <text class="sect-more" bindtap="goManageTeams">管理主队 ›</text>
  </view>

  <!-- 状态 A：已有关注球队（精美流式卡片，支持一键移除与添加新队） -->
  <view class="followed-box" wx:if="{{followedTeams.length}}">
    <view class="followed-list">
      <view class="f-card card-low floodlight-glow" wx:for="{{followedTeams}}" wx:key="id">
        <image class="crest-md f-ava" src="{{item.logo}}" mode="aspectFill" wx:if="{{item.logo}}" /><view class="circle-md f-ava crest-fb" wx:else style="background: {{item.bg}}; border-color: {{item.bd}};">{{item.id}}</view>
        <view class="f-info">
          <text class="f-name hl">{{item.zh}}</text>
          <text class="f-lg mono muted">{{item.lgZh}}</text>
        </view>
        <view class="f-del" data-id="{{item.id}}" catchtap="onRemoveFollow">
          <view class="v-icon v-cross text-muted f-del-ic"></view>
        </view>
      </view>
      <!-- 添加主队入口药丸 -->
      <view class="f-add-card" bindtap="goManageTeams">
        <view class="v-icon v-bolt text-amber f-add-ic"></view>
        <text class="mono text-amber f-add-txt">+ 添加主队</text>
      </view>
    </view>
  </view>

  <!-- 状态 B：未关注任何球队的空态提示 -->
  <view class="f-empty card-low" wx:else bindtap="goManageTeams">
    <view class="fe-left">
      <view class="fe-icon-wrap">
        <view class="v-icon v-paw text-amber fe-paw"></view>
      </view>
      <view class="fe-content">
        <text class="fe-title hl">尚未关注任何主队</text>
        <text class="fe-sub mono muted">关注主队，赛程自动提级并推送专属提醒</text>
      </view>
    </view>
    <view class="chip chip-amber floodlight-glow fe-btn">
      <text class="hl">+ 挑选主队</text>
    </view>
  </view>

  <!-- 我的关注 · 本周主队赛程（PM 7.4 聚合视图） -->
  <block wx:if="{{myWeek.length}}">
    <view class="sect sect-gap">
      <text class="sect-title">本周主队赛程</text>
      <view class="sect-line"></view>
    </view>
    <view class="menu card-low">
      <view class="menu-row" wx:for="{{myWeek}}" wx:key="id" data-id="{{item.id}}" bindtap="goMatch">
        <view class="mr-left">
          <view class="v-icon v-soccer mr-icon text-amber"></view>
          <view class="mw-mid">
            <text class="mr-title hl">{{item.pair}}</text>
            <text class="mono muted mw-sub">{{item.tbd ? '时间待定' : item.md + ' ' + item.wd + ' ' + item.hm}} · {{item.lgZh}}</text>
          </view>
        </view>
        <view class="v-icon v-chev text-muted"></view>
      </view>
    </view>
  </block>

  <!-- 菜单列表（_18） -->
  <view class="sect sect-gap">
    <text class="sect-title">快捷入口</text>
    <view class="sect-line"></view>
  </view>
  <view class="menu card-low">
    <view class="menu-row" data-id="preds" bindtap="onMenu">
      <view class="mr-left">
        <view class="v-icon v-soccer mr-icon text-amber"></view>
        <text class="mr-title hl">我的预测记录</text>
      </view>
      <view class="v-icon v-chev text-muted"></view>
    </view>

    <view class="menu-row" data-id="boasts" bindtap="onMenu">
      <view class="mr-left">
        <view class="v-icon v-gavel mr-icon text-teal"></view>
        <text class="mr-title hl">德比法庭 · 狂言存档</text>
      </view>
      <view class="v-icon v-chev text-muted"></view>
    </view>

    <view class="menu-row" data-id="checkins" bindtap="onMenu">
      <view class="mr-left">
        <view class="v-icon v-moon mr-icon text-amber"></view>
        <text class="mr-title hl">夜猫打卡日历</text>
      </view>
      <view class="v-icon v-chev text-muted"></view>
    </view>

    <view class="menu-row" data-id="settings" bindtap="onMenu">
      <view class="mr-left">
        <view class="v-icon v-tune mr-icon text-muted"></view>
        <text class="mr-title hl">偏好与提醒设置</text>
      </view>
      <view class="v-icon v-chev text-muted"></view>
    </view>
  </view>

  <text class="ver mono">夜猫看台 · v0.2 高保真版</text>
</view>


