<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 动态环境氛围光晕 -->
  <view class="glow glow-amber" style="background: {{primaryGlow ? primaryGlow : 'rgba(255,178,36,.1)'}}; opacity: 0.12;"></view>
  <view class="glow glow-teal"></view>

  <!-- ==================== 1. 全景一体化黑金球迷通票 (VIP MATCH PASS) ==================== -->
  <view class="vip-pass card-highest floodlight-glow">
    <!-- 票券顶部：金属烙印与段位 -->
    <view class="pass-head">
      <view class="ph-brand">
        <view class="v-icon v-soccer text-amber ph-brand-ic"></view>
        <text class="mono ph-brand-txt">NIGHTOWL MATCH PASS · 观赛通票</text>
      </view>
      <view class="chip chip-amber pass-lv-chip" bindtap="onShowLevelModal">
        <view class="dot-teal pass-online-dot animate-pulse"></view>
        <text>{{levelZh}}</text>
        <text class="lv-arrow mono">›</text>
      </view>
    </view>

    <!-- 票券中部：身份与主队印章 -->
    <view class="pass-body" bindtap="onEditNick">
      <view class="pass-avatar-wrap">
        <view class="circle-xl pass-avatar text-amber">
          <view class="v-icon v-paw pass-avatar-ic text-amber"></view>
        </view>
      </view>
      <view class="pass-info">
        <view class="pass-nick-row">
          <text class="hl pass-nick">{{nickname}}</text>
          <view class="v-icon v-tune text-amber pass-edit-ic"></view>
        </view>

        <!-- 主队微标印章行 -->
        <view class="pass-stamps-row" wx:if="{{followedTeams.length}}">
          <view class="p-stamp card-low" wx:for="{{followedTeams}}" wx:key="id" wx:if="{{index < 3}}" catchtap="goManageTeams">
            <image class="crest-xs stamp-logo" src="{{item.logo}}" mode="aspectFill" wx:if="{{item.logo}}" />
            <view class="circle-xs stamp-fb" wx:else style="background: {{item.bg}}; border-color: {{item.bd}};">{{item.id}}</view>
            <text class="stamp-zh hl">{{item.zh}}</text>
          </view>
          <text class="mono muted stamp-more" wx:if="{{followedTeams.length > 3}}" catchtap="goManageTeams">+{{followedTeams.length - 3}}</text>
        </view>
        <view class="pass-stamps-empty mono muted" wx:else catchtap="goManageTeams">
          <text>+ 点击添加信仰主队印章</text>
        </view>

        <view class="pass-mid-row">
          <text class="mono muted pass-mid-txt">{{mid}} · “看球是生活的解药”</text>
        </view>
      </view>
    </view>

    <!-- 票券虚线撕口分割线 -->
    <view class="pass-tear-line">
      <view class="pass-notch notch-left"></view>
      <view class="pass-dash"></view>
      <view class="pass-notch notch-right"></view>
    </view>

    <!-- 票券底部：一体化核心战绩通栏 -->
    <view class="pass-stats-strip">
      <view class="p-stat-col">
        <text class="p-stat-val hl text-amber score-sm">{{stats.hours}}</text>
        <text class="mono muted p-stat-lbl">累计修仙</text>
      </view>
      <view class="p-stat-divider"></view>
      <view class="p-stat-col">
        <text class="p-stat-val hl text-teal score-sm">{{stats.hit}}</text>
        <text class="mono muted p-stat-lbl">预测胜率</text>
      </view>
      <view class="p-stat-divider"></view>
      <view class="p-stat-col" bindtap="onMenu" data-id="preds">
        <text class="p-stat-val hl text-amber score-sm">{{seasonPts}}分</text>
        <text class="mono muted p-stat-lbl">赛季总积分 ›</text>
      </view>
    </view>
  </view>

  <!-- ==================== 2. 观赛偏好 (单排横向滑动查看) ==================== -->
  <view class="pref-panel card-low">
    <view class="panel-head">
      <view class="ph-left">
        <view class="v-icon v-soccer text-amber ph-icon"></view>
        <text class="hl ph-title">我的观赛偏好</text>
      </view>
      <text class="mono text-amber ph-btn" bindtap="goManagePreferences" data-tab="leagues">全部偏好 ›</text>
    </view>

    <!-- 关注联赛（单排横滑） -->
    <view class="pref-sub-sect">
      <view class="pss-head">
        <text class="mono muted pss-lbl">关注联赛 ({{followedLeagues.length}})</text>
        <text class="mono muted pss-tip">横滑查看更多</text>
      </view>
      <scroll-view class="pref-scroll league-scroll" scroll-x enable-flex show-scrollbar="{{false}}" wx:if="{{followedLeagues.length}}">
        <view class="pref-track">
          <view class="l-cap card-high" wx:for="{{followedLeagues}}" wx:key="id" bindtap="goManagePreferences" data-tab="leagues">
            <view class="l-cap-bar" style="background: {{item.solid}};"></view>
            <text class="hl l-cap-zh">{{item.zh}}</text>
            <text class="mono muted l-cap-en">{{item.id}}</text>
          </view>
          <view class="pref-add-btn league-btn card-high mono muted" bindtap="goManageLeagues">
            <text>＋ 管理</text>
          </view>
        </view>
      </scroll-view>
      <view class="pref-empty mono muted" wx:else bindtap="goManagePreferences" data-tab="leagues">
        <text>尚未圈定关注联赛 · 点击快速选择 ›</text>
      </view>
    </view>

    <view class="panel-divider"></view>

    <!-- 信仰主队（单排横滑） -->
    <view class="pref-sub-sect">
      <view class="pss-head">
        <text class="mono muted pss-lbl">信仰主队 ({{followedTeams.length}})</text>
        <text class="mono muted pss-tip">横滑查看更多</text>
      </view>
      <scroll-view class="pref-scroll team-scroll" scroll-x enable-flex show-scrollbar="{{false}}" wx:if="{{followedTeams.length}}">
        <view class="pref-track">
          <view class="t-badge card-high" wx:for="{{followedTeams}}" wx:key="id" bindtap="goManagePreferences" data-tab="teams">
            <image class="crest-sm tb-ava" src="{{item.logo}}" mode="aspectFill" wx:if="{{item.logo}}" />
            <view class="circle-sm tb-ava crest-fb" wx:else style="background: {{item.bg}}; border-color: {{item.bd}};">{{item.id}}</view>
            <text class="tb-name hl">{{item.zh}}</text>
            <text class="tb-lg mono muted">{{item.lgZh}}</text>
          </view>
          <view class="pref-add-btn team-btn card-high mono muted" bindtap="goManageTeams">
            <text>＋ 增选</text>
          </view>
        </view>
      </scroll-view>
      <view class="pref-empty mono muted" wx:else bindtap="goManagePreferences" data-tab="teams">
        <text>尚未挑选信仰主队 · 挑选主队享专属排程 ›</text>
      </view>
    </view>
  </view>

  <!-- ==================== 3. 主队赛程 (单个精炼概览模块) ==================== -->
  <block wx:if="{{followedTeams.length}}">
    <view class="sect sect-gap">
      <view class="sect-head-row">
        <text class="sect-title">主队下一场</text>
        <view class="chip chip-ghost mono cal-export-chip" wx:if="{{myWeek.length}}" bindtap="onExportMyWeekCal">
          <view class="v-icon v-cal text-amber"></view>
          <text>导出日历</text>
        </view>
      </view>
      <view class="sect-line"></view>
    </view>

    <!-- 单个极简赛程模块卡片 -->
    <view class="sched-summary-card card-low floodlight-glow" wx:if="{{myWeek.length}}">
      <view class="ssc-main" data-id="{{myWeek[0].id}}" bindtap="goMatch">
        <view class="ts-head">
          <view class="ts-meta">
            <view class="chip chip-solid ts-lg-chip">{{myWeek[0].lgZh}}</view>
            <text class="mono muted ts-date">{{myWeek[0].md}} {{myWeek[0].wd}} {{myWeek[0].tbd ? '待定' : myWeek[0].hm}}</text>
          </view>
          <view class="chip chip-teal ts-cd-chip" wx:if="{{myWeek[0].cdText}}">
            <view class="dot-teal animate-pulse" wx:if="{{!myWeek[0].finished}}"></view>
            <text class="mono">{{myWeek[0].cdText}}</text>
          </view>
        </view>

        <view class="ts-vs">
          <view class="ts-side">
            <image class="crest-md" src="{{myWeek[0].home.logo}}" mode="aspectFill" wx:if="{{myWeek[0].home.logo}}" />
            <view class="circle-md crest-fb" wx:else style="background: {{myWeek[0].home.bg}}; border-color: {{myWeek[0].home.bd}};">{{myWeek[0].home.id}}</view>
            <text class="ts-name hl">{{myWeek[0].home.zh}}</text>
          </view>

          <view class="ts-mid">
            <block wx:if="{{myWeek[0].finished}}">
              <text class="ts-score hl text-glow">{{myWeek[0].scH}} - {{myWeek[0].scA}}</text>
              <text class="mono muted ts-status">已完赛</text>
            </block>
            <block wx:else>
              <text class="ts-time mono hl text-amber">{{myWeek[0].tbd ? 'TBD' : myWeek[0].hm}}</text>
              <text class="mono muted ts-vs-label">VS</text>
            </block>
          </view>

          <view class="ts-side">
            <image class="crest-md" src="{{myWeek[0].away.logo}}" mode="aspectFill" wx:if="{{myWeek[0].away.logo}}" />
            <view class="circle-md crest-fb" wx:else style="background: {{myWeek[0].away.bg}}; border-color: {{myWeek[0].away.bd}};">{{myWeek[0].away.id}}</view>
            <text class="ts-name hl">{{myWeek[0].away.zh}}</text>
          </view>
        </view>
      </view>

      <!-- 底部跳转进入全部赛程独立列表页 -->
      <view class="ssc-footer" bindtap="goAllSchedule">
        <view class="ssc-foot-left">
          <view class="v-icon v-cal text-amber ssc-cal-ic"></view>
          <text class="mono muted ssc-total-text">主队近期共 <text class="text-amber hl">{{myWeek.length}}</text> 场赛事</text>
        </view>
        <view class="ssc-foot-right mono text-amber">
          <text class="hl">查看全部赛程列表</text>
          <text class="ssc-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="ts-empty card-low" wx:else bindtap="goAllSchedule">
      <view class="v-icon v-cal text-muted ts-empty-ic"></view>
      <text class="mono muted">近两周主队暂无赛事 · 点击查看全部完整赛程 ›</text>
    </view>
  </block>

  <!-- ==================== 5. 玩法与设置 2x2 现代功能罗盘 ==================== -->
  <view class="sect sect-gap">
    <text class="sect-title">玩法与设置</text>
    <view class="sect-line"></view>
  </view>

  <view class="grid-menu">
    <view class="gm-card card-low" data-id="preds" bindtap="onMenu">
      <view class="gm-top">
        <view class="gm-icon-box ic-amber">
          <view class="v-icon v-soccer text-amber"></view>
        </view>
        <view class="v-icon v-chev text-muted gm-arrow"></view>
      </view>
      <text class="hl gm-title">我的预测记录</text>
      <text class="mono muted gm-sub">{{stats.preds ? stats.preds + '场已参与' : '胜负盲评与赛果'}}</text>
    </view>

    <view class="gm-card card-low" data-id="boasts" bindtap="onMenu">
      <view class="gm-top">
        <view class="gm-icon-box ic-teal">
          <view class="v-icon v-gavel text-teal"></view>
        </view>
        <view class="v-icon v-chev text-muted gm-arrow"></view>
      </view>
      <text class="hl gm-title">德比法庭狂言</text>
      <text class="mono muted gm-sub">嘴炮存档与应验判定</text>
    </view>

    <view class="gm-card card-low" data-id="checkins" bindtap="onMenu">
      <view class="gm-top">
        <view class="gm-icon-box ic-gold">
          <view class="v-icon v-moon text-amber"></view>
        </view>
        <view class="v-icon v-chev text-muted gm-arrow"></view>
      </view>
      <text class="hl gm-title">夜猫修仙风云榜</text>
      <text class="mono muted gm-sub">深夜打卡与圈子榜单</text>
    </view>

    <view class="gm-card card-low" data-id="settings" bindtap="onMenu">
      <view class="gm-top">
        <view class="gm-icon-box ic-muted">
          <view class="v-icon v-tune text-muted"></view>
        </view>
        <view class="v-icon v-chev text-muted gm-arrow"></view>
      </view>
      <text class="hl gm-title">偏好与设置</text>
      <text class="mono muted gm-sub">预算额度与开球提醒</text>
    </view>
  </view>

  <text class="ver mono">夜猫追球 · 今晚哪场值得熬 · v1.0</text>

  <!-- ==================== 6. 夜猫段位与荣誉称号弹窗 (Level & Title Modal) ==================== -->
  <view class="modal-backdrop {{showLevelModal ? 'show' : ''}}" bindtap="onCloseLevelModal"></view>
  <view class="level-sheet {{showLevelModal ? 'show' : ''}}">
    <view class="ls-handle"></view>
    <view class="ls-content">
      <view class="ls-header">
        <view class="ls-title-wrap">
          <text class="hl ls-title">夜猫荣誉段位与特权</text>
          <text class="mono muted ls-sub">NIGHTOWL RANKS & BADGES</text>
        </view>
        <view class="ls-close" bindtap="onCloseLevelModal">
          <view class="v-icon v-cross text-amber"></view>
        </view>
      </view>

      <!-- 当前段位与进阶进度卡片 -->
      <view class="ls-hero card-highest floodlight-glow">
        <view class="ls-hero-top">
          <view class="ls-badge-box text-amber">
            <text class="ls-badge-icon">{{curLevel.icon}}</text>
          </view>
          <view class="ls-hero-info">
            <view class="ls-cur-title hl text-amber">Lv.{{curLevel.lv}} {{curLevel.title}}</view>
            <text class="mono muted ls-cur-desc">当前享受: {{curLevel.perk}}</text>
          </view>
        </view>

        <!-- 进度条 -->
        <view class="ls-prog-wrap" wx:if="{{nextLevel}}">
          <view class="ls-prog-labels mono">
            <text class="muted">晋级下阶: Lv.{{nextLevel.lv}} {{nextLevel.title}}</text>
            <text class="text-amber hl">{{progressPct}}%</text>
          </view>
          <view class="ls-prog-track">
            <view class="ls-prog-bar" style="width: {{progressPct}}%;"></view>
          </view>
          <view class="ls-prog-cond mono muted">
            <text>需累计修仙 {{nextLevel.reqHours}}h 或 赛季总分达到 {{nextLevel.reqPts}} 分</text>
          </view>
        </view>
        <view class="ls-max-level mono text-amber hl" wx:else>
          <text>👑 已登峰造极 · 荣获殿堂级最高荣誉</text>
        </view>
      </view>

      <!-- 全量段位天梯体系列表 -->
      <view class="ls-ladder-title mono muted">全量 6 大荣誉段位天梯体系</view>
      <view class="ls-ladder">
        <view class="ls-tier card-low {{curLevel.lv === item.lv ? 'ls-tier-active' : ''}} {{curLevel.lv > item.lv ? 'ls-tier-unlocked' : ''}}"
              wx:for="{{levelsList}}" wx:key="lv">
          <view class="ls-tier-left">
            <text class="ls-tier-icon">{{item.icon}}</text>
            <view class="ls-tier-info">
              <view class="ls-tier-name hl">Lv.{{item.lv}} {{item.title}}
                <text class="chip chip-amber ls-cur-chip" wx:if="{{curLevel.lv === item.lv}}">当前</text>
                <text class="chip chip-teal ls-done-chip" wx:elif="{{curLevel.lv > item.lv}}">已达成</text>
              </view>
              <text class="ls-tier-perk mono muted">{{item.perk}}</text>
            </view>
          </view>
          <view class="ls-tier-req mono muted">
            <text>{{item.reqHours > 0 ? item.reqHours + 'h / ' + item.reqPts + '分' : '初始解锁'}}</text>
          </view>
        </view>
      </view>

      <button class="btn-amber ls-confirm-btn floodlight-glow" bindtap="onCloseLevelModal">
        <text>我知道了</text>
      </button>
    </view>
  </view>
</view>


