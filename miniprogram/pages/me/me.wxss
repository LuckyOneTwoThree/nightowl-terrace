.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; }

/* 用户信息卡 */
.profile {
  display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx;
  position: relative; border-radius: var(--r-xl);
}
.profile:active { background: var(--sc-high); }
.avatar-wrap { position: relative; }
.avatar-box {
  width: 120rpx; height: 120rpx; font-size: 36rpx;
  background: var(--sc-high); border: 2rpx solid rgba(255,178,36,.4);
  box-shadow: 0 0 20rpx rgba(255,178,36,.2);
}
.dot-pos { position: absolute; right: 4rpx; bottom: 4rpx; width: 18rpx; height: 18rpx; }

.prof-mid { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.nick-row { display: flex; align-items: center; gap: 14rpx; }
.nick-text { font-size: 36rpx; font-weight: 700; color: var(--on-surface); }
.lv-chip { padding: 2rpx 14rpx; font-size: 20rpx; }
.sign-text { font-size: 22rpx; }
.edit-btn { padding: 12rpx; }

/* 3列数据看板 */
.stats-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }
.stat-card {
  flex: 1; padding: 24rpx 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  border-radius: var(--r-lg); position: relative; overflow: hidden;
}
.glow-top-gold { border-top: 4rpx solid var(--primary-container); }
.glow-top-teal { border-top: 4rpx solid var(--secondary); }
.stat-num { line-height: 48rpx; }
.stat-lbl { font-size: 22rpx; }

.sect-gap { margin: 48rpx 0 20rpx; }

/* 关注球队 */
.lg-group { margin-bottom: 24rpx; }
.lg-hdr { display: block; margin-bottom: 14rpx; font-size: 22rpx; }
.team-pills { display: flex; flex-wrap: wrap; gap: 14rpx; }
.t-pill {
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 12rpx 24rpx; border-radius: var(--r-full);
  background: var(--sc-low); border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); font-size: 24rpx;
  transition: all .2s ease;
}
.t-pill.on {
  background: rgba(255,178,36,.12); border-color: rgba(255,178,36,.5);
  color: var(--primary-container); font-weight: 700;
}
.t-dot { width: 14rpx; height: 14rpx; border-radius: var(--r-full); }
.t-zh { font-family: var(--font-body); }
.check-s { width: 24rpx; height: 24rpx; }

/* 快捷菜单 */
.menu { padding: 4rpx 0; overflow: hidden; border-radius: var(--r-xl); }
.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 32rpx; border-bottom: 1rpx solid rgba(159,142,121,.08);
  transition: background .15s ease;
}
.menu-row:last-child { border-bottom: none; }
.menu-row:active { background: var(--sc-high); }
.mr-left { display: flex; align-items: center; gap: 20rpx; }
.mr-icon { width: 36rpx; height: 36rpx; }
.mr-title { font-size: 28rpx; color: var(--on-surface); }

/* 我的关注 · 本周赛程行 */
.mw-mid { display: flex; flex-direction: column; gap: 4rpx; }
.mw-sub { font-size: 22rpx; }
