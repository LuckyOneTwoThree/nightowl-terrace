.page { padding-bottom: 64rpx; }

.guide {
  margin: 24rpx 32rpx 8rpx;
  padding: 32rpx;
  border: 1rpx dashed rgba(255, 178, 36, 0.4);
  border-radius: var(--r-lg);
  background: var(--primary-dim);
}
.g-title { font-size: 34rpx; font-weight: 800; color: var(--primary); margin-bottom: 8rpx; }
.g-sub { color: var(--muted); font-size: 24rpx; }

.lg-block { margin: 8rpx 32rpx 24rpx; }
.lg-name { color: var(--muted); font-size: 24rpx; margin-bottom: 12rpx; }
.t-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.t-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--line-strong);
  font-size: 24rpx;
  color: var(--muted);
}
.t-chip.on {
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 700;
}
.dot { width: 16rpx; height: 16rpx; border-radius: var(--r-full); }

.rec { margin: 0 32rpx 16rpx; }
.rec-row { color: var(--muted); font-size: 24rpx; }

.go { margin: 32rpx 32rpx 0; }
