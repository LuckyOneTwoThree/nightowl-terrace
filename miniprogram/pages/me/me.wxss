.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; box-sizing: border-box; }

/* 用户信息卡 */
.profile {
  display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx;
  position: relative; border-radius: var(--r-xl);
}
.profile:active { background: var(--sc-high); }
.avatar-wrap { position: relative; }
.avatar-box {
  width: 120rpx; height: 120rpx; font-size: 36rpx;
  background: var(--sc-high); border: 2rpx solid rgba(255,178,36,.4);
  box-shadow: 0 0 20rpx rgba(255,178,36,.2);
  display: flex; align-items: center; justify-content: center;
}
.brand-avatar-icon { width: 60rpx; height: 60rpx; }
.dot-pos { position: absolute; right: 4rpx; bottom: 4rpx; width: 18rpx; height: 18rpx; }

.prof-mid { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.nick-row { display: flex; align-items: center; gap: 14rpx; }
.nick-text { font-size: 36rpx; font-weight: 700; color: var(--on-surface); }
.lv-chip { padding: 2rpx 14rpx; font-size: 20rpx; }
.sign-text { font-size: 22rpx; }
.edit-btn { padding: 12rpx; }

/* 3列数据看板 */
.stats-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }
.stat-card {
  flex: 1; padding: 24rpx 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  border-radius: var(--r-lg); position: relative; overflow: hidden;
}
.glow-top-gold { border-top: 4rpx solid var(--primary-container); }
.glow-top-teal { border-top: 4rpx solid var(--secondary); }
.stat-num { line-height: 48rpx; }
.stat-lbl { font-size: 22rpx; }

.sect-gap { margin: 44rpx 0 20rpx; }

/* ---------- 关注主队：外层精简展示区 ---------- */
.followed-box { width: 100%; margin-bottom: 24rpx; }
.followed-list { display: flex; flex-wrap: wrap; gap: 16rpx; }

.f-card {
  display: inline-flex; align-items: center; gap: 14rpx;
  padding: 10rpx 18rpx 10rpx 10rpx; border-radius: var(--r-full);
  border: 1rpx solid rgba(255,178,36,.4); background: rgba(255,178,36,.06);
  transition: all .2s ease;
}
.f-ava { font-size: 18rpx; flex-shrink: 0; }
.f-info { display: flex; flex-direction: column; gap: 2rpx; }
.f-name { font-size: 26rpx; line-height: 32rpx; color: var(--on-surface); }
.f-lg { font-size: 18rpx; line-height: 22rpx; }
.f-del { padding: 8rpx; margin-left: 4rpx; display: flex; align-items: center; justify-content: center; }
.f-del-ic { width: 22rpx; height: 22rpx; opacity: .7; }
.f-del:active .f-del-ic { opacity: 1; color: var(--error); }

.f-add-card {
  display: inline-flex; align-items: center; gap: 10rpx;
  padding: 12rpx 28rpx; border-radius: var(--r-full);
  border: 1rpx dashed rgba(255,178,36,.5); background: rgba(255,178,36,.04);
  transition: all .15s ease;
}
.f-add-card:active { background: rgba(255,178,36,.12); transform: scale(0.98); }
.f-add-ic { width: 24rpx; height: 24rpx; }
.f-add-txt { font-size: 24rpx; font-weight: 600; }

/* 未关注任何球队时的空态引导卡片 */
.f-empty {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-radius: var(--r-xl);
  border: 1rpx dashed rgba(159,142,121,.25); background: var(--sc-low);
  transition: background .15s ease;
}
.f-empty:active { background: var(--sc-high); }
.fe-left { display: flex; align-items: center; gap: 20rpx; flex: 1; }
.fe-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: var(--r-full);
  background: rgba(255,178,36,.1); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fe-paw { width: 36rpx; height: 36rpx; }
.fe-content { display: flex; flex-direction: column; gap: 4rpx; }
.fe-title { font-size: 28rpx; color: var(--on-surface); }
.fe-sub { font-size: 20rpx; line-height: 28rpx; }
.fe-btn { font-size: 24rpx; padding: 12rpx 24rpx; flex-shrink: 0; margin-left: 16rpx; }

/* 快捷菜单 */
.menu { padding: 4rpx 0; overflow: hidden; border-radius: var(--r-xl); }
.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 32rpx; border-bottom: 1rpx solid rgba(159,142,121,.08);
  transition: background .15s ease;
}
.menu-row:last-child { border-bottom: none; }
.menu-row:active { background: var(--sc-high); }
.mr-left { display: flex; align-items: center; gap: 20rpx; }
.mr-icon { width: 36rpx; height: 36rpx; }
.mr-title { font-size: 28rpx; color: var(--on-surface); }

/* 我的关注 · 本周赛程行 */
.mw-mid { display: flex; flex-direction: column; gap: 4rpx; }
.mw-sub { font-size: 22rpx; }

.ver { display: block; text-align: center; margin: 48rpx auto 16rpx; font-size: 20rpx; color: var(--on-surface-variant); opacity: .6; }



