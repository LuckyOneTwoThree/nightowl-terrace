.page { padding: 32rpx 32rpx 48rpx; }

/* 头部 */
.head { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.avatar {
  width: 112rpx; height: 112rpx; border-radius: var(--r-full);
  background: var(--sc-highest); border: 1rpx solid var(--sc-variant);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
}
.h-col { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.h-name { font-family: var(--font-headline); font-size: 40rpx; font-weight: 700; }
.h-set { font-size: 40rpx; }

/* 统计 */
.stats { display: flex; align-items: center; padding: 32rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.s-num { font-family: var(--font-mono); font-size: 40rpx; font-weight: 700; color: var(--primary-container); }
.s-label { color: var(--on-surface-variant); font-size: 20rpx; }
.s-div { width: 2rpx; height: 56rpx; background: var(--sc-highest); }

.sect-gap { margin: 48rpx 0 24rpx; }

/* 关注球队 */
.follow { padding: 8rpx 24rpx 24rpx; }
.f-group { padding-top: 24rpx; }
.f-lg { display: block; margin-bottom: 16rpx; }
.f-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.f-chip {
  display: inline-flex; align-items: center; gap: 10rpx;
  padding: 12rpx 24rpx; border-radius: var(--r-full);
  border: 1rpx solid var(--hairline);
  color: var(--on-surface-variant); font-size: 24rpx;
}
.f-chip.on {
  background: var(--primary-container); border-color: transparent;
  color: var(--on-primary); font-weight: 700;
  box-shadow: 0 0 16rpx rgba(255,178,36,.3);
}
.f-dot { width: 12rpx; height: 12rpx; border-radius: var(--r-full); }
.f-new {
  font-size: 16rpx; padding: 2rpx 8rpx; border-radius: var(--r-sm);
  background: var(--sc-highest); color: var(--on-surface-variant);
}
.f-chip.on .f-new { background: rgba(68,43,0,.2); color: var(--on-primary); }

/* 菜单 */
.menu { padding: 0 8rpx; }
.m-left { display: flex; align-items: center; gap: 20rpx; font-size: 28rpx; }
.m-icon { font-size: 32rpx; }
.m-arrow { color: var(--outline); font-size: 36rpx; }

.ver { display: block; text-align: center; margin-top: 48rpx; color: var(--outline-variant); font-size: 20rpx; }
