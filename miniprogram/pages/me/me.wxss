.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; box-sizing: border-box; }

/* 用户信息卡 */
.profile {
  display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx;
  position: relative; border-radius: var(--r-xl);
}
.profile:active { background: var(--sc-high); }
.avatar-wrap { position: relative; }
.avatar-box {
  width: 120rpx; height: 120rpx; font-size: 36rpx;
  background: var(--sc-high); border: 2rpx solid rgba(255,178,36,.4);
  box-shadow: 0 0 20rpx rgba(255,178,36,.2);
  display: flex; align-items: center; justify-content: center;
}
.brand-avatar-icon { width: 60rpx; height: 60rpx; }
.dot-pos { position: absolute; right: 4rpx; bottom: 4rpx; width: 18rpx; height: 18rpx; }

.prof-mid { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.nick-row { display: flex; align-items: center; gap: 14rpx; }
.nick-text { font-size: 36rpx; font-weight: 700; color: var(--on-surface); }
.lv-chip { padding: 2rpx 14rpx; font-size: 20rpx; }
.sign-text { font-size: 22rpx; }
.edit-btn { padding: 12rpx; }

/* 3列数据看板 */
.stats-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }
.stat-card {
  flex: 1; padding: 24rpx 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  border-radius: var(--r-lg); position: relative; overflow: hidden;
}
.glow-top-gold { border-top: 4rpx solid var(--primary-container); }
.glow-top-teal { border-top: 4rpx solid var(--secondary); }
.stat-num { line-height: 48rpx; }
.stat-lbl { font-size: 22rpx; }

.sect-gap { margin: 44rpx 0 20rpx; }

/* ---------- 关注主队：微标芯片展示区 ---------- */
.followed-box { width: 100%; margin-bottom: 24rpx; }
.followed-list { display: flex; flex-wrap: wrap; gap: 14rpx; }

.f-card {
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 10rpx 20rpx 10rpx 12rpx; border-radius: var(--r-full);
  border: 1rpx solid rgba(255,178,36,.35); background: rgba(255,178,36,.06);
  transition: all .15s ease;
}
.f-card:active { transform: scale(0.97); background: rgba(255,178,36,.12); }
.f-ava { font-size: 18rpx; flex-shrink: 0; }
.f-name { font-size: 26rpx; line-height: 32rpx; color: var(--on-surface); font-weight: 600; }
.f-lg { font-size: 20rpx; line-height: 24rpx; }

.expand-btn {
  display: flex; align-items: center; justify-content: center;
  padding: 14rpx 0 0; font-size: 22rpx; opacity: .8;
  transition: opacity .15s ease;
}
.expand-btn:active { opacity: 1; color: var(--primary-container); }

/* 未关注任何球队时的空态引导卡片 */
.f-empty {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-radius: var(--r-xl);
  border: 1rpx dashed var(--line-strong); background: var(--sc-low);
  transition: background .15s ease;
}
.f-empty:active { background: var(--sc-high); }
.fe-left { display: flex; align-items: center; gap: 20rpx; flex: 1; }
.fe-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: var(--r-full);
  background: rgba(255,178,36,.1); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fe-paw { width: 36rpx; height: 36rpx; }
.fe-content { display: flex; flex-direction: column; gap: 4rpx; }
.fe-title { font-size: 28rpx; color: var(--on-surface); }
.fe-sub { font-size: 20rpx; line-height: 28rpx; }
.fe-btn { font-size: 24rpx; padding: 12rpx 24rpx; flex-shrink: 0; margin-left: 16rpx; }

/* ---------- 本周主队赛程：独立对决卡片列表 ---------- */
.ts-count { font-size: 24rpx; }
.team-sched-list { display: flex; flex-direction: column; gap: 16rpx; }

.ts-card {
  padding: 22rpx 28rpx; border-radius: var(--r-xl);
  border: 1rpx solid var(--hairline); transition: all .15s ease;
}
.ts-card:active { transform: scale(0.98); background: var(--sc-high); border-color: rgba(255,178,36,.4); }

.ts-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 18rpx;
}
.ts-meta { display: flex; align-items: center; gap: 12rpx; }
.ts-date { font-size: 22rpx; }
.ts-lg-chip { font-size: 20rpx; padding: 2rpx 10rpx; }
.ts-cost-chip { font-size: 20rpx; padding: 2rpx 12rpx; gap: 6rpx; }
.ts-cost-chip .v-icon { width: 20rpx; height: 20rpx; }

.ts-vs {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 0;
}
.ts-side {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  width: 180rpx; flex-shrink: 0;
}
.ts-name {
  font-size: 26rpx; color: var(--on-surface); text-align: center;
  max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ts-mid {
  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.ts-time { font-size: 36rpx; font-weight: 700; }
.ts-vs-label { font-size: 20rpx; letter-spacing: 2rpx; }
.ts-score { font-size: 38rpx; font-weight: 800; }
.ts-status { font-size: 20rpx; }

.ts-empty {
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  padding: 36rpx 28rpx; border-radius: var(--r-xl);
  border: 1rpx dashed var(--hairline);
}
.ts-empty-ic { width: 32rpx; height: 32rpx; }
.ts-empty text { font-size: 24rpx; }

.expand-match-btn {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0; border-radius: var(--r-xl);
  border: 1rpx dashed var(--hairline); transition: all .15s ease;
  margin-top: 4rpx;
}
.expand-match-btn:active { background: var(--sc-high); transform: scale(0.98); }
.expand-match-btn text { font-size: 24rpx; font-weight: 600; }

/* 快捷菜单 */
.menu { padding: 4rpx 0; overflow: hidden; border-radius: var(--r-xl); }
.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx; border-bottom: 1rpx solid var(--outline-muted);
  transition: all .15s ease;
}
.menu-row:last-child { border-bottom: none; }
.menu-row:active { background: var(--sc-high); transform: scale(0.99); }
.mr-left { display: flex; align-items: center; gap: 20rpx; }
.menu-icon-box {
  width: 64rpx; height: 64rpx; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.menu-icon-box .v-icon { width: 34rpx; height: 34rpx; }
.ic-amber { background: rgba(255,178,36,.12); border: 1rpx solid rgba(255,178,36,.3); }
.ic-teal { background: rgba(20,224,191,.12); border: 1rpx solid rgba(20,224,191,.3); }
.ic-gold { background: rgba(255,215,158,.12); border: 1rpx solid rgba(255,215,158,.3); }
.ic-muted { background: var(--sc-high); border: 1rpx solid var(--outline-muted); }

.mr-title { font-size: 28rpx; color: var(--on-surface); font-weight: 600; }

/* 我的关注 · 本周赛程行 */
.mw-mid { display: flex; flex-direction: column; gap: 4rpx; }
.mw-sub { font-size: 22rpx; }

.id-row { display: flex; align-items: center; margin-top: 2rpx; }

.ver { display: block; text-align: center; margin: 48rpx auto 16rpx; font-size: 20rpx; color: var(--on-surface-variant); opacity: .6; }



