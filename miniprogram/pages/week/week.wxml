<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 顶部极简周规划状态条 -->
  <view class="week-header glass-panel">
    <view class="wh-top">
      <view class="wh-stat">
        <view class="wh-icon-wrap">
          <view class="v-icon v-bolt text-amber wh-icon"></view>
        </view>
        <view class="wh-info">
          <view class="wh-title-row">
            <text class="wh-title hl">本周看球计划</text>
            <text class="wh-count-tag mono">{{best.length}} 场精选</text>
          </view>
          <text class="mono muted wh-sub">已规划 {{usedText}}h / 预算 {{budgetText}}h（{{pctText}}）</text>
        </view>
      </view>
      
      <view class="wh-actions">
        <view class="wh-btn btn-amber-subtle" bindtap="openSheet">
          <view class="v-icon v-tune text-amber"></view>
          <text class="mono">调额</text>
        </view>
      </view>
    </view>

    <!-- 微流光进度条 -->
    <view class="wh-progress-bg">
      <view class="wh-progress-bar {{isOverBudget ? 'over' : ''}}" style="width: {{pctNumber}}%;"></view>
    </view>
  </view>

  <!-- 透支结算提醒（若有） -->
  <view class="over-bar card-low" wx:if="{{overNote}}">
    <view class="over-left">
      <view class="dot-amber animate-pulse"></view>
      <text class="mono over-text">{{overNote}}</text>
    </view>
    <view class="over-btn" bindtap="onAdoptSuggest">采纳建议 ›</view>
  </view>

  <!-- ================= 1. 本周超级头牌（若只熬一场） ================= -->
  <block wx:if="{{highlight}}">
    <view class="sect-header">
      <text class="sect-title hl">{{highlight.isFollowedTeam ? '👑 信仰主队出战 · 若只熬一场' : '👑 若只熬一场 · 选这场'}}</text>
    </view>

    <view class="hero-card card-highest {{highlight.isFollowedTeam ? 'hc-followed' : ''}}" data-id="{{highlight.id}}" bindtap="onMatch">
      <view class="hc-bar" style="background: {{highlight.followedTeamColor || highlight.accent}};"></view>
      
      <view class="hc-head">
        <view class="hc-league-tag" style="background: {{highlight.accent}};">{{highlight.lgZh}}</view>
        <view class="chip chip-amber hc-team-chip" wx:if="{{highlight.isFollowedTeam}}">
          <view class="v-icon v-paw text-amber"></view>
          <text>🛡️ {{highlight.followedTeamName}} 信仰战</text>
        </view>
        <view class="hc-idx-pill mono" wx:else>
          <text class="text-amber">爆表指数 {{highlight.indexText}}</text>
        </view>
      </view>

      <!-- 双队对决 -->
      <view class="hc-battle">
        <view class="hc-team">
          <image class="crest-xl" src="{{highlight.home.logo}}" mode="aspectFit" wx:if="{{highlight.home.logo}}" />
          <view class="circle-xl crest-fb" wx:else style="background: {{highlight.home.bg}}; border-color: {{highlight.home.bd}};">{{highlight.home.id}}</view>
          <view class="hc-name-wrap">
            <text class="hc-name hl {{highlight.isFollowedHome ? 'text-amber' : ''}}">{{highlight.home.zh}}</text>
            <text class="hc-shield" wx:if="{{highlight.isFollowedHome}}">🛡️</text>
          </view>
        </view>

        <view class="hc-center">
          <text class="hc-time score-m text-amber hl">{{highlight.hm}}</text>
          <view class="hc-cost-pill">
            <text class="mono text-teal" wx:if="{{highlight.cost === 0}}">黄金档无需熬夜</text>
            <text class="mono text-amber" wx:else>{{highlight.costText}}</text>
          </view>
          <text class="hc-date-sub mono muted">{{highlight.dateZh}} · {{highlight.wd}}</text>
        </view>

        <view class="hc-team">
          <image class="crest-xl" src="{{highlight.away.logo}}" mode="aspectFit" wx:if="{{highlight.away.logo}}" />
          <view class="circle-xl crest-fb" wx:else style="background: {{highlight.away.bg}}; border-color: {{highlight.away.bd}};">{{highlight.away.id}}</view>
          <view class="hc-name-wrap">
            <text class="hc-name hl {{highlight.isFollowedAway ? 'text-amber' : ''}}">{{highlight.away.zh}}</text>
            <text class="hc-shield" wx:if="{{highlight.isFollowedAway}}">🛡️</text>
          </view>
        </view>
      </view>

      <!-- 核心看点 -->
      <view class="hc-footer" wx:if="{{highlight.reason}}">
        <text class="hc-reason hl">{{highlight.reason}}</text>
        <text class="hc-arrow mono muted">看点 ›</text>
      </view>
    </view>
  </block>

  <!-- ================= 2. 条件切换 Tab (精选 / 备选 / 避坑 / 全部) ================= -->
  <view class="filter-tab-bar">
    <view class="ft-tab {{currentTab === 'best' ? 'active' : ''}}" data-tab="best" bindtap="onTabChange">
      <text class="ft-name">🌟 精选</text>
      <text class="ft-count mono">{{tabCounts.best}}</text>
    </view>
    <view class="ft-tab {{currentTab === 'focal' ? 'active' : ''}}" data-tab="focal" bindtap="onTabChange">
      <text class="ft-name">⚽️ 焦点</text>
      <text class="ft-count mono">{{tabCounts.focal}}</text>
    </view>
    <view class="ft-tab {{currentTab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="onTabChange">
      <text class="ft-name">💤 避坑</text>
      <text class="ft-count mono">{{tabCounts.mine}}</text>
    </view>
    <view class="ft-tab {{currentTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onTabChange">
      <text class="ft-name">📋 全部</text>
      <text class="ft-count mono">{{tabCounts.all}}</text>
    </view>
  </view>

  <!-- ================= 3. 本周观赛路线图 (Day-by-Day Journey) ================= -->
  <view class="journey-container">
    <block wx:for="{{filteredJourney}}" wx:for-item="dayGroup" wx:key="day">
      <view class="day-block">
        <!-- 日期标头 -->
        <view class="day-head">
          <view class="dh-title-wrap">
            <view class="dh-indicator"></view>
            <text class="dh-date mono hl">{{dayGroup.title}}</text>
          </view>
          <text class="dh-tag mono">{{dayGroup.tag}}</text>
        </view>

        <!-- 该日重点赛程卡片列表 -->
        <view class="match-list">
          <view class="match-card {{item.isFollowedTeam ? 'followed-team-card' : ''}} {{item.isMine ? 'mine-card' : ''}} card-low" wx:for="{{dayGroup.matches}}" wx:key="id" data-id="{{item.id}}" bindtap="onMatch">
            <view class="mc-bar" style="background: {{item.isFollowedTeam ? (item.followedTeamColor || '#FFB224') : (item.isMine ? '#FF5A5F' : item.accent)}};"></view>
            
              <view class="mc-top">
                <view class="mc-meta">
                  <text class="mc-time mono hl">{{item.kickoffTimeText}}</text>
                  <text class="mc-league mono muted">{{item.lgZh}}</text>
                  <text class="mc-team-tag mono" wx:if="{{item.isFollowedTeam}}">🛡️ 信仰主队</text>
                  <text class="mc-sleep-tag mono" wx:elif="{{item.isMine}}">💤 建议睡觉</text>
                  <text class="mc-owl-tag mono" wx:elif="{{item.cost > 0}}">{{item.costText}}</text>
                  <text class="mc-free-tag mono" wx:else>黄金档</text>
                </view>
                <view class="mc-badge">
                  <text class="mono text-amber" wx:if="{{item.isFollowedTeam}}">指数 {{item.indexText}}</text>
                  <text class="mono text-amber" wx:elif="{{item.isBest}}">🌟 指数 {{item.indexText}}</text>
                  <text class="mono muted" wx:elif="{{item.isMine}}">避坑</text>
                  <text class="mono text-teal" wx:else>指数 {{item.indexText}}</text>
                </view>
              </view>

            <view class="mc-middle">
              <view class="mc-teams">
                <image class="crest-sm" src="{{item.home.logo}}" mode="aspectFit" wx:if="{{item.home.logo}}" />
                <view class="circle-sm crest-fb" wx:else style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
                <text class="mc-team-name hl {{item.isFollowedHome ? 'text-amber text-glow' : ''}}">{{item.home.zh}}{{item.isFollowedHome ? ' 🛡️' : ''}}</text>
                <text class="mc-vs mono muted">vs</text>
                <text class="mc-team-name hl {{item.isFollowedAway ? 'text-amber text-glow' : ''}}">{{item.away.zh}}{{item.isFollowedAway ? ' 🛡️' : ''}}</text>
                <image class="crest-sm" src="{{item.away.logo}}" mode="aspectFit" wx:if="{{item.away.logo}}" />
                <view class="circle-sm crest-fb" wx:else style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
              </view>
            </view>

            <view class="mc-reason {{item.isMine ? 'mine-reason' : ''}} {{item.isFollowedTeam ? 'team-reason' : ''}}" wx:if="{{item.reason}}">
              <text class="mc-reason-text">{{item.reason}}</text>
              <text class="mc-arrow mono muted">详情 ›</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 空态提示 -->
    <view class="card-low empty-tip" wx:if="{{!filteredJourney.length}}">
      <text class="mono muted" wx:if="{{currentTab === 'best'}}">当前预算额度内暂无排期，可点击上方「调额」增加预算。</text>
      <text class="mono muted" wx:elif="{{currentTab === 'mine'}}">本周暂无建议早睡的雷区场次，放心观赛！</text>
      <text class="mono muted" wx:elif="{{currentTab === 'focal'}}">本周焦点场次已全部收录于精选计划中。</text>
      <text class="mono muted" wx:else>本周暂无可排期的赛事。</text>
    </view>
  </view>

  <!-- ================= 3. 导出日历通栏按钮 ================= -->
  <view class="cal-action-btn floodlight-glow" bindtap="onExportCal">
    <view class="cab-left">
      <view class="v-icon v-cal text-amber cab-icon"></view>
      <view class="cab-text">
        <text class="cab-title hl">将本周看球计划导入系统日历</text>
        <text class="cab-sub mono muted">开球前 30 分钟静默提醒 · 告别睡过</text>
      </view>
    </view>
    <view class="v-icon v-chev text-amber cab-arrow"></view>
  </view>

  <!-- ================= 额度调整底部抽屉 (Bottom Sheet) ================= -->
  <view class="modal-backdrop {{showSheet ? 'show' : ''}}" bindtap="closeSheet"></view>
  <view class="bottom-sheet {{showSheet ? 'show' : ''}}">
    <view class="sheet-handle"></view>
    <view class="sheet-content">
      <view class="sheet-header">
        <text class="sheet-title hl">调整本周熬夜额度</text>
        <view class="sheet-close" bindtap="closeSheet">
          <view class="v-icon v-cross text-amber"></view>
        </view>
      </view>
      
      <view class="sheet-display">
        <text class="sheet-val text-glow text-amber hl">{{sheetBudget}}</text>
        <text class="sheet-unit mono muted">小时 / 周</text>
      </view>

      <view class="sheet-slider-wrap">
        <slider min="1.0" max="10.0" step="0.5" value="{{sheetBudget}}"
                activeColor="#FFB800" backgroundColor="#1E283A" block-color="#FFB800" block-size="24"
                bindchange="onSliderChange" bindchanging="onSliderChange" />
        <view class="sheet-slider-ticks mono muted">
          <text>1.0h (养生)</text>
          <text>5.0h (均衡)</text>
          <text>10.0h (硬核)</text>
        </view>
      </view>

      <view class="sheet-tip card-high">
        <view class="v-icon v-bolt text-teal sheet-tip-icon"></view>
        <text class="sheet-tip-text">预计当前额度可完整覆盖 <text class="text-teal hl">{{sheetCoverCount}}</text> 场焦点大战</text>
      </view>

      <view class="sheet-actions">
        <button class="sheet-btn-cancel btn-outline" bindtap="closeSheet">取消</button>
        <button class="sheet-btn-save btn-amber" bindtap="saveSheet">保存额度</button>
      </view>
    </view>
  </view>
</view>

