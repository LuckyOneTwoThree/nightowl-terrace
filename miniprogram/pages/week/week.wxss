.page { padding: 24rpx 32rpx 48rpx; }

/* 预算卡 */
.budget { display: flex; align-items: center; gap: 40rpx; padding: 32rpx; }
.ring {
  width: 200rpx; height: 200rpx; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
}
.ring-inner {
  width: 150rpx; height: 150rpx; border-radius: var(--r-full);
  background: var(--sc-low);
  display: flex; align-items: center; justify-content: center;
}
.ring-num { font-family: var(--font-mono); font-size: 32rpx; font-weight: 700; color: var(--primary-container); }
.b-right { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.b-title { font-family: var(--font-headline); font-size: 32rpx; font-weight: 600; }
.b-nums { display: flex; align-items: baseline; gap: 16rpx; }
.b-num-on { font-family: var(--font-mono); font-size: 44rpx; font-weight: 700; color: var(--on-surface); }
.b-btn { margin-top: 8rpx; }

/* 页内调额步进器（PM 9.1 即时重算） */
.b-step { display: flex; align-items: center; gap: 20rpx; margin-top: 8rpx; }
.b-step-btn {
  width: 56rpx; height: 56rpx; border-radius: var(--r-full);
  background: var(--sc-high); color: var(--on-surface);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 600; line-height: 1;
}
.b-step-btn:active { background: var(--sc-highest); }
.b-step-num { font-size: 30rpx; font-weight: 700; color: var(--primary-container); min-width: 110rpx; text-align: center; }

/* 周一透支结算提示 */
.over-note {
  margin-top: 20rpx; padding: 24rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  border: 1rpx solid var(--outline-variant);
}
.over-text { font-size: 24rpx; color: var(--on-surface-variant); flex: 1; }

/* 最优组合 */
.sect-gap { margin: 48rpx 0 24rpx; }
.plan { padding: 8rpx 0; }
.plan-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; position: relative; overflow: hidden; }
.pr-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }
.pr-mid { flex: 1; display: flex; flex-direction: column; }
.pr-pair { font-size: 30rpx; font-weight: 600; }
.pr-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.pr-idx { font-family: var(--font-mono); font-size: 32rpx; font-weight: 700; color: var(--primary); }
.pr-stars { color: var(--primary-container); font-size: 24rpx; letter-spacing: 2rpx; }
.pr-cost { color: var(--on-surface-variant); font-size: 20rpx; }
.plan-alt { padding: 16rpx 24rpx 20rpx; font-size: 22rpx; }

/* 若只熬一场（渐变描边 + 泛光） */
.hl-wrap { padding: 2rpx; border-radius: var(--r-xl); background: linear-gradient(90deg, rgba(255,178,36,.6), rgba(159,142,121,.2)); }
.hl-card { background: var(--sc); border-radius: var(--r-xl); overflow: hidden; }
.hl-head { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--hairline); }
.hl-fire { font-size: 28rpx; }
.hl-label { color: var(--primary); }
.hl-body { display: flex; align-items: center; padding: 24rpx; gap: 24rpx; }
.hl-mid { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.hl-pair { font-family: var(--font-headline); font-size: 40rpx; font-weight: 600; line-height: 48rpx; }
.hl-stats { display: flex; align-items: center; gap: 24rpx; }
.hl-stat { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.hl-idx { font-family: var(--font-mono); font-size: 40rpx; font-weight: 700; color: var(--primary-container); }
.hl-cost { font-family: var(--font-mono); font-size: 32rpx; font-weight: 700; }
.hl-div { width: 2rpx; height: 56rpx; background: var(--sc-highest); }
.hl-btn {
  padding: 16rpx 28rpx; border-radius: var(--r-md);
  background: var(--primary-container); color: var(--on-primary-container);
  font-size: 26rpx; font-weight: 700;
}

/* 雷区 */
.mine { padding: 24rpx; margin-bottom: 16rpx; border-color: rgba(255,180,171,.3); }
.mine-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.mine-pair { display: block; font-size: 30rpx; font-weight: 600; margin: 8rpx 0; }
.mine-reason { color: var(--error); font-size: 24rpx; }
.mine-ok { padding: 32rpx; text-align: center; }

/* 修仙场 */
.owl { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.owl .mine-pair { flex: 1; margin: 0; }
.owl-time { color: var(--secondary); font-size: 20rpx; }
