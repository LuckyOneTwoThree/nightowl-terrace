.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; box-sizing: border-box; }

.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; }
.tb-title { font-size: 40rpx; font-weight: 700; color: var(--on-surface); }
.season-btn { transition: transform .15s ease; }
.season-btn:active { transform: scale(0.96); }

/* 2x2 Bento 玩法卡 (CSS Grid 确保双列对齐) */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 36rpx;
  width: 100%;
}
.pcard {
  position: relative; overflow: hidden;
  height: 250rpx; padding: 24rpx; box-sizing: border-box;
  background: var(--sc-low); border-radius: var(--r-xl);
  border: 1rpx solid var(--hairline);
  display: flex; flex-direction: column; justify-content: space-between;
  transition: transform .15s ease, border-color .15s ease;
}
.pcard:active { transform: scale(0.98); background: var(--sc-high); }

.orb {
  position: absolute; top: -30rpx; right: -30rpx;
  width: 130rpx; height: 130rpx; border-radius: var(--r-full);
  filter: blur(32rpx); opacity: .25; pointer-events: none;
}
.c-amber .orb { background: var(--primary-container); }
.c-teal .orb { background: var(--secondary); }
.c-red .orb { background: var(--error); }
.c-violet .orb { background: #CEB5FF; }

.p-top { display: flex; justify-content: space-between; align-items: center; }
.p-icon-box {
  width: 72rpx; height: 72rpx; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
}
.c-amber .p-icon-box { background: rgba(255,178,36,.12); color: #FFB224; border: 1rpx solid rgba(255,178,36,.3); }
.c-teal .p-icon-box { background: rgba(20,224,191,.12); color: var(--secondary); border: 1rpx solid rgba(20,224,191,.3); }
.c-red .p-icon-box { background: rgba(255,180,171,.12); color: #FFB4AB; border: 1rpx solid rgba(255,180,171,.3); }
.c-violet .p-icon-box { background: rgba(206,181,255,.12); color: #CEB5FF; border: 1rpx solid rgba(206,181,255,.3); }
.p-icon-v { width: 38rpx; height: 38rpx; }
.p-arrow { width: 28rpx; height: 28rpx; }

.p-bottom { display: flex; flex-direction: column; gap: 4rpx; }
.p-name { font-size: 32rpx; font-weight: 700; color: var(--on-surface); line-height: 42rpx; }
.p-sub { font-size: 22rpx; color: var(--on-surface-variant); line-height: 30rpx; }

.sect-gap { margin: 44rpx 0 20rpx; }

/* 竞猜单 */
.guess { padding: 24rpx 28rpx; margin-bottom: 20rpx; border-radius: var(--r-xl); }
.g-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12rpx; }
.g-label { font-size: 22rpx; }
.g-badge { font-size: 20rpx; padding: 4rpx 16rpx; }

.g-vs { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0 24rpx; }
.g-side { display: flex; flex-direction: column; align-items: center; gap: 10rpx; width: 160rpx; flex-shrink: 0; }
.g-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); text-align: center; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.g-vs-center { flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0; }
.g-vs-txt { font-size: 24rpx; letter-spacing: 2rpx; }

.g-opts { display: flex; gap: 16rpx; margin-top: 8rpx; }
.g-opt {
  flex: 1; text-align: center; padding: 18rpx 0;
  border: 1rpx solid var(--outline-muted); border-radius: var(--r-full);
  color: var(--on-surface-variant); background: var(--sc-high);
  font-size: 26rpx; transition: all .15s ease;
}
.g-opt:active { background: rgba(255,178,36,.15); border-color: rgba(255,178,36,.5); color: var(--primary-container); }
.g-opt.opt-on { background: var(--primary-container); border-color: transparent; color: var(--on-primary); font-weight: 700; }

.g-sealed {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 20rpx 24rpx; border-radius: var(--r-md); font-size: 24rpx;
  border: 1rpx solid rgba(20,224,191,.25);
}
