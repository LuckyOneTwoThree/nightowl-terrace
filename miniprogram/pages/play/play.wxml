<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 顶栏（_9：互动玩法 + 赛季积分） -->
  <view class="topbar">
    <text class="tb-title hl">玩法大厅</text>
    <view class="chip chip-solid floodlight-glow">
      <view class="v-icon v-trophy text-amber"></view>
      <text class="text-amber hl">赛季积分 120</text>
    </view>
  </view>

  <!-- 2x2 Bento 玩法卡（_9：两列宫格 + 内部光晕 + 矢量图标） -->
  <view class="grid">
    <view class="pcard {{item.colorClass}}" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="onCard">
      <view class="orb"></view>
      <view class="p-top">
        <view class="p-icon-box">
          <view class="v-icon {{item.iconClass}} p-icon-v"></view>
        </view>
        <view class="v-icon v-chev text-muted p-arrow"></view>
      </view>
      <view class="p-bottom">
        <text class="p-name hl">{{item.name}}</text>
        <text class="p-sub mono">{{item.sub}}</text>
      </view>
    </view>
  </view>

  <!-- 本周竞猜单（_9：盲评猜球 · commit-reveal） -->
  <view class="sect sect-gap">
    <text class="sect-title">本周竞猜单</text>
    <view class="sect-line"></view>
    <text class="sect-more" bindtap="goRecords">我的记录 ›</text>
  </view>
  
  <view class="guess card-low" wx:for="{{guesses}}" wx:key="id">
    <view class="g-head">
      <text class="mono muted g-label">{{item.label}}</text>
      <view class="chip chip-teal g-badge" wx:if="{{item.pick}}">
        <view class="v-icon v-check text-teal"></view>
        <text>已封存</text>
      </view>
    </view>

    <view class="g-vs" data-id="{{item.id}}" bindtap="goDetail">
      <view class="g-side">
        <image class="crest-md" src="{{item.home.logo}}" mode="aspectFill" /><view class="circle-md crest-fb" wx:if="{{!item.home.logo}}" style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
        <text class="g-name hl">{{item.home.zh}}</text>
      </view>
      <view class="g-vs-center">
        <text class="mono muted g-vs-txt">VS</text>
      </view>
      <view class="g-side">
        <image class="crest-md" src="{{item.away.logo}}" mode="aspectFill" /><view class="circle-md crest-fb" wx:if="{{!item.away.logo}}" style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
        <text class="g-name hl">{{item.away.zh}}</text>
      </view>
    </view>

    <!-- 1X2 预测胶囊 -->
    <view class="g-opts" wx:if="{{!item.pick}}">
      <view
        class="g-opt {{item.pick === op.key ? 'opt-on floodlight-glow' : ''}}"
        wx:for="{{options}}" wx:for-item="op" wx:key="key"
        data-id="{{item.id}}" data-key="{{op.key}}" catchtap="onPick">
        <text class="mono hl">{{op.zh}}</text>
      </view>
    </view>
    <view class="g-sealed card-high" wx:else>
      <view class="v-icon v-bolt text-teal"></view>
      <text class="mono text-teal">选择已上锁 · 终场哨响自动开箱结算</text>
    </view>
  </view>

  <!-- 本周排行榜（_9 榜单行预览） -->
  <view class="sect sect-gap">
    <text class="sect-title">夜猫封神榜</text>
    <view class="sect-line"></view>
    <text class="sect-more" data-id="owl" bindtap="onCard">完整榜单 ›</text>
  </view>

  <view class="rank-card card-low">
    <view class="rank-row" wx:for="{{rankList}}" wx:key="rank">
      <view class="rank-num rank-{{item.rank}} hl">{{item.rank}}</view>
      <view class="circle-sm rank-avatar">{{item.avatar}}</view>
      <view class="rank-info">
        <text class="rank-name hl">{{item.name}}</text>
        <text class="rank-badge mono muted">{{item.badge}}</text>
      </view>
      <text class="rank-score mono hl text-amber">{{item.score}}</text>
    </view>

    <!-- 用户高亮行 -->
    <view class="rank-row user-row card-high" wx:if="{{myRank}}">
      <view class="rank-num user-rank hl">{{myRank.rank}}</view>
      <view class="circle-sm user-avatar">
        <view class="v-icon v-paw text-secondary" style="width: 24rpx; height: 24rpx;"></view>
      </view>
      <view class="rank-info">
        <text class="rank-name hl text-secondary">{{myRank.name}} (我)</text>
        <text class="rank-badge mono muted">本周稳健</text>
      </view>
      <text class="rank-score mono hl text-secondary">{{myRank.score}}</text>
    </view>
  </view>
</view>


