.page {
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  min-height: 100vh; position: relative; overflow-x: hidden;
  box-sizing: border-box;
}

/* 光晕 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.08); }
.glow-teal { bottom: -200rpx; left: -200rpx; background: rgba(68,226,205,.06); }

/* 头部卡 */
.head-card {
  position: relative; z-index: 1;
  padding: 28rpx 32rpx; border-radius: var(--r-xl);
  margin-bottom: 28rpx; border: 1rpx solid var(--hairline);
}
.hc-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 12rpx; }
.hc-icon { width: 36rpx; height: 36rpx; }
.hc-title { font-size: 34rpx; color: var(--on-surface); }
.hc-sub { font-size: 22rpx; line-height: 34rpx; }

/* 折叠列表 */
.accordion-list { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 20rpx; }

.accordion-group {
  border-radius: var(--r-xl); border: 1rpx solid var(--hairline);
  overflow: hidden; transition: border-color .2s ease;
}
.accordion-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx; background: var(--sc);
  transition: background .15s ease;
}
.accordion-header:active { background: var(--sc-high); }
.ah-left { display: flex; align-items: center; gap: 14rpx; }
.ah-icon { width: 32rpx; height: 32rpx; }
.ah-title { font-size: 28rpx; color: var(--on-surface); }
.ah-badge { font-size: 20rpx; padding: 4rpx 16rpx; }
.ah-right { display: flex; align-items: center; gap: 14rpx; }
.ah-total { font-size: 22rpx; }
.accordion-arrow {
  font-size: 30rpx; color: var(--primary-container);
  transition: transform .25s cubic-bezier(0.16, 1, 0.3, 1);
}
.accordion-arrow.expanded {
  transform: rotate(180deg);
}

.accordion-body {
  padding: 24rpx 24rpx 28rpx; background: var(--sc-low);
  border-top: 1rpx solid var(--outline-muted);
}
.teams-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

.t-chip {
  display: inline-flex; align-items: center; gap: 12rpx;
  padding: 12rpx 24rpx 12rpx 12rpx; border-radius: var(--r-full);
  border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); transition: all .15s ease;
}
.t-chip.on {
  border-color: rgba(255,178,36,.6); background: rgba(255,178,36,.12);
  color: var(--primary-container);
}
.t-ava { font-size: 18rpx; flex-shrink: 0; }
.t-name { font-size: 26rpx; }
.t-check { width: 26rpx; height: 26rpx; }

/* 底部固定保存栏 */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  border-top: 1rpx solid var(--outline-muted);
}
.bar-content {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.count-col { display: flex; flex-direction: column; gap: 4rpx; }
.count-lbl { font-size: 22rpx; }
.count-val { font-size: 32rpx; }
.count-val .n { font-size: 40rpx; font-weight: 700; margin-right: 4rpx; }

.save-btn {
  display: flex !important; align-items: center; justify-content: center; gap: 14rpx;
  width: auto !important; min-width: 360rpx; height: 92rpx; line-height: 92rpx;
  padding: 0 44rpx !important; border-radius: var(--r-xl);
  white-space: nowrap !important; box-sizing: border-box; margin: 0 !important;
}
.save-ic { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.save-txt { font-size: 30rpx; font-weight: 700; white-space: nowrap; }

