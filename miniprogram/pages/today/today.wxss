.page { padding: 0 0 56rpx; min-height: 100vh; }

/* 顶栏 */
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 32rpx 20rpx;
  position: sticky; top: 0; z-index: 40;
  background: var(--bg);
  border-bottom: 1rpx solid var(--outline-muted);
}
.tb-left { display: flex; align-items: center; gap: 16rpx; }
.paw-icon { width: 44rpx; height: 44rpx; }
.paw-s { width: 30rpx; height: 30rpx; opacity: .9; margin-top: 4rpx; }
.cal-icon { width: 36rpx; height: 36rpx; color: var(--on-surface-variant); }
.tb-col { display: flex; flex-direction: column; }
.tb-title { font-family: var(--font-headline); font-size: 38rpx; font-weight: 700; line-height: 46rpx; color: var(--on-surface); }
.tb-btn {
  width: 72rpx; height: 72rpx; border-radius: var(--r-full);
  background: var(--sc-low); display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--outline-muted);
}
.tb-btn:active { background: var(--sc-high); }
.upper { text-transform: uppercase; letter-spacing: 2rpx; font-size: 22rpx; }
.wide { letter-spacing: 6rpx; }

/* Hero（_5） */
.hero { position: relative; margin: 24rpx 32rpx; padding: 32rpx; overflow: hidden; border-radius: var(--r-xl); border: 1rpx solid var(--sc-variant); }
.accent-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--secondary); }
.hero-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; padding-left: 12rpx; }
.hh-left { display: flex; align-items: center; gap: 16rpx; }
.stars-row { display: flex; align-items: center; gap: 4rpx; }
.star-on { color: var(--primary-container); font-size: 28rpx; }
.focal { display: flex; align-items: center; gap: 10rpx; color: var(--secondary); font-size: 22rpx; font-weight: 600; }

.vs { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 36rpx; }
.side { width: 160rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.side-name { font-size: 28rpx; font-weight: 600; text-align: center; color: var(--on-surface); max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mid { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 0 8rpx; }
.score-m { color: var(--on-surface); font-size: 56rpx; line-height: 56rpx; letter-spacing: -1rpx; white-space: nowrap; }
.cd-pill {
  background: rgba(255,178,36,.12);
  border: 1rpx solid rgba(255,178,36,.4);
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
  white-space: nowrap; max-width: 100%; box-sizing: border-box;
  display: inline-flex; align-items: center; justify-content: center;
}
.cd { color: var(--primary-container); font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.cd-sub { font-size: 22rpx; margin-top: 2rpx; white-space: nowrap; }

.bullets { background: var(--sc-low); border: 1rpx solid var(--outline-muted); border-radius: var(--r-md); padding: 22rpx 26rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.bullet { display: flex; align-items: flex-start; gap: 14rpx; }
.b-dot { width: 8rpx; height: 8rpx; border-radius: var(--r-full); background: var(--outline-variant); margin-top: 14rpx; flex-shrink: 0; }
.b-text { font-family: var(--font-body); font-size: 24rpx; line-height: 36rpx; color: var(--on-surface-variant); }

.hero-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }

/* 絮语条 */
.quote {
  display: flex; align-items: flex-start; gap: 16rpx;
  margin: 24rpx 32rpx; padding: 22rpx 26rpx;
  border-left: 6rpx solid var(--primary-container);
}
.quote-text { font-size: 26rpx; font-style: italic; color: var(--on-surface-variant); line-height: 38rpx; }
.quote-strong { font-style: normal; font-weight: 700; color: var(--on-surface); margin-right: 8rpx; }

.cta { margin: 0 32rpx; width: calc(100% - 64rpx); }

.sect-gap { margin: 48rpx 32rpx 20rpx; }

/* 今日加餐：双列 Grid */
.extra-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; padding: 0 32rpx; box-sizing: border-box; }
.extra { width: 100%; padding: 22rpx; box-sizing: border-box; margin: 0; transition: transform .15s ease; }
.extra:active { transform: scale(0.98); background: var(--sc); }
.extra-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 22rpx; }
.t-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.t-name { font-size: 26rpx; font-weight: 600; }
.dim2 { color: var(--on-surface-variant); font-weight: 400; }
.extra-foot { margin-top: 12rpx; font-size: 22rpx; border-top: 1rpx solid var(--outline-muted); padding-top: 8rpx; }

/* 无球态（_3） */
.empty { margin: 24rpx 32rpx; padding: 52rpx 36rpx; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; overflow: hidden; }
.empty-glow { position: absolute; top: -60rpx; right: -60rpx; width: 200rpx; height: 200rpx; background: radial-gradient(circle, rgba(255,178,36,.12) 0%, transparent 70%); border-radius: var(--r-full); pointer-events: none; }
.empty-title { margin: 12rpx 0; color: var(--on-surface); font-weight: 700; }
.empty-sub { color: var(--on-surface-variant); font-size: 26rpx; margin-bottom: 36rpx; }
.next-box { width: 100%; background: var(--sc); border: 1rpx solid var(--line-strong); border-radius: var(--r-lg); padding: 28rpx; }
.next-label { color: var(--primary); display: block; margin-bottom: 12rpx; font-size: 22rpx; }
.next-count { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; color: var(--primary-container); }
.next-unit { font-size: 24rpx; opacity: .7; margin-left: 6rpx; color: var(--primary); font-family: var(--font-body); }
.next-match { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid var(--hairline); }
.next-pair { font-weight: 600; font-size: 28rpx; }

/* 补番卡 */
.replay { margin: 0 32rpx 20rpx; padding: 24rpx 28rpx; }
.rp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.rp-chip { padding: 4rpx 16rpx; font-size: 20rpx; }
.rp-pair { display: block; font-size: 30rpx; font-weight: 700; margin: 8rpx 0 6rpx; }
.rp-teaser { color: var(--on-surface-variant); font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rp-teams { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.rp-name { font-size: 30rpx; font-weight: 700; }
.rp-crests { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.rp-crests .vs-txt { margin: 0 4rpx; }

/* 明日预告条 */
.tmr { display: flex; align-items: center; margin: 0 32rpx 16rpx; padding: 22rpx 26rpx; background: var(--sc-lowest); border: 1rpx solid var(--outline-muted); }
.tmr-time { display: flex; flex-direction: column; align-items: center; min-width: 96rpx; }
.tmr-hm { font-family: var(--font-headline); font-size: 36rpx; font-weight: 700; line-height: 1; margin-top: 6rpx; color: var(--on-surface); }
.tmr-div { width: 2rpx; height: 56rpx; background: var(--sc-high); margin: 0 28rpx; }
.tmr-teams { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.vs-txt { font-size: 20rpx; }

/* 故事线玻璃卡 */
.stories { white-space: nowrap; padding: 0 32rpx 24rpx; box-sizing: border-box; width: 100%; }
.story {
  display: inline-flex; flex-direction: column; justify-content: space-between;
  width: 440rpx; height: 260rpx; padding: 24rpx; margin-right: 20rpx;
  border-radius: var(--r-xl); vertical-align: top; white-space: normal;
  position: relative; overflow: hidden;
}
.st-top { display: flex; justify-content: space-between; align-items: center; }
.st-ep { color: var(--secondary); font-size: 22rpx; font-weight: 600; }
.st-pill { background: rgba(68,226,205,.12); color: var(--secondary); border: 1rpx solid rgba(68,226,205,.3); font-size: 20rpx; padding: 2rpx 12rpx; border-radius: var(--r-full); }
.st-name { font-size: 30rpx; font-weight: 700; line-height: 42rpx; color: var(--on-surface); }
.st-desc { color: var(--on-surface-variant); font-size: 22rpx; line-height: 32rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
