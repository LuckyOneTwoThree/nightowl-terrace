.page { padding: 0 0 48rpx; }

/* 顶栏 */
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 32rpx 20rpx;
}
.tb-left { display: flex; align-items: center; gap: 16rpx; }
.paw { font-size: 40rpx; }
.paw-s { font-size: 30rpx; opacity: .8; }
.tb-col { display: flex; flex-direction: column; }
.tb-title { font-family: var(--font-headline); font-size: 40rpx; font-weight: 600; line-height: 48rpx; }
.tb-btn {
  width: 72rpx; height: 72rpx; border-radius: var(--r-full);
  background: var(--sc-low); display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
}
.upper { text-transform: uppercase; letter-spacing: 2rpx; }
.wide { letter-spacing: 6rpx; }

/* Hero（_5） */
.hero { position: relative; margin: 16rpx 32rpx; padding: 32rpx; overflow: hidden; }
.accent-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; background: var(--secondary); }
.hero-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; padding-left: 16rpx; }
.hh-left { display: flex; align-items: center; gap: 16rpx; }
.stars { color: var(--primary-container); font-size: 28rpx; letter-spacing: 4rpx; }
.focal { display: flex; align-items: center; gap: 8rpx; color: var(--secondary); }
.dot-teal { width: 12rpx; height: 12rpx; border-radius: var(--r-full); background: var(--secondary); }

.vs { display: flex; align-items: center; padding: 0 16rpx 40rpx; }
.side { width: 33%; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.side-name { font-size: 28rpx; }
.mid { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cd { color: var(--primary-container); }
.cd-sub { font-size: 22rpx; }

.bullets { background: var(--sc-low); border-radius: var(--r-md); padding: 24rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; gap: 12rpx; }
.bullet { display: flex; align-items: center; gap: 16rpx; }
.b-dot { width: 6rpx; height: 6rpx; border-radius: var(--r-full); background: var(--outline-variant); flex-shrink: 0; }

.hero-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }

/* 絮语条 */
.quote {
  display: flex; align-items: center; gap: 20rpx;
  margin: 24rpx 32rpx; padding: 24rpx;
  border-left: 4rpx solid var(--primary-container);
}
.quote-text { font-size: 26rpx; font-style: italic; color: var(--on-surface-variant); }
.quote-strong { font-style: normal; font-weight: 700; color: var(--on-surface); margin-right: 8rpx; }

.cta { margin: 0 32rpx; }

.sect-gap { margin: 48rpx 32rpx 24rpx; }

/* 今日加餐：双列 */
.extra-grid { display: flex; flex-wrap: wrap; gap: 24rpx; padding: 0 32rpx; }
.extra { width: calc(50% - 12rpx); padding: 24rpx; box-sizing: border-box; margin: 0; }
.extra-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.t-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.t-name { font-size: 28rpx; font-weight: 500; }
.dim2 { color: var(--on-surface-variant); }
.extra-foot { margin-top: 8rpx; color: var(--on-surface-variant); font-size: 20rpx; }

/* 无球态（_3） */
.empty { margin: 16rpx 32rpx; padding: 48rpx 40rpx; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; overflow: hidden; }
.empty-title { margin: 8rpx 0; }
.empty-sub { color: var(--on-surface-variant); font-size: 28rpx; margin-bottom: 40rpx; }
.next-box { width: 100%; background: rgba(28,32,37,.8); border: 1rpx solid rgba(81,69,51,.3); border-radius: var(--r-md); padding: 24rpx; }
.next-label { color: var(--primary); display: block; margin-bottom: 8rpx; }
.next-count { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; color: var(--primary-container); }
.next-unit { font-size: 24rpx; opacity: .7; margin-left: 8rpx; }
.next-match { display: flex; justify-content: space-between; margin-top: 24rpx; padding-top: 12rpx; border-top: 1rpx solid rgba(81,69,51,.2); font-size: 28rpx; }

/* 补番卡 */
.replay { margin: 0 32rpx 24rpx; padding: 24rpx; }
.rp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.rp-chip { padding: 4rpx 16rpx; font-size: 20rpx; }
.rp-pair { display: block; font-size: 32rpx; font-weight: 600; margin: 8rpx 0; }
.rp-teaser { color: var(--on-surface-variant); font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 明日预告条 */
.tmr { display: flex; align-items: center; margin: 0 32rpx 16rpx; padding: 24rpx; background: var(--sc-lowest); }
.tmr-time { display: flex; flex-direction: column; align-items: center; min-width: 100rpx; }
.tmr-hm { font-family: var(--font-headline); font-size: 40rpx; font-weight: 600; line-height: 1; margin-top: 8rpx; }
.tmr-div { width: 2rpx; height: 64rpx; background: var(--sc-highest); margin: 0 32rpx; }
.tmr-teams { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.vs-txt { font-size: 20rpx; }

/* 故事线玻璃卡 */
.stories { white-space: nowrap; padding: 0 32rpx 16rpx; box-sizing: border-box; width: 100%; }
.story {
  display: inline-flex; flex-direction: column; justify-content: flex-end; gap: 8rpx;
  width: 400rpx; height: 256rpx; padding: 24rpx; margin-right: 24rpx;
  border-radius: var(--r-xl); vertical-align: top; white-space: normal;
  position: relative; overflow: hidden;
}
.st-ep { color: var(--secondary); }
.st-name { font-size: 30rpx; font-weight: 700; line-height: 40rpx; }
.st-desc { color: var(--on-surface-variant); font-size: 22rpx; line-height: 32rpx; }
