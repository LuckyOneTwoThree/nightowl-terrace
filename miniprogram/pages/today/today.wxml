<view class="page">
  <view class="top-bar">
    <view>
      <view class="title">今晚哪场值得熬</view>
      <view class="date">{{dateText}}</view>
    </view>
    <view class="logo">夜猫看台</view>
  </view>

  <!-- 有球态 -->
  <block wx:if="{{hasMatch && hero}}">
    <view class="hero card">
      <view class="hero-top">
        <view class="chip lg-{{hero.lg}}">{{hero.lgZh}}{{hero.rivalry ? ' · ' + hero.rivalry : ''}}</view>
        <view class="stars">{{hero.stars}}</view>
      </view>

      <view class="vs">
        <view class="side">
          <view class="team-dot" style="background:{{hero.home.color}}">{{hero.home.id}}</view>
          <view class="name">{{hero.home.zh}}</view>
        </view>
        <view class="mid">
          <view class="cd mono" wx:if="{{hero.st === 'sched'}}">{{countdownText}}</view>
          <view class="cd mono" wx:elif="{{hero.st === 'done'}}">已赛 · {{hero.sc || '比分补录中'}}</view>
          <view class="time mono">{{hero.timeText}}</view>
          <view class="chip" wx:if="{{hero.tbd}}">时间待定</view>
        </view>
        <view class="side">
          <view class="team-dot" style="background:{{hero.away.color}}">{{hero.away.id}}</view>
          <view class="name">{{hero.away.zh}}</view>
        </view>
      </view>

      <view class="meta">
        <view class="owl-badge">夜猫指数 {{hero.indexText}}</view>
        <view class="chip">{{hero.tier}} {{hero.tierZh}} · {{hero.cost}}h</view>
        <view class="chip" wx:for="{{hero.storyNames}}" wx:key="*this">追剧中：{{item}}</view>
      </view>

      <view class="points" wx:if="{{hero.points.length}}">
        <view class="point" wx:for="{{hero.points}}" wx:key="*this">· {{item}}</view>
      </view>

      <view class="quip">“{{quip}}”</view>

      <view class="btn-primary" bindtap="onPoster">生成观赛海报</view>
    </view>

    <!-- 今日加餐 -->
    <view class="section-title" wx:if="{{extras.length}}">今日加餐<text class="section-sub">★★ 以上</text></view>
    <view class="card-2 mini" wx:for="{{extras}}" wx:key="id">
      <view class="row">
        <view class="chip lg-{{item.lg}}">{{item.lgZh}}</view>
        <text class="pair">{{item.home.zh}} v {{item.away.zh}}</text>
        <view class="stars">{{item.stars}}</view>
      </view>
      <view class="row sub">
        <text class="mono time-s">{{item.timeText}}</text>
        <view class="owl-badge sm">指数 {{item.indexText}}</view>
      </view>
    </view>
  </block>

  <!-- 无球态 -->
  <block wx:else>
    <view class="hero card empty">
      <view class="empty-title">今晚没有球</view>
      <view class="empty-sub">夜猫也是要睡觉的。下一场焦点战：</view>
      <view class="btn-ghost" style="margin-top: 32rpx;" bindtap="onPoster">查看本周安排</view>
    </view>
    <view class="section-title">补番推荐<text class="section-sub">本季已赛高分场次</text></view>
    <view class="card-2 mini" wx:for="{{replays}}" wx:key="id">
      <view class="row">
        <text class="pair">{{item.pair}}</text>
        <view class="stars">{{item.star}}★</view>
      </view>
    </view>
  </block>

  <!-- 明日预告 -->
  <view class="section-title" wx:if="{{tomorrow.length}}">明日预告<text class="section-sub">提前安排</text></view>
  <view class="card-2 mini" wx:for="{{tomorrow}}" wx:key="id">
    <view class="row">
      <view class="chip lg-{{item.lg}}">{{item.lgZh}}</view>
      <text class="pair">{{item.home.zh}} v {{item.away.zh}}</text>
      <view class="stars">{{item.stars}}</view>
    </view>
    <view class="row sub"><text class="mono time-s">{{item.timeText}}</text></view>
  </view>

  <!-- 正在追的剧（真实故事线，PM 9.2） -->
  <view class="section-title">正在追的剧<text class="section-sub">全季连续剧</text></view>
  <scroll-view scroll-x class="stories" enhanced show-scrollbar="{{false}}">
    <view class="story-card" wx:for="{{stories}}" wx:key="id" data-id="{{item.id}}" bindtap="onStoryTap">
      <view class="chip chip-primary sm">{{item.type}}</view>
      <view class="story-name">{{item.name}}</view>
      <view class="story-desc">{{item.desc}}</view>
    </view>
  </scroll-view>
</view>
