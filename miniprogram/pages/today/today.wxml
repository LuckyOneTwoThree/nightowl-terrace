<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 顶栏（_5 TopAppBar：爪标 + 日期/标题 + 日历） -->
  <view class="topbar">
    <view class="tb-left">
      <view class="v-icon v-paw paw-icon text-amber"></view>
      <view class="tb-col">
        <text class="mono muted upper">{{dateLabel}}</text>
        <text class="tb-title">今晚哪场值得熬</text>
      </view>
    </view>
    <view class="tb-btn" bindtap="onCal">
      <view class="v-icon v-cal cal-icon"></view>
    </view>
  </view>

  <!-- 有球态（超级头牌看台） -->
  <block wx:if="{{hero}}">
    <view class="hero card-highest" data-id="{{hero.id}}" bindtap="goDetail">
      <view class="accent-bar"></view>
      <view class="hero-head">
        <view class="hh-left">
          <view class="lg-chip" style="background: {{hero.lgSolid}};">{{hero.lgZh}}</view>
          <view class="stars-row">
            <text class="star-on mono">{{hero.stars}}</text>
          </view>
          <view class="followed-badge mono" wx:if="{{hero.isFollowed}}">
            <text class="text-amber">🌟 主队出战</text>
          </view>
          <view class="focal mono" wx:elif="{{hero.focal}}">
            <view class="dot-teal animate-pulse"></view>
            <text>焦点战</text>
          </view>
        </view>
        <view class="poster-quick-btn" catchtap="onPoster">
          <view class="v-icon v-trophy poster-quick-icon"></view>
          <text class="mono">海报</text>
        </view>
      </view>

      <view class="vs">
        <view class="side">
          <image class="crest-xl" src="{{hero.home.logo}}" mode="aspectFit" wx:if="{{hero.home.logo}}" />
          <view class="circle-xl crest-fb" wx:else style="background: {{hero.home.bg}}; border-color: {{hero.home.bd}};">{{hero.home.id}}</view>
          <text class="side-name">{{hero.home.zh}}</text>
        </view>
        <view class="mid">
          <text class="score-m">{{hero.hm}}</text>
          <view class="cd-pill floodlight-glow">
            <text class="cd mono text-glow">{{countdownText}}</text>
          </view>
          <text class="cd-sub mono muted">{{hero.dateHeader}}</text>
          <text class="cd-sub mono muted" wx:if="{{!hero.tbd && hero.local}}">当地 {{hero.local}}</text>
        </view>
        <view class="side">
          <image class="crest-xl" src="{{hero.away.logo}}" mode="aspectFit" wx:if="{{hero.away.logo}}" />
          <view class="circle-xl crest-fb" wx:else style="background: {{hero.away.bg}}; border-color: {{hero.away.bd}};">{{hero.away.id}}</view>
          <text class="side-name">{{hero.away.zh}}</text>
        </view>
      </view>

      <!-- 核心看点与夜猫指数 -->
      <view class="hero-summary card-high">
        <view class="summary-top">
          <view class="chip chip-amber hero-roi">
            <view class="v-icon v-bolt text-amber"></view>
            <text class="hl">夜猫指数 {{hero.indexText}}</text>
            <text class="mono muted hero-cost">· {{hero.tier}} 熬{{hero.cost}}h</text>
          </view>
          <view class="chip chip-teal" wx:if="{{hero.tv}}">{{hero.tv}}</view>
        </view>

        <!-- 看点精要 -->
        <view class="bullets" wx:if="{{hero.points.length}}">
          <view class="bullet" wx:for="{{hero.points}}" wx:key="*this">
            <view class="b-dot"></view>
            <text class="b-text">{{item}}</text>
          </view>
        </view>

        <!-- 故事线联动胶囊 -->
        <view class="hero-story-row" wx:if="{{hero.storyNames && hero.storyNames.length}}">
          <view class="story-tag" wx:for="{{hero.storyNames}}" wx:key="*this"
                data-id="{{hero.storyIds[index]}}" catchtap="onStoryTap">
            <text class="mono text-teal">故事线: {{item}} ›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 絮语 / 冷知识精选条 -->
    <view class="quote card-low" wx:if="{{hero.trivia || quip}}">
      <view class="v-icon v-paw text-amber paw-s"></view>
      <text class="quote-text">
        <text class="quote-strong">{{hero.trivia ? '冷知识' : '夜猫絮语'}}:</text>“{{hero.trivia || quip}}”
      </text>
    </view>

    <!-- 今日加餐 -->
    <block wx:if="{{extras.length}}">
      <view class="sect sect-gap">
        <text class="sect-title">今日加餐</text>
        <view class="sect-line"></view>
      </view>
      <view class="extra-grid">
        <view class="extra card-low" wx:for="{{extras}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <view class="extra-head">
            <text class="mono muted">{{item.lgZh}}</text>
            <text class="mono text-amber">{{item.hm}}</text>
          </view>
          <view class="t-row">
            <text class="t-name">{{item.home.zh}}</text>
            <image class="crest-sm" src="{{item.home.logo}}" mode="aspectFit" wx:if="{{item.home.logo}}" />
            <view class="circle-sm crest-fb" wx:else style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
          </view>
          <view class="t-row">
            <text class="t-name dim2">{{item.away.zh}}</text>
            <image class="crest-sm" src="{{item.away.logo}}" mode="aspectFit" wx:if="{{item.away.logo}}" />
            <view class="circle-sm crest-fb" wx:else style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
          </view>
          <view class="extra-foot mono">
            <text class="text-amber">★{{item.star}}</text>
            <text class="muted"> · 指数 {{item.indexText}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- 无球态（_3：长草期 + 下一场焦点倒计天数） -->
  <block wx:else>
    <view class="empty card-highest">
      <view class="empty-glow"></view>
      <text class="mono muted upper wide">长草期 · 养肝周</text>
      <text class="hl hl-lg empty-title">今夜无球</text>
      <text class="empty-sub">夜猫也需要补觉，养精蓄锐。</text>
      <view class="next-box" wx:if="{{nextFocal}}" data-id="{{nextFocal.id}}" bindtap="goDetail">
        <text class="mono next-label">距下一场焦点战</text>
        <view class="next-count score-m text-glow">
          <block wx:if="{{nextFocal.cdD > 0}}">
            <text>{{nextFocal.cdD}}</text><text class="next-unit">天</text>
            <text>{{nextFocal.cdH}}</text><text class="next-unit">小时</text>
          </block>
          <block wx:else>
            <text>{{nextFocal.cdH}}</text><text class="next-unit">小时</text>
            <text>{{nextFocal.cdM}}</text><text class="next-unit">分</text>
          </block>
        </view>
        <view class="next-match">
          <text class="next-pair">{{nextFocal.home.zh}} vs {{nextFocal.away.zh}}</text>
          <text class="mono muted">{{nextFocal.week}} {{nextFocal.hm}}</text>
        </view>
      </view>
    </view>

    <view class="sect sect-gap">
      <text class="sect-title">补番推荐</text>
      <view class="sect-line"></view>
    </view>
    <view class="replay card-low" wx:for="{{replays}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="rp-head">
        <text class="mono muted">{{item.lgZh}}</text>
        <view class="chip chip-teal rp-chip">剧透已屏蔽</view>
      </view>
      <view class="rp-teams">
        <text class="rp-name">{{item.pair}}</text>
        <view class="rp-crests">
          <image class="crest-sm" src="{{item.homeLogo}}" mode="aspectFit" wx:if="{{item.homeLogo}}" />
          <view class="circle-sm crest-fb" wx:else style="background: {{item.homeBg}}; border-color: {{item.homeBd}};">{{item.homeCode}}</view>
          <text class="mono muted vs-txt">vs</text>
          <image class="crest-sm" src="{{item.awayLogo}}" mode="aspectFit" wx:if="{{item.awayLogo}}" />
          <view class="circle-sm crest-fb" wx:else style="background: {{item.awayBg}}; border-color: {{item.awayBd}};">{{item.awayCode}}</view>
        </view>
      </view>
      <text class="rp-teaser mono muted">{{item.teaser}}</text>
    </view>
  </block>

  <!-- 时间待定（tbd 场次：开球时间未公布，先占位列出，关注球队在前） -->
  <block wx:if="{{tbd.length}}">
    <view class="sect sect-gap">
      <text class="sect-title">时间待定</text>
      <view class="sect-line"></view>
    </view>
    <view class="tmr card-low" wx:for="{{tbd}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="tmr-time">
        <text class="mono muted">{{item.lgZh}}</text>
        <text class="tmr-hm">TBD</text>
      </view>
      <view class="tmr-div"></view>
      <view class="tmr-teams">
        <text class="t-name">{{item.home.zh}}</text>
        <image class="crest-sm" src="{{item.home.logo}}" mode="aspectFit" wx:if="{{item.home.logo}}" />
        <view class="circle-sm crest-fb" wx:else style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
        <text class="mono muted vs-txt">vs</text>
        <image class="crest-sm" src="{{item.away.logo}}" mode="aspectFit" wx:if="{{item.away.logo}}" />
        <view class="circle-sm crest-fb" wx:else style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
        <text class="t-name">{{item.away.zh}}</text>
      </view>
    </view>
  </block>

  <!-- 明日预告（_5 strip） -->
  <block wx:if="{{tomorrow.length}}">
    <view class="sect sect-gap">
      <text class="sect-title">明日预告</text>
      <view class="sect-line"></view>
    </view>
    <view class="tmr card-low" wx:for="{{tomorrow}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="tmr-time">
        <text class="mono muted">{{item.week}}</text>
        <text class="tmr-hm">{{item.hm}}</text>
      </view>
      <view class="tmr-div"></view>
      <view class="tmr-teams">
        <text class="t-name">{{item.home.zh}}</text>
        <image class="crest-sm" src="{{item.home.logo}}" mode="aspectFit" wx:if="{{item.home.logo}}" />
        <view class="circle-sm crest-fb" wx:else style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
        <text class="mono muted vs-txt">vs</text>
        <image class="crest-sm" src="{{item.away.logo}}" mode="aspectFit" wx:if="{{item.away.logo}}" />
        <view class="circle-sm crest-fb" wx:else style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
        <text class="t-name">{{item.away.zh}}</text>
      </view>
    </view>
  </block>

  <!-- 正在追的剧（_5 glass cards） -->
  <view class="sect sect-gap">
    <text class="sect-title">正在追的剧</text>
    <view class="sect-line"></view>
    <text class="sect-more" bindtap="goAllStories">全季连载 ›</text>
  </view>
  <scroll-view scroll-x class="stories" enhanced show-scrollbar="{{false}}">
    <view class="story glass-panel" wx:for="{{stories}}" wx:key="id" data-id="{{item.id}}" bindtap="onStoryTap">
      <view class="st-top">
        <text class="mono st-ep">{{item.ep}}</text>
        <view class="st-pill">{{item.typeZh}}</view>
      </view>
      <text class="st-name">{{item.name}}</text>
      <text class="st-desc">{{item.desc}}</text>
    </view>
  </scroll-view>
</view>

