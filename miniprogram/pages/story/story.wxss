.page { padding: 24rpx 32rpx 160rpx; min-height: 100vh; box-sizing: border-box; }

/* 动态微光 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-teal { top: -200rpx; right: -200rpx; background: rgba(20,224,191,.08); }

/* hero */
.hero {
  position: relative; z-index: 1; overflow: hidden; border-radius: var(--r-xl, 28rpx); padding: 32rpx;
  background: linear-gradient(160deg, rgba(20,224,191,.09), transparent 55%), var(--sc-low);
  border: 1rpx solid rgba(20,224,191,.3);
}
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.ht-left { display: flex; flex-direction: column; gap: 8rpx; }
.story-title { font-size: 38rpx; font-weight: 800; color: var(--on-surface); line-height: 50rpx; }
.st-active { border-color: rgba(20,224,191,.4); color: var(--secondary); }
.st-done, .st-draft { border-color: var(--outline-muted); color: var(--on-surface-variant); }

.hero-mid { display: flex; align-items: center; gap: 12rpx; margin-top: 4rpx; }
.ava-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.ava-img { width: 72rpx; height: 72rpx; }
.ava { width: 72rpx; height: 72rpx; font-size: 24rpx; }
.hero-desc { display: block; margin-top: 20rpx; color: var(--on-surface-variant); font-size: 26rpx; line-height: 40rpx; }

.sect-gap { margin: 44rpx 0 24rpx; }

/* 时间轴 */
.timeline { position: relative; z-index: 1; padding-left: 8rpx; }
.tl-line {
  position: absolute; left: 62rpx; top: 28rpx; bottom: 28rpx; width: 4rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--secondary) 0%, rgba(0, 229, 190, 0.4) 40%, rgba(255, 255, 255, 0.12) 100%);
  z-index: 1;
}
.node { position: relative; display: flex; gap: 24rpx; margin-bottom: 36rpx; z-index: 2; }
.n-date {
  position: relative; width: 124rpx; height: 124rpx; flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--sc);
  border: 3rpx solid var(--outline-muted);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx;
  z-index: 3;
  box-sizing: border-box;
}

/* 焦点大战 */
.n-date.key {
  background: #122830;
  border-color: var(--secondary);
  box-shadow: 0 0 20rpx rgba(0, 229, 190, 0.25);
}
/* 即将开球 */
.n-date.soon {
  background: #242014;
  border-color: var(--primary-container);
  box-shadow: 0 0 20rpx rgba(255, 184, 0, 0.25);
}
/* 已完赛 */
.n-date.done {
  background: var(--sc-high);
  border-color: rgba(0, 229, 190, 0.4);
}
/* 远期未赛 */
.n-date.future {
  background: var(--sc-low);
  border-color: var(--hairline);
}
.n-date.future .n-mon,
.n-date.future .n-day {
  opacity: .45;
}

.n-mon { font-size: 20rpx; color: var(--on-surface-variant); }
.n-day { font-size: 32rpx; font-weight: 700; color: var(--on-surface); }
.n-icon { position: absolute; right: 0; bottom: 0; width: 32rpx; height: 32rpx; }

/* 浅色模式专属节点配色 */
.theme-light .tl-line {
  background: linear-gradient(180deg, var(--secondary) 0%, rgba(13, 148, 136, 0.4) 40%, rgba(0, 0, 0, 0.08) 100%) !important;
}
.theme-light .n-date {
  background: #FFFFFF !important;
  border-color: rgba(0, 0, 0, 0.1) !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05) !important;
}
.theme-light .n-date.key {
  background: #ECFDF5 !important;
  border-color: #10B981 !important;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.15) !important;
}
.theme-light .n-date.soon {
  background: #FFFBEB !important;
  border-color: #F59E0B !important;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.15) !important;
}
.theme-light .n-date.done {
  background: #FFFFFF !important;
  border-color: rgba(13, 148, 136, 0.4) !important;
}
.theme-light .n-date.future {
  background: #F8FAFC !important;
  border-color: rgba(0, 0, 0, 0.06) !important;
}

.n-card {
  position: relative; flex: 1; padding: 24rpx 28rpx; border-radius: var(--r-xl, 28rpx);
  background: var(--sc-low); border: 1rpx solid var(--hairline);
}
.n-card.iskey {
  background: var(--sc-highest); border-color: rgba(20,224,191,.3);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.4); overflow: hidden;
}
.n-card.iskey::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx; background: var(--secondary); }
.n-card.dashed { border-style: dashed; }
.node.future .n-card { opacity: .6; }
.n-star { position: absolute; right: 20rpx; top: 12rpx; color: var(--primary-container); font-size: 32rpx; text-shadow: 0 0 12rpx rgba(255,178,36,.6); }
.n-head { margin-bottom: 14rpx; }
.n-tag { font-size: 22rpx; }

.n-vs { display: flex; align-items: center; justify-content: space-between; }
.nv-side { width: 140rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.nv-name { font-size: 24rpx; font-weight: 700; text-align: center; color: var(--on-surface); max-width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nv-mid { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.nv-score { font-size: 36rpx; font-weight: 700; color: var(--secondary); white-space: nowrap; }
.nv-time { font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.nv-status { font-size: 20rpx; }
.tl-end { padding: 32rpx 24rpx; text-align: center; font-size: 24rpx; border-radius: var(--r-xl, 28rpx); border: 1rpx solid var(--hairline); }

/* 相关故事线 */
.rel-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.rel { width: 100%; box-sizing: border-box; padding: 24rpx; display: flex; flex-direction: column; gap: 8rpx; border-radius: var(--r-xl, 28rpx); border: 1rpx solid var(--hairline); }
.rel-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.rel-desc { color: var(--on-surface-variant); font-size: 22rpx; line-height: 32rpx; }

/* FAB */
.fab {
  position: fixed; right: 36rpx; bottom: 80rpx; z-index: 40;
  width: 108rpx; height: 108rpx; border-radius: var(--r-full);
  background: var(--primary-container);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.4), 0 0 24rpx rgba(255,178,36,.4);
}
