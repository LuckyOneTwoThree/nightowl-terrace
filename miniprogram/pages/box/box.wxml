<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 筛选药丸（_14） -->
  <scroll-view class="pills" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="bpill {{item.on ? 'on floodlight-glow' : ''}}" wx:for="{{pills}}" wx:key="key"
          data-i="{{index}}" bindtap="toggle">{{item.label}}</view>
  </scroll-view>

  <!-- 来源提示：今晚无赛事时提示抽选自近期焦点 -->
  <view class="pool-tag mono muted" wx:if="{{front && !front.isTonight}}">
    <view class="v-icon v-cal text-amber"></view>
    <text>今晚暂无赛事 · 已为你抽选近期焦点战</text>
  </view>

  <!-- 3D 翻转神秘卡片（_14） -->
  <view class="mystery-wrap {{shuffling ? 'shuffling' : ''}}" bindtap="flip" wx:if="{{front}}">
    <view class="flip-inner {{revealed ? 'flipped' : ''}}">
      <!-- 正面：盲盒特征 -->
      <view class="face face-front glass-panel">
        <view class="face-glow"></view>
        <view class="cost-chip card-high">
          <view class="v-icon v-moon text-amber"></view>
          <text class="mono text-amber">-{{front.cost}}h 睡眠成本</text>
        </view>
        
        <view class="qq-row">
          <view class="q-circle text-amber hl">?</view>
          <text class="q-vs mono muted">VS</text>
          <view class="q-circle text-teal hl">?</view>
        </view>
        
        <view class="tags">
          <view class="chip chip-ghost" wx:for="{{front.tags}}" wx:key="*this">{{item}}</view>
        </view>
        
        <view class="stars-row">
          <text class="s-on text-amber">{{front.stars}}</text>
          <text class="mono muted s-txt">起评</text>
        </view>
        
        <view class="tap-hint mono muted animate-pulse">
          <text>点击卡片或下方按钮揭晓</text>
          <view class="v-icon v-chev"></view>
        </view>
      </view>

      <!-- 反面：揭晓对阵 -->
      <view class="face face-back">
        <view class="bb-strip">
          <text class="mono lg-chip" style="background: {{back.lgSolid || 'var(--sc-high)'}};">{{back.lgZh || back.lgEn}}</text>
          <text class="s-on text-amber">{{back.stars}}</text>
        </view>
        <view class="bb-date">
          <text class="hl match-time">周{{back.wd}} {{back.hm}}</text>
          <text class="mono muted bb-md">{{back.md}}</text>
        </view>
        <view class="bb-vs">
          <view class="bb-side">
            <image class="crest-xl" src="{{back.home.logo}}" mode="aspectFill" wx:if="{{back.home.logo}}" />
            <view class="circle-xl crest-fb" wx:else style="background: {{back.home.bg}}; border-color: {{back.home.bd}};">{{back.home.id}}</view>
            <text class="bb-name hl">{{back.home.zh}}</text>
          </view>
          <text class="bb-x score-m text-glow">-</text>
          <view class="bb-side">
            <image class="crest-xl" src="{{back.away.logo}}" mode="aspectFill" wx:if="{{back.away.logo}}" />
            <view class="circle-xl crest-fb" wx:else style="background: {{back.away.bg}}; border-color: {{back.away.bd}};">{{back.away.id}}</view>
            <text class="bb-name hl">{{back.away.zh}}</text>
          </view>
        </view>
        <view class="bb-foot chip chip-amber">
          <view class="v-icon v-bolt text-amber"></view>
          <text class="mono">夜猫指数 {{back.indexText}} · {{back.tierLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="mystery emptybox card-low" wx:else>
    <text class="mono muted empty-tip">当前筛选条件下暂无比赛</text>
    <view class="bpill on floodlight-glow" bindtap="resetPills">清除筛选再抽</view>
  </view>

  <!-- 操作区 -->
  <view class="acts" wx:if="{{front}}">
    <!-- 正面未揭晓：主行为【翻开盲盒】，辅助操作【换个特征】 -->
    <block wx:if="{{!revealed}}">
      <button class="btn-amber act-main-btn floodlight-glow" bindtap="openBox">
        <view class="v-icon v-bolt"></view>
        <text>揭晓对阵 · 翻开盲盒</text>
      </button>
      <view class="duo-btn-single">
        <button class="sub-btn ghost-btn feat-btn" bindtap="redraw">
          <view class="v-icon v-gift"></view>
          <text>换个特征抽</text>
        </button>
      </view>
    </block>

    <!-- 反面已揭晓：主行为【查看详情】，辅助行为【换一场再抽】+【喊群友同抽】 -->
    <block wx:else>
      <button class="btn-amber act-main-btn floodlight-glow" bindtap="watchIt">
        <view class="v-icon v-trophy"></view>
        <text>就看这场 · 查看详情</text>
      </button>
      <view class="duo-btn">
        <button class="sub-btn ghost-btn" bindtap="redraw">
          <view class="v-icon v-gift"></view>
          <text>换一场再抽</text>
        </button>
        <button class="sub-btn teal-btn" bindtap="callFriends">
          <view class="v-icon v-paw text-teal"></view>
          <text>喊群友同抽</text>
        </button>
      </view>
    </block>
  </view>
</view>


