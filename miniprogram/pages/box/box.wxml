<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 筛选药丸（_14） -->
  <scroll-view class="pills" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="bpill {{item.on ? 'on floodlight-glow' : ''}}" wx:for="{{pills}}" wx:key="key"
          data-i="{{index}}" bindtap="toggle">{{item.label}}</view>
  </scroll-view>

  <!-- 3D 翻转神秘卡片（_14） -->
  <view class="mystery-wrap" bindtap="flip" wx:if="{{front}}">
    <view class="flip-inner {{revealed ? 'flipped' : ''}}">
      <!-- 正面：盲盒特征 -->
      <view class="face face-front glass-panel">
        <view class="face-glow"></view>
        <view class="cost-chip card-high">
          <view class="v-icon v-moon text-amber"></view>
          <text class="mono text-amber">-{{front.cost}}h 睡眠成本</text>
        </view>
        
        <view class="qq-row">
          <view class="q-circle text-amber hl">?</view>
          <text class="q-vs mono muted">VS</text>
          <view class="q-circle text-teal hl">?</view>
        </view>
        
        <view class="tags">
          <view class="chip chip-ghost" wx:for="{{front.tags}}" wx:key="*this">{{item}}</view>
        </view>
        
        <view class="stars-row">
          <text class="s-on text-amber" wx:for="{{front.stars}}" wx:key="*this">★</text>
          <text class="mono muted s-txt">起评</text>
        </view>
        
        <view class="tap-hint mono muted animate-pulse">
          <text>点击翻转揭晓对阵</text>
          <view class="v-icon v-chev"></view>
        </view>
      </view>

      <!-- 反面：揭晓对阵 -->
      <view class="face face-back card-highest">
        <view class="bb-strip">
          <text class="mono lg-chip" style="background: var(--sc-high);">{{back.lgEn}}</text>
          <text class="s-on text-amber">{{back.stars}}</text>
        </view>
        <view class="bb-date">
          <text class="hl hl-md match-time">周{{back.wd}} {{back.hm}}</text>
          <text class="mono muted bb-md">{{back.md}}</text>
        </view>
        <view class="bb-vs">
          <view class="bb-side">
            <image class="crest-xl" src="{{back.home.logo}}" mode="aspectFill" wx:if="{{back.home.logo}}" /><view class="circle-xl crest-fb" wx:else style="background: {{back.home.bg}}; border-color: {{back.home.bd}};">{{back.home.id}}</view>
            <text class="bb-name hl">{{back.home.zh}}</text>
          </view>
          <text class="bb-x score-m text-glow">-</text>
          <view class="bb-side">
            <image class="crest-xl" src="{{back.away.logo}}" mode="aspectFill" wx:if="{{back.away.logo}}" /><view class="circle-xl crest-fb" wx:else style="background: {{back.away.bg}}; border-color: {{back.away.bd}};">{{back.away.id}}</view>
            <text class="bb-name hl">{{back.away.zh}}</text>
          </view>
        </view>
        <view class="bb-foot chip chip-amber">
          <view class="v-icon v-bolt text-amber"></view>
          <text class="mono">夜猫指数 {{back.indexText}} · {{back.tierLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="mystery emptybox card-low" wx:else>
    <text class="mono muted">今晚没有符合条件的比赛</text>
    <view class="bpill on" bindtap="redraw">换组条件再抽</view>
  </view>

  <!-- 操作区（_14） -->
  <view class="acts">
    <block wx:if="{{!revealed}}">
      <button class="btn-amber floodlight-glow" bindtap="redraw">
        <view class="v-icon v-gift"></view>
        <text>重新抽取</text>
      </button>
    </block>
    <block wx:else>
      <button class="btn-amber floodlight-glow" bindtap="watchIt">
        <view class="v-icon v-trophy"></view>
        <text>就看这场 · 查看详情</text>
      </button>
      <view class="duo-btn">
        <button class="btn-outline ghost-btn" bindtap="redraw">再抽一次</button>
        <button class="btn-teal-ghost teal-btn" bindtap="callFriends">
          <view class="v-icon v-paw text-teal"></view>
          <text>喊群友同抽</text>
        </button>
      </view>
    </block>
  </view>
</view>

