.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; }

/* 筛选 */
.pills { display: flex; gap: 16rpx; white-space: nowrap; margin-bottom: 32rpx; }
.bpill {
  flex-shrink: 0; display: inline-flex; padding: 14rpx 32rpx; border-radius: var(--r-full);
  background: var(--sc-low); border: 1rpx solid rgba(159,142,121,.2);
  color: var(--on-surface-variant); font-size: 24rpx; transition: all .2s ease;
}
.bpill.on {
  background: rgba(255,178,36,.12); border-color: rgba(255,178,36,.5);
  color: var(--primary-container); font-weight: 700;
}

/* 神秘卡：3D 翻转容器 */
.mystery-wrap { position: relative; height: 680rpx; perspective: 1400rpx; -webkit-perspective: 1400rpx; }
.flip-inner {
  position: relative; width: 100%; height: 100%;
  transform-style: preserve-3d; -webkit-transform-style: preserve-3d;
  transition: transform .7s cubic-bezier(.4,.2,.2,1);
  will-change: transform; /* 提前合成层，避免首次翻转创建图层卡顿 */
}
.flip-inner.flipped { transform: rotateY(180deg); }
.face {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-radius: 40rpx;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  overflow: hidden;
}
.face-front {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx;
  background: var(--sc-low); border: 1rpx solid rgba(255,178,36,.25);
  position: relative;
}
.face-glow {
  position: absolute; width: 280rpx; height: 280rpx; border-radius: var(--r-full);
  background: radial-gradient(circle, rgba(255,178,36,.15), transparent 70%);
  pointer-events: none;
}
.cost-chip {
  position: absolute; left: 24rpx; top: 24rpx;
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 20rpx; border-radius: var(--r-full);
  font-size: 22rpx;
}
.qq-row { display: flex; align-items: center; gap: 40rpx; }
.q-circle {
  width: 150rpx; height: 150rpx; border-radius: var(--r-full);
  border: 3rpx dashed rgba(255,178,36,.3); background: var(--sc-high);
  display: flex; align-items: center; justify-content: center;
  font-size: 72rpx;
}
.q-vs { font-size: 36rpx; font-weight: 700; }
.tags { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: center; }
.stars-row { display: flex; align-items: center; gap: 6rpx; }
.s-on { font-size: 32rpx; }
.s-txt { font-size: 22rpx; margin-left: 8rpx; }
.tap-hint { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; margin-top: 8rpx; }

/* 反面 */
.face-back {
  transform: rotateY(180deg);
  background: var(--sc-low); border: 1rpx solid rgba(255,178,36,.3);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,.5);
  display: flex; flex-direction: column; justify-content: space-between;
  padding-bottom: 24rpx;
}
.bb-strip {
  height: 88rpx; padding: 0 28rpx; background: var(--sc-high);
  display: flex; align-items: center; justify-content: space-between;
}
.bb-date { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding-top: 16rpx; }
.match-time { font-size: 36rpx; font-weight: 700; }
.bb-vs { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 20rpx; }
.bb-side { width: 180rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.bb-name { font-size: 28rpx; color: var(--on-surface); text-align: center; max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bb-x { font-size: 40rpx; flex: 1; text-align: center; }
.bb-foot { margin: 0 28rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 22rpx; padding: 10rpx 0; }

.emptybox {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx;
  height: 680rpx; border: 1rpx dashed rgba(159,142,121,.3); border-radius: 40rpx;
}

/* 操作 */
.acts { margin-top: 40rpx; }
.duo-btn { display: flex; gap: 20rpx; margin-top: 20rpx; }
.ghost-btn { flex: 1; font-size: 28rpx; }
.teal-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 24rpx 0; border-radius: var(--r-lg); font-size: 28rpx;
  border: 1rpx solid rgba(68,226,205,.4); color: var(--secondary); background: rgba(68,226,205,.08);
}
