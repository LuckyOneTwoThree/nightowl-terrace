.page { padding: 24rpx 32rpx 48rpx; }

/* 筛选 */
.pills { display: flex; gap: 16rpx; white-space: nowrap; margin-bottom: 32rpx; }
.bpill {
  flex-shrink: 0; display: inline-flex; padding: 14rpx 32rpx; border-radius: var(--r-full);
  background: var(--sc-high); border: 1rpx solid var(--hairline);
  color: var(--on-surface-variant); font-family: var(--font-mono); font-size: 24rpx;
}
.bpill.on {
  background: rgba(255,178,36,.1); border-color: rgba(255,178,36,.4);
  color: var(--primary-container);
}

/* 神秘卡：3D 翻转 */
.mystery { position: relative; height: 640rpx; perspective: 1400rpx; }
.flip-inner {
  position: relative; width: 100%; height: 100%;
  transform-style: preserve-3d; transition: transform .7s cubic-bezier(.4,.2,.2,1);
}
.flip-inner.flipped { transform: rotateY(180deg); }
.face {
  position: absolute; inset: 0; border-radius: 48rpx;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  overflow: hidden;
}
.face-front {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32rpx;
  background:
    radial-gradient(circle at 50% 30%, rgba(255,178,36,.1), transparent 60%),
    linear-gradient(135deg, rgba(38,42,48,.9), rgba(24,28,33,.7));
  border: 1rpx solid var(--sc-highest);
}
.cost-chip {
  position: absolute; left: 24rpx; top: 24rpx;
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 20rpx; border-radius: var(--r-full);
  background: rgba(10,14,19,.8); border: 1rpx solid var(--sc-highest);
  color: var(--tertiary-container); font-size: 22rpx;
}
.qq-row { display: flex; align-items: center; gap: 48rpx; }
.q-circle {
  width: 160rpx; height: 160rpx; border-radius: var(--r-full);
  border: 3rpx dashed var(--outline-variant); background: var(--sc);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 72rpx; color: rgba(214,196,173,.5);
}
.q-vs { font-family: var(--font-mono); font-size: 40rpx; font-weight: 700; color: var(--outline-variant); }
.tags { display: flex; gap: 16rpx; }
.stars-row { display: flex; align-items: center; gap: 4rpx; }
.s-on { color: var(--primary-container); font-size: 32rpx; letter-spacing: 4rpx; }
.s-off { color: var(--outline-variant); font-size: 32rpx; letter-spacing: 4rpx; }
.s-txt { font-size: 24rpx; margin-left: 8rpx; }
.tap-hint { color: var(--outline); font-size: 22rpx; letter-spacing: 2rpx; }

/* 反面 */
.face-back {
  transform: rotateY(180deg);
  background: var(--sc-highest); border: 1rpx solid rgba(255,178,36,.2);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,.5);
  display: flex; flex-direction: column;
}
.bb-strip {
  height: 96rpx; padding: 0 32rpx; background: var(--sc-bright, #36393F);
  display: flex; align-items: center; justify-content: space-between;
  font-size: 22rpx; letter-spacing: 2rpx;
}
.bb-strip .mono { text-transform: uppercase; color: var(--on-surface-variant); }
.bb-date { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 32rpx 0 8rpx; }
.bb-md { font-size: 26rpx; }
.bb-vs { flex: 1; display: flex; align-items: center; padding: 0 24rpx; }
.bb-side { width: 38%; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.bb-side .circle-xl { border: 1rpx solid var(--sc-variant); }
.bb-name { font-weight: 700; font-size: 26rpx; }
.bb-x { flex: 1; text-align: center; color: var(--primary-container); text-shadow: 0 0 20rpx rgba(255,178,36,.4); font-style: italic; }
.bb-foot { padding: 20rpx 32rpx 28rpx; border-top: 1rpx solid var(--sc-variant); text-align: center; font-size: 24rpx; }

.emptybox {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx;
  border: 1rpx dashed var(--outline-variant); border-radius: 48rpx;
}

/* 操作 */
.acts { margin-top: 40rpx; }
.duo-btn { display: flex; gap: 24rpx; margin-top: 24rpx; }
.ghost-btn {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 28rpx 0; border-radius: var(--r-xl);
  box-shadow: inset 0 0 0 2rpx var(--outline-variant); color: var(--on-surface);
  font-family: var(--font-headline); font-size: 32rpx; font-weight: 600;
}
.teal-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 28rpx 0; border-radius: var(--r-xl);
  box-shadow: inset 0 0 0 2rpx var(--secondary); color: var(--secondary);
  font-family: var(--font-headline); font-size: 32rpx; font-weight: 600;
}
