<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 动态环境微光 -->
  <view class="glow glow-amber"></view>

  <!-- ==================== 1. 顶部战绩战报罗盘 ==================== -->
  <view class="compass-hero card-highest floodlight-glow">
    <view class="ch-head">
      <view class="v-icon v-trophy text-amber ch-ic"></view>
      <text class="hl ch-title">我的深夜战绩档案</text>
    </view>
    <view class="ch-grid">
      <view class="ch-item">
        <text class="mono muted ch-lbl">累计预言</text>
        <text class="hl ch-val">{{stats.total}}<text class="ch-unit">场</text></text>
      </view>
      <view class="ch-div"></view>
      <view class="ch-item">
        <text class="mono muted ch-lbl">历史命中率</text>
        <text class="hl ch-val text-teal">{{stats.rate}}</text>
      </view>
      <view class="ch-div"></view>
      <view class="ch-item">
        <text class="mono muted ch-lbl">斩获积分</text>
        <text class="hl ch-val text-amber">+{{stats.pts}}<text class="ch-unit">分</text></text>
      </view>
    </view>
  </view>

  <!-- ==================== 2. 分类筛选 Tab ==================== -->
  <scroll-view class="filter-pills" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="fpill {{filterTab === item.id ? 'active floodlight-glow' : ''}}"
          wx:for="{{filterTabs}}" wx:key="id" data-id="{{item.id}}" bindtap="onFilterTab">
      {{item.zh}}
    </view>
  </scroll-view>

  <!-- ==================== 3. 日期分组列表 ==================== -->
  <block wx:for="{{groups}}" wx:key="label" wx:for-item="g">
    <view class="g-title mono muted">
      <view class="g-dot-gold"></view>
      <text>{{g.label}}</text>
    </view>
    
    <view class="g-list">
      <!-- 记录行 -->
      <view class="record-row card-low" wx:for="{{g.rows}}" wx:key="key" wx:for-item="r" data-id="{{r.mid}}" bindtap="goDetail">
        <!-- 预测行 -->
        <block wx:if="{{r.type === 'pred'}}">
          <view class="r-left">
            <view class="r-top">
              <image class="crest-sm r-logo" src="{{r.logo}}" mode="aspectFill" wx:if="{{r.logo}}" />
              <view class="v-icon v-soccer text-amber r-icon" wx:else></view>
              <text class="r-name hl">{{r.names}}</text>
            </view>
            <text class="mono muted r-sub">{{r.sub}}</text>
          </view>
          
          <view class="r-right">
            <block wx:if="{{r.tampered}}">
              <text class="r-pts text-error mono">作废</text>
            </block>
            <block wx:elif="{{r.finished}}">
              <view class="r-result-box">
                <view class="v-icon v-check text-teal" wx:if="{{r.hit}}"></view>
                <view class="v-icon v-cross text-error" wx:else></view>
                <text class="r-pts hl {{r.hit ? 'text-teal text-glow' : 'muted'}} mono">{{r.hit ? '+' + r.pts : '0'}}</text>
              </view>
            </block>
            <view class="chip chip-amber mono" wx:else>封存中</view>
          </view>
        </block>

        <!-- 狂言行 -->
        <block wx:elif="{{r.type === 'boast'}}">
          <view class="boast-full">
            <view class="b-head">
              <view class="v-icon v-gavel text-amber r-icon"></view>
              <text class="r-name hl">{{r.names}}</text>
              <view class="chip {{r.finished ? (r.hit ? 'chip-teal' : 'chip-error') : 'chip-amber'}} r-chip">
                {{r.finished ? (r.hit ? '✓ 应验' : '✕ 打脸') : '待审判'}}
              </view>
            </view>
            <view class="b-quote-box card-high {{r.finished && !r.hit ? 'strike' : ''}}">
              <text class="b-quote">“{{r.sub}}”</text>
            </view>
          </view>
        </block>

        <!-- 打卡行 -->
        <block wx:else>
          <view class="r-left">
            <view class="r-top">
              <view class="v-icon v-moon text-teal r-icon"></view>
              <text class="r-name hl">{{r.names}}</text>
            </view>
            <text class="mono muted r-sub">{{r.sub}}</text>
          </view>
          <view class="r-time mono hl text-teal">+{{r.cost}}h</view>
        </block>
      </view>
    </view>
  </block>

  <!-- 空态 -->
  <view class="empty card-low" wx:if="{{empty}}">
    <view class="v-icon v-paw text-amber e-mascot"></view>
    <text class="hl hl-md empty-title">还没有深夜战绩，今晚启程？</text>
    <text class="mono muted e-desc">你的修仙日记还是一张白纸，去看看今晚有什么焦点大战吧。</text>
    <button class="btn-amber e-btn floodlight-glow" bindtap="goToday">
      <text>查看今晚赛程</text>
      <view class="v-icon v-chev"></view>
    </button>
  </view>
</view>

