.page { padding: 24rpx 32rpx 64rpx; display: flex; flex-direction: column; gap: 36rpx; min-height: 100vh; }

.g-title { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; margin-bottom: 16rpx; }
.g-dot-gold { width: 8rpx; height: 8rpx; border-radius: var(--r-full); background: var(--primary-container); }
.g-list { display: flex; flex-direction: column; gap: 16rpx; }

/* 记录行 */
.record-row { border-radius: var(--r-xl); padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.r-left { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.r-top { display: flex; align-items: center; gap: 12rpx; }
.r-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.r-logo { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.r-name { font-size: 28rpx; color: var(--on-surface); }
.r-sub { font-size: 22rpx; }

.r-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.r-result-box { display: flex; align-items: center; gap: 8rpx; }
.r-pts { font-size: 34rpx; }
.r-time {
  padding: 6rpx 20rpx; border-radius: var(--r-full);
  background: rgba(68,226,205,.08); border: 1rpx solid rgba(68,226,205,.3);
  font-size: 24rpx; flex-shrink: 0;
}

/* 狂言整行 */
.boast-full { width: 100%; display: flex; flex-direction: column; gap: 12rpx; }
.b-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.r-chip { font-size: 20rpx; padding: 2rpx 14rpx; }
.b-quote-box {
  padding: 16rpx 20rpx; border-radius: var(--r-md); border-left: 6rpx solid var(--secondary);
}
.b-quote-box.strike { border-left-color: var(--outline-muted); opacity: .7; }
.b-quote { font-style: italic; color: var(--on-surface); font-size: 24rpx; line-height: 36rpx; }
.b-quote-box.strike .b-quote { text-decoration: line-through; }

/* 空态 */
.empty { border-radius: var(--r-xl); padding: 72rpx 36rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; text-align: center; }
.e-mascot { width: 120rpx; height: 120rpx; }
.empty-title { font-size: 34rpx; color: var(--on-surface); }
.e-desc { font-size: 24rpx; line-height: 38rpx; padding: 0 16rpx; }
.e-btn { margin-top: 16rpx; }
