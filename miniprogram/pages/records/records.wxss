.page { padding: 24rpx 32rpx 80rpx; display: flex; flex-direction: column; gap: 28rpx; min-height: 100vh; box-sizing: border-box; }

/* 动态微光 */
.glow { position: fixed; width: 600rpx; height: 600rpx; border-radius: var(--r-full); filter: blur(160rpx); pointer-events: none; z-index: 0; }
.glow-amber { top: -200rpx; right: -200rpx; background: rgba(255,178,36,.08); }

/* 顶部战报罗盘 Hero */
.compass-hero {
  position: relative; z-index: 1;
  padding: 28rpx 32rpx; border-radius: var(--r-xl, 28rpx);
  border: 1rpx solid rgba(255,178,36,.3);
  background: linear-gradient(145deg, rgba(255,178,36,.09) 0%, rgba(30,41,59,.75) 50%, rgba(15,23,42,.95) 100%);
  display: flex; flex-direction: column; gap: 20rpx;
}
.ch-head { display: flex; align-items: center; gap: 12rpx; }
.ch-ic { width: 36rpx; height: 36rpx; }
.ch-title { font-size: 32rpx; font-weight: 800; color: var(--on-surface); }

.ch-grid { display: flex; align-items: center; justify-content: space-around; padding-top: 8rpx; }
.ch-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.ch-lbl { font-size: 20rpx; }
.ch-val { font-size: 36rpx; font-weight: 800; }
.ch-unit { font-size: 22rpx; margin-left: 2rpx; }
.ch-div { width: 2rpx; height: 44rpx; background: var(--sc-highest); }
.ch-footer-tip {
  font-size: 19rpx; text-align: center; border-top: 1rpx solid rgba(255,255,255,.06);
  padding-top: 12rpx; margin-top: 4rpx; letter-spacing: 0.5rpx;
}
.theme-light .ch-footer-tip { border-top-color: rgba(0,0,0,.05); }

/* 筛选药丸 */
.filter-pills {
  position: relative; z-index: 1;
  display: flex; gap: 14rpx; white-space: nowrap; margin-bottom: 8rpx;
}
.fpill {
  flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
  padding: 10rpx 28rpx; border-radius: var(--r-full);
  background: var(--sc-low); border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); font-size: 24rpx; transition: all .2s ease;
  white-space: nowrap; margin-right: 14rpx;
}
.fpill.active {
  background: var(--primary-container); border-color: transparent;
  color: var(--on-primary); font-weight: 700;
}

.g-title {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; margin-bottom: 12rpx;
}
.g-dot-gold { width: 8rpx; height: 8rpx; border-radius: var(--r-full); background: var(--primary-container); }
.g-list { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 16rpx; }

/* 记录行 */
.record-row {
  border-radius: var(--r-xl, 28rpx); padding: 24rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  border: 1rpx solid var(--hairline); transition: all .15s ease;
}
.record-row:active { background: var(--sc-high); }
.r-left { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.r-top { display: flex; align-items: center; gap: 12rpx; }
.r-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.r-logo { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.r-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); }
.r-sub { font-size: 22rpx; }

.r-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.r-result-box { display: flex; align-items: center; gap: 8rpx; }
.r-pts { font-size: 34rpx; }
.r-time {
  padding: 6rpx 20rpx; border-radius: var(--r-full);
  background: rgba(20,224,191,.08); border: 1rpx solid rgba(20,224,191,.3);
  font-size: 24rpx; flex-shrink: 0;
}

/* 狂言整行 */
.boast-full { width: 100%; display: flex; flex-direction: column; gap: 12rpx; }
.b-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.r-chip { font-size: 20rpx; padding: 2rpx 14rpx; border-radius: var(--r-full); }
.b-quote-box {
  padding: 16rpx 20rpx; border-radius: var(--r-md); border-left: 6rpx solid var(--secondary);
}
.b-quote-box.strike { border-left-color: var(--outline-muted); opacity: .7; }
.b-quote { font-style: italic; color: var(--on-surface); font-size: 24rpx; line-height: 36rpx; }
.b-quote-box.strike .b-quote { text-decoration: line-through; }

/* 空态 */
.empty {
  position: relative; z-index: 1;
  border-radius: var(--r-xl, 28rpx); padding: 72rpx 36rpx;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
  text-align: center; border: 1rpx solid var(--hairline);
}
.e-mascot { width: 120rpx; height: 120rpx; }
.empty-title { font-size: 34rpx; color: var(--on-surface); }
.e-desc { font-size: 24rpx; line-height: 38rpx; padding: 0 16rpx; }
.e-btn { margin-top: 16rpx; border-radius: var(--r-full); }
