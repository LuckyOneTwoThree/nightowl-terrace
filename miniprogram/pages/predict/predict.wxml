<view class="page">
  <!-- 截止条（_11） -->
  <view class="deadline">
    <view class="dl-left"><text class="mono">⏰ 截止 {{deadlineText}}</text></view>
    <text class="mono dl-strong">{{leftText}}</text>
  </view>

  <!-- 规则 chips -->
  <view class="rules">
    <view class="chip chip-ghost">✔ 胜平负 3 分</view>
    <view class="chip chip-ghost">＋ 比分 +2</view>
    <view class="chip chip-error">🔥 冷门翻倍</view>
  </view>

  <!-- 竞猜卡列表 -->
  <view class="cards">
    <view class="gcard card-low {{item.pick ? 'picked' : ''}}" wx:for="{{cards}}" wx:key="id">
      <view class="g-bar" style="background: {{item.lgAccent}};"></view>
      <view class="g-top">
        <text class="mono muted">{{item.md}} {{item.hm}} / {{item.lgZh}}</text>
        <text class="g-fire" wx:if="{{item.upset}}">🔥</text>
      </view>
      <view class="g-vs">
        <view class="g-side">
          <view class="circle-md" style="background: {{item.home.bg}}; border-color: {{item.home.bd}};">{{item.home.id}}</view>
          <text class="g-name">{{item.home.zh}}</text>
        </view>
        <text class="mono muted">VS</text>
        <view class="g-side">
          <view class="circle-md" style="background: {{item.away.bg}}; border-color: {{item.away.bd}};">{{item.away.id}}</view>
          <text class="g-name">{{item.away.zh}}</text>
        </view>
      </view>

      <block wx:if="{{!item.sealed}}">
        <view class="g-opts">
          <view class="g-opt {{item.pick === 'h' ? 'on' : ''}}" data-id="{{item.id}}" data-key="h" bindtap="onPick">主胜</view>
          <view class="g-opt {{item.pick === 'd' ? 'on' : ''}}" data-id="{{item.id}}" data-key="d" bindtap="onPick">平局</view>
          <view class="g-opt {{item.pick === 'a' ? 'on' : ''}}" data-id="{{item.id}}" data-key="a" bindtap="onPick">客胜</view>
        </view>
        <view class="g-score">
          <text class="mono muted">预测比分 (可选)</text>
          <view class="g-inputs">
            <input class="g-in" type="number" value="{{item.scoreH}}" data-id="{{item.id}}" data-side="h" bindinput="onScore" placeholder="-" />
            <text class="mono muted">:</text>
            <input class="g-in" type="number" value="{{item.scoreA}}" data-id="{{item.id}}" data-side="a" bindinput="onScore" placeholder="-" />
          </view>
        </view>
      </block>
      <view class="g-sealed" wx:else>🔒 已封存 · 开球后开箱</view>
    </view>
  </view>

  <view class="to-records mono" bindtap="goRecords">查看我的预测档案 ›</view>
  <view class="spacer"></view>

  <!-- 底部封存栏（_11 fixed bar） -->
  <view class="sealbar">
    <view class="sb-info">
      <text class="mono muted">已选: {{pickedCount}}/{{cards.length}} 场</text>
      <text class="mono sb-pts">潜在积分: {{potential}}</text>
    </view>
    <button class="btn-amber sb-btn" bindtap="onSeal" disabled="{{sealedAll}}">
      {{sealedAll ? '本周已封存' : '封存我的预测'}}
    </button>
  </view>
</view>
