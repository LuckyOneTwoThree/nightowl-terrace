.page { padding: 24rpx 32rpx 0; min-height: 100vh; }

.deadline {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx; border-radius: var(--r-xl);
  background: var(--sc-low); border: 1rpx solid rgba(255,178,36,.35);
}
.dl-left { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; }
.dl-strong { font-size: 32rpx; font-weight: 700; }

.rules { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0 24rpx; }

.cards { display: flex; flex-direction: column; gap: 24rpx; }
.gcard { position: relative; overflow: hidden; padding: 28rpx; border-radius: var(--r-xl); }
.gcard.picked { opacity: .96; }
.g-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }
.g-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; font-size: 22rpx; }
.upset-chip { padding: 2rpx 14rpx; font-size: 18rpx; }

.g-vs { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 28rpx; }
.g-side { display: flex; flex-direction: column; align-items: center; gap: 12rpx; width: 160rpx; flex-shrink: 0; }
.g-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); text-align: center; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.g-vs-txt { font-size: 24rpx; letter-spacing: 2rpx; flex: 1; text-align: center; }

.g-opts { display: flex; gap: 16rpx; }
.g-opt {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: var(--r-md);
  background: var(--sc-high); border: 1rpx solid rgba(159,142,121,.2);
  color: var(--on-surface-variant); font-size: 28rpx; transition: all .15s ease;
}
.g-opt:active { background: rgba(255,178,36,.12); color: var(--primary-container); }
.g-opt.on {
  background: var(--primary-container); color: var(--on-primary); font-weight: 700;
  border-color: transparent; box-shadow: 0 0 20rpx rgba(255,178,36,.35);
}

.g-score {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--r-md);
}
.score-lbl { font-size: 22rpx; }
.g-inputs { display: flex; align-items: center; gap: 12rpx; }
.g-in {
  width: 96rpx; height: 68rpx; text-align: center;
  background: var(--sc-low); border: 1rpx solid rgba(159,142,121,.25); border-radius: var(--r-sm);
  font-size: 34rpx; color: var(--primary-container);
}
.g-in:focus { border-color: var(--primary-container); }
.g-colon { font-size: 28rpx; }

.g-sealed {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 24rpx 0; border-radius: var(--r-md); font-size: 24rpx;
}

.to-records { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 36rpx 0 16rpx; font-size: 24rpx; }
.spacer { height: 260rpx; }

.sealbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(159,142,121,.2);
  z-index: 50;
}
.sb-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; font-size: 24rpx; }
.sb-pts { font-size: 24rpx; }
.sb-btn { font-size: 32rpx; }
.sb-btn[disabled] { opacity: .5; color: var(--on-primary-container); background: var(--primary-container); }
