.page { padding: 24rpx 32rpx 0; min-height: 100vh; }

/* 顶部公告面板 */
.deadline {
  display: flex; flex-direction: column; gap: 12rpx;
  padding: 24rpx 28rpx; border-radius: var(--r-xl);
  background: var(--sc-low); border: 1rpx solid rgba(255,178,36,.35);
}
.dl-main { display: flex; justify-content: space-between; align-items: center; }
.dl-left { display: flex; align-items: center; gap: 14rpx; }
.dl-title { font-size: 30rpx; font-weight: 700; }
.dl-chip { font-size: 20rpx; padding: 4rpx 16rpx; flex-shrink: 0; }
.dl-sub-row { display: flex; align-items: center; }
.dl-sub { font-size: 22rpx; color: var(--on-surface-variant); }

/* 联赛切换药丸 */
.league-pills {
  display: flex; gap: 14rpx; white-space: nowrap; margin: 20rpx 0 16rpx;
}
.lpill {
  flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
  padding: 10rpx 26rpx; border-radius: var(--r-full);
  background: var(--sc-low); border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); font-size: 24rpx; transition: all .2s ease;
  white-space: nowrap;
}
.lpill.active {
  background: var(--primary-container); border-color: transparent;
  color: var(--on-primary); font-weight: 700;
}

/* 3列自适应规则条 */
.rules { display: flex; justify-content: space-between; gap: 12rpx; margin-bottom: 24rpx; }
.rule-chip { flex: 1; min-width: 0; justify-content: center; padding: 10rpx 0; font-size: 22rpx; white-space: nowrap; }

.cards { display: flex; flex-direction: column; gap: 24rpx; }
.gcard { position: relative; overflow: hidden; padding: 28rpx; border-radius: var(--r-xl); border: 1rpx solid var(--hairline); }
.gcard.target-focused {
  border-color: rgba(255,178,36,.6) !important;
  box-shadow: 0 0 24rpx rgba(255,178,36,.25);
}
.gcard.picked { opacity: .98; border-color: rgba(255,178,36,.3); }
.g-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }
.g-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; font-size: 22rpx; }
.g-meta { display: flex; align-items: center; gap: 12rpx; }
.target-chip { font-size: 18rpx; padding: 2rpx 12rpx; }
.upset-chip { padding: 2rpx 14rpx; font-size: 18rpx; }

.g-vs { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 28rpx; }
.g-side { display: flex; flex-direction: column; align-items: center; gap: 12rpx; width: 160rpx; flex-shrink: 0; }
.g-name { font-size: 28rpx; font-weight: 700; color: var(--on-surface); text-align: center; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.g-vs-txt { font-size: 24rpx; letter-spacing: 2rpx; flex: 1; text-align: center; }

.g-opts { display: flex; gap: 16rpx; }
.g-opt {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: var(--r-md);
  background: var(--sc-high); border: 1rpx solid var(--outline-muted);
  color: var(--on-surface-variant); font-size: 28rpx; transition: all .15s ease;
}
.g-opt:active { background: rgba(255,178,36,.12); color: var(--primary-container); }
.g-opt.on {
  background: var(--primary-container); color: var(--on-primary); font-weight: 700;
  border-color: transparent; box-shadow: 0 0 20rpx rgba(255,178,36,.35);
}

.g-score {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--r-md);
}
.score-lbl { font-size: 22rpx; }
.g-inputs { display: flex; align-items: center; gap: 12rpx; }
.g-in {
  width: 96rpx; height: 68rpx; text-align: center;
  background: var(--sc-low); border: 1rpx solid var(--line-strong); border-radius: var(--r-sm);
  font-size: 34rpx; color: var(--primary-container);
}
.g-in:focus { border-color: var(--primary-container); }
.g-colon { font-size: 28rpx; }

/* 单场直接封存按钮 */
.single-seal-wrap {
  margin-top: 20rpx; display: flex; justify-content: flex-end;
}
.btn-single-seal {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 10rpx 24rpx; border-radius: var(--r-full);
  font-size: 22rpx; font-weight: 600;
  background: rgba(255,178,36,.12); color: var(--primary-container);
  border: 1rpx solid rgba(255,178,36,.4);
}
.btn-single-seal:active {
  background: rgba(255,178,36,.25);
}

.g-sealed {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 24rpx 0; border-radius: var(--r-md); font-size: 24rpx;
}

.to-records { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 36rpx 0 16rpx; font-size: 24rpx; }
.spacer { height: 260rpx; }

.sealbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--outline-muted);
  z-index: 50;
}
.sb-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; font-size: 24rpx; }
.sb-pts { font-size: 24rpx; }
.sb-btn { font-size: 32rpx; height: 90rpx; line-height: 90rpx; }
.sb-btn[disabled] { opacity: .5; color: var(--on-primary-container); background: var(--primary-container); }

