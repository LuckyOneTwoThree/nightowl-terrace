.page { padding: 24rpx 32rpx 64rpx; min-height: 100vh; }

/* 规则条 */
.rule {
  display: flex; gap: 20rpx; align-items: center; padding: 28rpx 32rpx;
  border-radius: var(--r-xl);
}
.r-ic {
  width: 80rpx; height: 80rpx; border-radius: var(--r-md);
  background: var(--sc-high); border: 1rpx solid rgba(255,178,36,.3);
  display: flex; align-items: center; justify-content: center;
}
.r-gavel { width: 44rpx; height: 44rpx; }
.r-body { display: flex; flex-direction: column; gap: 4rpx; }
.r-sub { font-size: 22rpx; }

.sect-gap { margin: 40rpx 0 20rpx; }
.sect-mt { margin: 48rpx 0 20rpx; }
.focal-badge { font-size: 20rpx; padding: 2rpx 16rpx; }

/* 开庭中卡片 */
.open-card { padding: 32rpx; border-radius: var(--r-xl); }
.open-meta { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid rgba(159,142,121,.1); }
.open-vs { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 16rpx; }
.ov-side { width: 35%; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.ov-name { font-size: 28rpx; color: var(--on-surface); text-align: center; }
.ov-mid { width: 30%; display: flex; align-items: center; justify-content: center; }
.ov-x { font-size: 32rpx; letter-spacing: 2rpx; }

.input-wrap { position: relative; margin-top: 8rpx; border-radius: var(--r-lg); }
.boast-input {
  width: 100%; padding: 24rpx 100rpx 24rpx 24rpx; font-size: 26rpx; color: var(--on-surface);
}
.input-ph { color: var(--on-surface-variant); opacity: .6; }
.input-count { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 22rpx; }
.btn-submit { margin-top: 24rpx; }

.empty { padding: 48rpx 32rpx; text-align: center; font-size: 24rpx; border-radius: var(--r-lg); }

/* 统计双卡 */
.duo { display: flex; gap: 20rpx; margin-top: 24rpx; }
.duo-card {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  padding: 28rpx 20rpx; border-radius: var(--r-xl); position: relative; overflow: hidden;
}
.teal-glow { border-top: 4rpx solid var(--secondary); }
.red-glow { border-top: 4rpx solid var(--error); }
.d-head { display: flex; align-items: center; gap: 10rpx; }
.d-icon { width: 28rpx; height: 28rpx; }
.d-title { font-size: 28rpx; color: var(--on-surface); }
.d-score { line-height: 56rpx; margin: 4rpx 0; }
.d-lbl { font-size: 22rpx; }
.d-chip { margin-top: 8rpx; font-size: 20rpx; padding: 4rpx 16rpx; }

/* 存档 */
.arch { margin-bottom: 20rpx; padding: 28rpx; border-radius: var(--r-xl); }
.a-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 22rpx; }
.a-teams { font-size: 24rpx; color: var(--on-surface); font-weight: 600; }
.a-quote {
  margin-top: 18rpx; padding: 16rpx 20rpx; border-left: 6rpx solid var(--secondary);
  background: var(--sc-high); border-radius: 0 var(--r-md) var(--r-md) 0;
}
.a-quote.strike { border-left-color: var(--outline-muted); opacity: .75; }
.a-text { font-style: italic; color: var(--on-surface); font-size: 26rpx; line-height: 38rpx; }
.a-quote.strike .a-text { text-decoration: line-through; color: var(--on-surface-variant); }

.a-foot {
  margin-top: 18rpx; padding: 14rpx 20rpx; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: space-between; font-size: 22rpx;
}
.a-actions { display: flex; gap: 12rpx; }
.a-foot-done { margin-top: 12rpx; font-size: 22rpx; }
