<view class="page {{theme === 'light' ? 'theme-light' : ''}}">
  <!-- 规则说明条（德比法庭 · 狂言对决） -->
  <view class="rule glass-panel floodlight-glow">
    <view class="r-ic">
      <view class="v-icon v-gavel text-amber r-gavel"></view>
    </view>
    <view class="r-body">
      <text class="hl hl-md text-amber">德比法庭 · 狂言对决录</text>
      <text class="r-sub mono muted">赛前立字为证 · 赛后开箱审判 · 绝不抵赖</text>
    </view>
  </view>

  <!-- 开庭中焦点战 -->
  <view class="sect sect-gap">
    <text class="sect-title">开庭焦点对决</text>
    <view class="sect-line"></view>
    <view class="chip chip-amber focal-badge" wx:if="{{open}}">开庭审理中</view>
  </view>
  
  <view class="card-highest open-card floodlight-glow" wx:if="{{open}}">
    <view class="open-meta">
      <view class="chip chip-solid">{{open.md}} {{open.hm}}</view>
      <text class="mono muted">{{open.lgZh}}</text>
    </view>
    <view class="open-vs" bindtap="goDetail">
      <view class="ov-side">
        <image class="crest-xl" src="{{open.home.logo}}" mode="aspectFill" wx:if="{{open.home.logo}}" />
        <view class="circle-xl crest-fb" wx:else style="background: {{open.home.bg}}; border-color: {{open.home.bd}};">{{open.home.id}}</view>
        <text class="ov-name hl">{{open.home.zh}}</text>
      </view>
      <view class="ov-mid">
        <view class="ov-x-pill">
          <text class="mono text-amber">VS</text>
        </view>
      </view>
      <view class="ov-side">
        <image class="crest-xl" src="{{open.away.logo}}" mode="aspectFill" wx:if="{{open.away.logo}}" />
        <view class="circle-xl crest-fb" wx:else style="background: {{open.away.bg}}; border-color: {{open.away.bd}};">{{open.away.id}}</view>
        <text class="ov-name hl">{{open.away.zh}}</text>
      </view>
    </view>
    
    <view class="input-wrap card-high">
      <input class="boast-input" maxlength="40" placeholder="押上尊严，立下你的赛前狂言..."
             placeholder-class="input-ph" value="{{text}}" bindinput="onInput" />
      <text class="input-count mono muted">{{count}}/40</text>
    </view>
    
    <button class="btn-amber btn-submit floodlight-glow" bindtap="submit">
      <view class="v-icon v-gavel"></view>
      <text>立字存据 · 提交狂言</text>
    </button>
  </view>
  <view class="card-low empty" wx:else><text class="mono muted">本轮暂无正在开庭的焦点大战</text></view>

  <!-- 赛季统计双卡（_8） -->
  <view class="duo">
    <view class="duo-card card-low teal-glow">
      <view class="d-head">
        <view class="v-icon v-check text-teal d-icon"></view>
        <text class="d-title hl">最准之口</text>
      </view>
      <text class="d-score score-m text-teal hl">{{stats.hit}}</text>
      <text class="mono muted d-lbl">应验场次</text>
      <view class="chip chip-teal d-chip">命中率 {{stats.rate}}</view>
    </view>
    
    <view class="duo-card card-low red-glow">
      <view class="d-head">
        <view class="v-icon v-cross text-error d-icon"></view>
        <text class="d-title hl">最铁嘴皮</text>
      </view>
      <text class="d-score score-m text-error hl">{{stats.miss}}</text>
      <text class="mono muted d-lbl">翻车打脸</text>
      <view class="chip chip-error d-chip">打脸 {{stats.miss}} 次</view>
    </view>
  </view>

  <!-- 狂言存档 -->
  <view class="sect sect-mt">
    <text class="sect-title">法庭判例存档</text>
    <view class="sect-line"></view>
  </view>
  
  <view class="card-low empty" wx:if="{{!archive.length}}"><text class="mono muted">暂无狂言记录，去上方为本轮大战立据！</text></view>
  
  <view class="arch card-low" wx:for="{{archive}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapArchive">
    <view class="a-head">
      <text class="mono muted">{{item.md}}</text>
      <text class="mono flex1 a-teams hl">{{item.names}}</text>
      <view class="chip {{item.result === 'hit' ? 'chip-teal' : item.result === 'miss' ? 'chip-error' : 'chip-amber'}}">
        {{item.result === 'hit' ? '应验' : item.result === 'miss' ? '打脸翻车' : '开庭审理中'}}
      </view>
    </view>
    <view class="a-quote {{item.result === 'miss' ? 'strike' : ''}}">
      <text class="a-text">“{{item.text}}”</text>
    </view>
    <view class="a-foot card-high" wx:if="{{item.finished && !item.result}}">
      <text class="mono muted">终场比分 {{item.sc}} · 请法官自判：</text>
      <view class="a-actions">
        <view class="chip chip-teal" data-id="{{item.id}}" data-r="hit" catchtap="judge">应验</view>
        <view class="chip chip-error" data-id="{{item.id}}" data-r="miss" catchtap="judge">翻车</view>
      </view>
    </view>
    <view class="a-foot-done" wx:elif="{{item.finished}}">
      <text class="mono muted">完赛比分 {{item.sc}}</text>
      <view class="a-link mono text-amber">对决详情 ›</view>
    </view>
    <view class="a-foot-done" wx:else>
      <text class="mono muted">赛前狂言已立据</text>
      <view class="a-link mono text-amber">对决详情 ›</view>
    </view>
  </view>
</view>

