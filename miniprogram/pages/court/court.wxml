<view class="page">
  <!-- 规则说明条 -->
  <view class="rule glass-panel">
    <view class="r-glow"></view>
    <view class="r-ic"><text>⚖️</text></view>
    <view class="r-body">
      <text class="hl hl-md">德比法庭规则</text>
      <text class="r-sub">赛前一句狂言，赛后自动审判</text>
    </view>
  </view>

  <!-- 开庭中 -->
  <view class="sect"><view class="bar-amber"></view><text class="sect-title">开庭中</text></view>
  <view class="card-low open-card" wx:if="{{open}}">
    <view class="open-meta">
      <view class="chip chip-solid">{{open.md}} {{open.hm}}</view>
      <text class="mono muted">{{open.lgZh}}</text>
    </view>
    <view class="open-vs" bindtap="goDetail">
      <view class="ov-side">
        <view class="circle-xl">{{open.home.id}}</view>
        <text class="ov-name">{{open.home.zh}}</text>
      </view>
      <text class="ov-x">VS</text>
      <view class="ov-side">
        <view class="circle-xl">{{open.away.id}}</view>
        <text class="ov-name">{{open.away.zh}}</text>
      </view>
    </view>
    <view class="input-wrap">
      <input class="boast-input" maxlength="40" placeholder="留下你的狂言 (限40字)..."
             value="{{text}}" bindinput="onInput" />
      <text class="input-count mono">{{count}}</text>
    </view>
    <view class="btn-amber" bindtap="submit"><text>📢</text><text>提交狂言</text></view>
  </view>
  <view class="card-low empty" wx:else><text class="muted">暂无开庭中的焦点战</text></view>

  <!-- 赛季统计双卡 -->
  <view class="duo">
    <view class="duo-card card-low teal">
      <view class="d-ic"><text>✅</text></view>
      <text class="d-title">最准之口</text>
      <view class="d-ava circle-xl">{{stats.hit}}</view>
      <text class="d-name">我的狂言</text>
      <view class="chip chip-teal">命中率 {{stats.rate}}</view>
    </view>
    <view class="duo-card card-low dim2">
      <view class="d-ic"><text>🙃</text></view>
      <text class="d-title">最铁嘴皮</text>
      <view class="d-ava circle-xl">{{stats.miss}}</view>
      <text class="d-name muted">我的狂言</text>
      <view class="chip chip-ghost">翻车 {{stats.miss}} 次</view>
    </view>
  </view>

  <!-- 狂言存档 -->
  <view class="sect sect-mt"><view class="bar-teal"></view><text class="sect-title">狂言存档</text><view class="sect-line"></view></view>
  <view class="card-low empty" wx:if="{{!archive.length}}"><text class="muted">还没有狂言，去上面开一句</text></view>
  <view class="arch card-low" wx:for="{{archive}}" wx:key="id">
    <view class="a-head">
      <text class="mono muted">{{item.md}}</text>
      <view class="a-dot"></view>
      <text class="mono muted flex1">{{item.names}}</text>
      <view class="chip {{item.result === 'hit' ? 'chip-teal' : item.result === 'miss' ? 'chip-ghost' : 'chip-amber'}}">
        {{item.result === 'hit' ? '应验' : item.result === 'miss' ? '翻车' : '待审判'}}
      </view>
    </view>
    <view class="a-quote {{item.result === 'miss' ? 'strike' : ''}}">
      <text class="a-text">"{{item.text}}"</text>
    </view>
    <view class="a-foot" wx:if="{{item.finished && !item.result}}">
      <text class="mono muted">比分 {{item.sc}} · 自判：</text>
      <view class="chip chip-teal" data-id="{{item.id}}" data-r="hit" bindtap="judge">应验</view>
      <view class="chip chip-error" data-id="{{item.id}}" data-r="miss" bindtap="judge">翻车</view>
    </view>
    <view class="a-foot" wx:elif="{{item.finished}}">
      <text class="mono muted">比分 {{item.sc}}</text>
    </view>
  </view>
</view>
