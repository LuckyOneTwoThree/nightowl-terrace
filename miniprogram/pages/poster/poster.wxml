<view class="page {{theme === 'light' ? 'theme-light' : ''}}" wx:if="{{m}}">
  <!-- 动态环境微光 -->
  <view class="glow glow-amber"></view>

  <!-- ==================== 1. 海报预览卡片 (9:16 沉浸比例) ==================== -->
  <view class="poster card-highest floodlight-glow">
    <view class="p-inner">
      <view class="p-bar" style="background: linear-gradient(90deg, {{m.lgAccent || '#38003C'}} 0%, #00FF85 50%, #E90052 100%);"></view>
      
      <view class="p-head">
        <view class="p-lg mono muted">
          <text>{{m.lgZh || m.lgEn}} · 焦点巡礼</text>
        </view>
        <view class="p-slogan-row">
          <view class="v-icon v-bolt text-amber p-mascot"></view>
          <view class="p-slogan-col">
            <text class="p-title hl">{{slogan}}</text>
            <text class="p-sub mono muted">{{sub}}</text>
          </view>
        </view>
      </view>

      <view class="p-vs">
        <view class="p-side">
          <image class="crest-lg" src="{{m.home.logo}}" mode="aspectFill" wx:if="{{m.home.logo}}" />
          <view class="circle-lg crest-fb" wx:else style="background: {{m.home.bg}}; border-color: {{m.home.bd}};">{{m.home.id}}</view>
          <text class="p-name hl">{{m.home.zh}}</text>
        </view>
        <view class="p-mid">
          <text class="p-x mono muted hl">VS</text>
        </view>
        <view class="p-side">
          <image class="crest-lg" src="{{m.away.logo}}" mode="aspectFill" wx:if="{{m.away.logo}}" />
          <view class="circle-lg crest-fb" wx:else style="background: {{m.away.bg}}; border-color: {{m.away.bd}};">{{m.away.id}}</view>
          <text class="p-name hl">{{m.away.zh}}</text>
        </view>
      </view>

      <view class="p-time card-high">
        <text class="p-day mono muted">{{m.dateHeader}}</text>
        <text class="p-hm mono hl text-amber score-m">{{m.hm}}</text>
        <view class="p-stars-row">
          <text class="star-on text-amber mono">{{m.stars}}</text>
        </view>
        <view class="chip chip-amber p-idx mono">夜猫指数 {{m.indexText}} · {{m.tierLabel}}</view>
      </view>

      <view class="p-points card-low" wx:if="{{m.points.length}}">
        <view class="p-pt" wx:for="{{m.points}}" wx:key="*this">
          <view class="p-dot2"></view>
          <text class="p-pt-text">{{item}}</text>
        </view>
      </view>

      <text class="p-foot mono muted">夜猫追球 · NIGHT OWL MATCH</text>
    </view>
  </view>

  <!-- 离屏 Canvas (1080×1920 导出) -->
  <canvas type="2d" id="poster" class="p-canvas"></canvas>

  <!-- ==================== 2. 底部操作区 ==================== -->
  <view class="poster-acts">
    <button class="btn-amber poster-btn floodlight-glow" bindtap="save">
      <view class="v-icon v-download"></view>
      <text>保存到相册</text>
    </button>
    <button class="btn-teal-ghost poster-btn" bindtap="share">
      <view class="v-icon v-paw text-teal"></view>
      <text>复制战报进群</text>
    </button>
  </view>
</view>
