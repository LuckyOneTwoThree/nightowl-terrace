<view class="page {{theme === 'light' ? 'theme-light' : ''}}" wx:if="{{m}}">
  <!-- 9:16 海报预览（_10） -->
  <view class="poster card-highest floodlight-glow">
    <view class="p-inner">
      <view class="p-bar" style="background: linear-gradient(90deg, {{m.lgAccent}}, #00FF85, #E90052);"></view>

      <view class="p-head">
        <view class="p-lg chip chip-ghost">
          <view class="v-icon v-soccer text-teal"></view>
          <text>{{m.lgEn}}</text>
        </view>
        <view class="p-slogan-row">
          <view class="v-icon v-paw text-amber p-mascot"></view>
          <view class="p-slogan-col">
            <text class="p-title hl">{{slogan}}</text>
            <text class="p-sub mono muted">{{sub}}</text>
          </view>
        </view>
      </view>

      <view class="p-vs">
        <view class="p-side">
          <image class="crest-xl" src="{{m.home.logo}}" mode="aspectFill" wx:if="{{m.home.logo}}" /><view class="circle-xl crest-fb" wx:else style="background: {{m.home.bg}}; border-color: {{m.home.bd}};">{{m.home.id}}</view>
          <text class="p-name hl">{{m.home.zh}}</text>
        </view>
        <view class="p-mid">
          <text class="p-x mono muted">VS</text>
        </view>
        <view class="p-side">
          <image class="crest-xl" src="{{m.away.logo}}" mode="aspectFill" wx:if="{{m.away.logo}}" /><view class="circle-xl crest-fb" wx:else style="background: {{m.away.bg}}; border-color: {{m.away.bd}};">{{m.away.id}}</view>
          <text class="p-name hl">{{m.away.zh}}</text>
        </view>
      </view>

      <view class="p-time card-low">
        <text class="mono muted p-day">{{m.dateHeader}}</text>
        <text class="p-hm score-m hl text-amber text-glow">{{m.hm}}</text>
        <view class="p-stars-row">
          <text class="star-on text-amber mono">{{m.stars}}</text>
        </view>
        <view class="chip chip-amber p-idx">
          <view class="v-icon v-bolt text-amber"></view>
          <text class="mono">夜猫指数 {{m.indexText}}</text>
        </view>
      </view>

      <view class="p-points card-low">
        <view class="p-pt" wx:for="{{m.points.length ? m.points : ['本轮焦点大战', '熬夜成本 ' + m.cost + 'h']}}" wx:key="*this">
          <view class="p-dot2"></view>
          <text class="p-pt-text">{{item}}</text>
        </view>
      </view>

      <view class="p-foot mono muted">夜猫看台 · NIGHT OWL TERRACE</view>
    </view>
  </view>

  <!-- 离屏画布（保存用） -->
  <canvas type="2d" id="poster" class="p-canvas"></canvas>

  <!-- 操作 -->
  <view class="poster-acts">
    <button class="btn-amber poster-btn floodlight-glow" bindtap="save">
      <view class="v-icon v-gift"></view>
      <text>保存高清海报</text>
    </button>
    <button class="btn-teal-ghost poster-btn p-share" bindtap="share">
      <view class="v-icon v-paw text-teal"></view>
      <text>分享给球友</text>
    </button>
  </view>
</view>

