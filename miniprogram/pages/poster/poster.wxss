.page { padding: 32rpx 32rpx 64rpx; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }

/* 海报预览：padding-bottom 177.78% 撑 9:16 高度 */
.poster {
  position: relative; width: 88%; max-width: 640rpx; height: 0; padding-bottom: 177.78%;
  background: var(--bg); border-radius: 40rpx; overflow: hidden;
  border: 1rpx solid rgba(255,178,36,.3); box-shadow: 0 32rpx 96rpx rgba(0,0,0,.8);
}
.p-inner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; }
.p-bar { height: 10rpx; width: 100%; flex-shrink: 0; }

.p-head { padding: 32rpx 32rpx 12rpx; text-align: center; }
.p-lg { display: inline-flex; align-items: center; gap: 8rpx; font-size: 22rpx; margin-bottom: 16rpx; }
.p-slogan-row { display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.p-mascot { width: 44rpx; height: 44rpx; }
.p-slogan-col { display: flex; flex-direction: column; align-items: flex-start; gap: 2rpx; }
.p-title { font-size: 38rpx; font-weight: 700; color: var(--primary-container); }
.p-sub { font-size: 20rpx; }

.p-vs { flex: 1; display: flex; align-items: center; justify-content: space-between; padding: 0 20rpx; }
.p-side { width: 180rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.p-name { font-size: 30rpx; font-weight: 700; color: var(--on-surface); text-align: center; max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-mid { flex: 1; min-width: 0; text-align: center; }
.p-x { font-size: 36rpx; font-weight: 700; }

.p-time {
  margin: 0 32rpx 24rpx; padding: 24rpx 16rpx;
  border-radius: var(--r-lg);
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.p-day { font-size: 24rpx; }
.p-hm { font-size: 52rpx; font-weight: 700; line-height: 56rpx; }
.p-stars-row { display: flex; gap: 4rpx; margin: 4rpx 0; }
.star-on { font-size: 28rpx; }
.p-idx { font-size: 20rpx; padding: 4rpx 18rpx; }

.p-points { margin: 0 32rpx 16rpx; padding: 16rpx 24rpx; display: flex; flex-direction: column; gap: 12rpx; border-radius: var(--r-md); }
.p-pt { display: flex; align-items: center; gap: 12rpx; }
.p-dot2 { width: 10rpx; height: 10rpx; border-radius: var(--r-full); background: var(--secondary); flex-shrink: 0; box-shadow: 0 0 8rpx rgba(68,226,205,.6); }
.p-pt-text { color: var(--on-surface-variant); font-size: 22rpx; }
.p-foot { margin-top: auto; padding-bottom: 24rpx; text-align: center; font-size: 18rpx; }

/* 离屏画布 */
.p-canvas { position: fixed; left: -9999rpx; top: 0; width: 340px; height: 604px; }

/* 操作 */
.poster-acts { margin-top: 40rpx; width: 88%; max-width: 640rpx; display: flex; flex-direction: column; gap: 20rpx; }
.p-share { width: 100%; }
