/**
 * Midnight Match 设计系统 · 完整 token 与视觉规范
 * 来源：stitch_night_owl_terrace_ui/night_owl_terrace/DESIGN.md（SSOT）
 */

/** 内联等宽字体（JetBrains Mono 子集 · ASCII+中点，woff2 base64 约 41KB）
 * 体积优先零网络依赖：不再走 wx.loadFontFace 远程加载（域名白名单/jsdelivr 可用性问题），
 * 星号★等符号码位子集未含，自动回退系统字体 */
@font-face { font-family: 'JetBrains Mono'; src: url(data:font/woff2;charset=utf-8;base64,) format('woff2'); font-weight: 400; font-style: normal; }
@font-face { font-family: 'JetBrains Mono'; src: url(data:font/woff2;charset=utf-8;base64,) format('woff2'); font-weight: 700; font-style: normal; }

page {
  /* 表面层级（Stadium Deep Obsidian 纯净深邃黑曜石体系 · 彻底消除灰泥感）
   * 采用 Apple / Linear 顶级深色设计规范：超低明度底色 + 极细腻层级阶梯，沉稳内敛 */
  --bg: #080B10;
  --sc-lowest: #040608;
  --sc-low: #0E131C;
  --sc: #131A26;
  --sc-high: #182030;
  --sc-highest: #1E283A;
  --sc-variant: #222E42;

  /* 文字体系（纯白主标题 + 柔和冷灰辅文） */
  --on-surface: #FFFFFF;
  --on-surface-variant: #8E9AB0;
  --outline: #475569;
  --outline-variant: #1E293B;

  /* 品牌能量色彩（电光金 + 绿茵青碧） */
  --primary: #FFE58F;            /* 亮香槟金 · 文字/高光 */
  --primary-container: #FFB800;  /* 电光金 · 填充/强调 */
  --on-primary: #1A1200;
  --on-primary-container: #4D3300;
  --surface-tint: #FFB800;
  --secondary: #00E5BE;          /* 球场青碧 · LIVE/健康/焦点 */
  --secondary-container: #00C4A0;
  --on-secondary: #002922;
  --tertiary: #A78BFA;
  --tertiary-container: #8B5CF6;
  --error: #FF5A5F;
  --error-container: #991B1B;

  /* 半透明描边与发丝线（极细致冷白微光，告别厚重灰边） */
  --outline-muted: rgba(255, 255, 255, 0.05);
  --hairline: rgba(255, 255, 255, 0.07);
  --line-strong: rgba(255, 255, 255, 0.10);
  --line-heavy: rgba(255, 255, 255, 0.16);

  /* 字体族 */
  --font-headline: "Hanken Grotesk", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-body: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", "SF Mono", Menlo, Consolas, Monaco, monospace;

  /* 圆角 */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-xl: 28rpx;
  --r-full: 999rpx;

  /* 间距 */
  --sp-tight: 8rpx;
  --sp-base: 16rpx;
  --sp-card-gap: 24rpx;
  --sp-container: 32rpx;
  --sp-section: 48rpx;

  background-color: #080B10;
  background: var(--bg, #080B10);
  color: var(--on-surface);
  font-family: var(--font-body);
  font-size: 28rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

/* ================= 浅色主题 · 晨曦看台 (Daylight Terrace) ================= */
.theme-light, page.theme-light {
  /* 表面层级 */
  --bg: #F4F5F7;
  background-color: #F4F5F7;
  --sc-lowest: #FFFFFF;
  --sc-low: #FFFFFF;
  --sc: #FFFFFF;
  --sc-high: #F0F2F5;
  --sc-highest: #E4E7EC;
  --sc-variant: #E4E7EC;

  /* 文字 */
  --on-surface: #111827;
  --on-surface-variant: #64748B;
  --outline: #94A3B8;
  --outline-variant: #CBD5E1;

  /* 品牌色（浅色高对比度） */
  --primary: #B45309;
  --primary-container: #D97706; /* 暖金琥珀 */
  --on-primary: #FFFFFF;
  --on-primary-container: #78350F;
  --surface-tint: #D97706;
  --secondary: #0D9488;         /* 清爽青绿 */
  --secondary-container: #14B8A6;
  --on-secondary: #FFFFFF;
  --tertiary: #6D28D9;
  --tertiary-container: #7C3AED;
  --error: #E11D48;
  --error-container: #FFE4E6;

  /* 半透明描边与发丝线 */
  --outline-muted: rgba(0, 0, 0, 0.07);
  --hairline: rgba(0, 0, 0, 0.08);
  --line-strong: rgba(0, 0, 0, 0.12);
  --line-heavy: rgba(0, 0, 0, 0.16);
}

.page {
  background-color: #080B10;
  background: var(--bg, #080B10);
  color: var(--on-surface);
  min-height: 100vh;
  box-sizing: border-box;
}

.theme-light .page, .theme-light.page {
  background-color: #F4F5F7;
  background: var(--bg, #F4F5F7);
}

.theme-light .card-low {
  background: var(--sc-low) !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  color: #111827;
}
.theme-light .card-high {
  background: var(--sc-high) !important;
  color: #111827;
}
.theme-light .card-highest {
  background: var(--sc-highest) !important;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06) !important;
  color: #111827;
}
.theme-light .glass-panel {
  background: rgba(255, 255, 255, 0.94) !important;
  border: 1rpx solid rgba(0, 0, 0, 0.06) !important;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  color: #111827;
}
.theme-light .topbar {
  background: #F4F5F7 !important;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06) !important;
}
.theme-light .sticky-bar {
  background: rgba(244, 245, 247, 0.96) !important;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06) !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04) !important;
}
.theme-light .bottom-bar {
  background: rgba(255, 255, 255, 0.95) !important;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08) !important;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05) !important;
}
.theme-light .btn-amber {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF !important;
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.25);
}
.theme-light .btn-amber:active {
  background: #B45309;
}
.theme-light .btn-outline {
  border: 2rpx solid rgba(0, 0, 0, 0.15);
  color: var(--on-surface);
  background: #FFFFFF;
}
.theme-light .btn-outline:active {
  background: #F1F5F9;
}
.theme-light .btn-teal-ghost {
  border: 1rpx solid rgba(13, 148, 136, 0.4);
  color: #0D9488;
  background: rgba(13, 148, 136, 0.08);
}
.theme-light .chip-ghost {
  background: #E2E8F0;
  color: #475569;
}
.theme-light .chip-amber {
  background: rgba(217, 119, 6, 0.12);
  color: #B45309;
}
.theme-light .chip-teal {
  background: rgba(13, 148, 136, 0.12);
  color: #0F766E;
}
.theme-light .chip-error {
  background: rgba(225, 29, 72, 0.12);
  color: #BE123C;
}
.theme-light .floodlight-glow {
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.18);
}
.theme-light .text-glow {
  text-shadow: none;
}
.theme-light .glow-amber {
  background: rgba(217, 119, 6, 0.06);
}
.theme-light .glow-teal {
  background: rgba(13, 148, 136, 0.05);
}
.theme-light .hl {
  color: #111827;
}
.theme-light .muted {
  color: #64748B !important;
}
.theme-light .text-amber {
  color: #D97706 !important;
}
.theme-light .text-teal {
  color: #0D9488 !important;
}
.theme-light .text-error {
  color: #E11D48 !important;
}
.theme-light .avatar-box {
  background: #FFFFFF !important;
  border-color: rgba(217, 119, 6, 0.5) !important;
  color: #D97706 !important;
  box-shadow: 0 4rpx 16rpx rgba(217, 119, 6, 0.15) !important;
}
.theme-light .ring-inner {
  background: #FFFFFF !important;
}
.theme-light .hl-wrap {
  background: linear-gradient(135deg, rgba(217, 119, 6, 0.4), rgba(0, 0, 0, 0.08)) !important;
}
.theme-light .hl-card {
  background: #FFFFFF !important;
}
.theme-light .hl-head {
  background: rgba(217, 119, 6, 0.06) !important;
}
.theme-light .dchip {
  background: #FFFFFF !important;
  border: 1rpx solid rgba(0, 0, 0, 0.08) !important;
}
.theme-light .dchip .dchip-wd {
  color: #64748B !important;
}
.theme-light .dchip.on {
  background: #D97706 !important;
