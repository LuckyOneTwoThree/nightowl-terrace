/* 浅色模式专属联赛药丸与筛选配色 */
.theme-light .fpill { background: #FFFFFF; border-color: rgba(0,0,0,0.08); color: #64748B; }
.theme-light .fpill.on-ALL { background: #D97706 !important; color: #FFFFFF !important; font-weight: 700; border-color: transparent; }
.theme-light .fpill.on-PL { background: #F3E8FF !important; color: #7E22CE !important; border-color: rgba(126,34,206,.3) !important; font-weight: 700; }
.theme-light .fpill.on-PD { background: #FFEDD5 !important; color: #C2410C !important; border-color: rgba(194,65,12,.3) !important; font-weight: 700; }
.theme-light .fpill.on-SA { background: #E0F2FE !important; color: #0369A1 !important; border-color: rgba(3,105,161,.3) !important; font-weight: 700; }
.theme-light .fpill.on-BL { background: #FEE2E2 !important; color: #B91C1C !important; border-color: rgba(185,28,28,.3) !important; font-weight: 700; }
.theme-light .fpill.on-FL { background: #ECFDF5 !important; color: #047857 !important; border-color: rgba(4,120,87,.3) !important; font-weight: 700; }
.theme-light .fpill.on-SCG { background: #FEF3C7 !important; color: #B45309 !important; border-color: rgba(180,83,9,.3) !important; font-weight: 700; }
.theme-light .star-pill.on-ALL { background: #FEF3C7 !important; color: #B45309 !important; border-color: rgba(180,83,9,.3) !important; }




view, scroll-view, text, button, input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  font-weight: normal;
  font-size: inherit;
  line-height: normal;
  color: inherit;
  background-color: transparent;
  border-radius: 0;
  width: auto;
}

button::after {
  border: none;
}

/* ---------- 版式原子 ---------- */

.hl { font-family: var(--font-headline); font-weight: 700; }
.hl-lg { font-family: var(--font-headline); font-size: 48rpx; line-height: 64rpx; font-weight: 700; }
.hl-md { font-family: var(--font-headline); font-size: 38rpx; line-height: 52rpx; font-weight: 600; }
.body-sm { font-family: var(--font-body); font-size: 26rpx; line-height: 38rpx; }
.mono { font-family: var(--font-mono); font-size: 24rpx; line-height: 32rpx; letter-spacing: 1rpx; font-weight: 500; }
.score-m { font-family: var(--font-mono); font-size: 64rpx; line-height: 64rpx; font-weight: 700; letter-spacing: -1rpx; }
.score-sm { font-family: var(--font-mono); font-size: 40rpx; line-height: 40rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.muted { color: var(--on-surface-variant); }
.text-amber { color: var(--primary-container); }
.text-teal { color: var(--secondary); }
.text-error { color: var(--error); }

/* 段落标题：文字 + 延伸发丝线（Stitch h2 pattern） */
.sect {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.sect-title { font-family: var(--font-headline); font-size: 38rpx; font-weight: 600; color: var(--on-surface); white-space: nowrap; }
.sect-line { flex: 1; height: 2rpx; background: linear-gradient(90deg, var(--outline-muted) 0%, var(--outline-muted) 100%); }
.sect-more { font-family: var(--font-mono); font-size: 24rpx; color: var(--on-surface-variant); }

/* ---------- 表面与层级 ---------- */

.card-low { 
  background: var(--sc-low); 
  border: 1rpx solid var(--outline-muted); 
  border-radius: var(--r-xl); 
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04); 
}
.card-high {
  background: var(--sc-high);
  border: 1rpx solid var(--hairline);
  border-radius: var(--r-xl);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.card-highest { 
  background: var(--sc-highest);
  border: 1rpx solid var(--hairline);
  border-radius: var(--r-xl);
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,.45), inset 0 1rpx 0 rgba(255,255,255,.07); 
}
.inner-border { box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.05); }

/* 玻璃面板（Glassmorphism · 纯净深邃黑曜石微透质感） */
.glass-panel {
  background: linear-gradient(145deg, rgba(21, 28, 40, 0.90) 0%, rgba(11, 15, 22, 0.85) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--outline-muted);
}

/* ---------- 光效与动效（克制版：辉光只作焦点提示，透明度收敛避免"电竞 RGB"感） ---------- */

.floodlight-glow { box-shadow: 0 0 20rpx 0 rgba(255, 178, 36, 0.14); }
.floodlight-teal { box-shadow: 0 0 20rpx 0 rgba(20, 224, 191, 0.14); }
.text-glow { text-shadow: 0 0 14rpx rgba(255, 178, 36, 0.3); }
.text-glow-teal { text-shadow: 0 0 14rpx rgba(20, 224, 191, 0.3); }
.glow-amber { box-shadow: 0 0 10rpx rgba(255, 178, 36, 0.3); }

@keyframes pulse-dot { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(0.85); } }
.animate-pulse { animation: pulse-dot 1.8s ease-in-out infinite; }

/* 状态呼吸灯点 */
.dot-teal { 
  width: 14rpx; height: 14rpx; border-radius: var(--r-full); 
  background: var(--secondary); 
  box-shadow: 0 0 8rpx rgba(20, 224, 191, 0.45); 
  display: inline-block; 
}
.dot-amber { 
  width: 14rpx; height: 14rpx; border-radius: var(--r-full); 
  background: var(--primary-container); 
  box-shadow: 0 0 8rpx rgba(255, 178, 36, 0.45); 
  display: inline-block; 
}

/* ---------- 徽标 / 药丸 / Chips ---------- */

/* 联赛实心小标 */
.lg-chip {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 6rpx 16rpx; border-radius: var(--r-sm);
  font-family: var(--font-mono); font-size: 22rpx; line-height: 1;
  color: #FFFFFF; font-weight: 600;
}

/* Stitch 药丸：10% 底 + 30% 描边（描边过重会与石墨表面打架） */
.chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx; border-radius: var(--r-full);
  font-family: var(--font-mono); font-size: 22rpx; line-height: 1;
}
.chip-amber { background: rgba(255,178,36,.1); border: 1rpx solid rgba(255,178,36,.3); color: var(--primary-container); }
.chip-teal { background: rgba(20,224,191,.07); border: 1rpx solid rgba(20,224,191,.3); color: var(--secondary); }
.chip-error { background: rgba(255,180,171,.08); border: 1rpx solid rgba(255,180,171,.3); color: var(--error); }
.chip-solid { background: var(--sc-high); border: 1rpx solid var(--hairline); color: var(--primary-container); }
.chip-ghost { background: var(--sc-high); border: 1rpx solid var(--hairline); color: var(--on-surface-variant); }

/* 联赛筛选药丸（_4 配色：暗底联赛同系色） */
.fpill {
  flex-shrink: 0; padding: 12rpx 36rpx; border-radius: var(--r-full);
  font-family: var(--font-mono); font-size: 24rpx; line-height: 1;
  background: var(--sc-high); color: var(--on-surface-variant); border: 1rpx solid var(--hairline);
  transition: all .2s ease;
}
.fpill.on-ALL { background: var(--primary-container); color: var(--on-primary); font-weight: 700; box-shadow: 0 0 18rpx rgba(255,178,36,.14); border-color: transparent; }
.fpill.on-PL { background: #1E1025; color: #D8B4E2; border-color: rgba(216,180,226,.35); font-weight: 600; }
.fpill.on-PD { background: #27150A; color: #FFB86B; border-color: rgba(255,184,107,.35); font-weight: 600; }
.fpill.on-SA { background: #0E1A26; color: #8AB4F8; border-color: rgba(138,180,248,.35); font-weight: 600; }
.fpill.on-BL { background: #26100F; color: #FF8E8E; border-color: rgba(255,142,142,.35); font-weight: 600; }
.fpill.on-FL { background: #0E241C; color: #6EE7B7; border-color: rgba(110,231,183,.35); font-weight: 600; }
.fpill.on-SCG { background: #26200A; color: #FDE68A; border-color: rgba(253,230,138,.35); font-weight: 600; }

/* ---------- 按钮 ---------- */

.btn-amber {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  width: 100%; padding: 26rpx 0; border-radius: var(--r-xl);
  background: var(--primary-container); color: var(--on-primary);
  font-family: var(--font-headline); font-size: 34rpx; font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(255,178,36,.12);
  border: none; white-space: nowrap;
  transition: transform .15s ease, opacity .15s ease;
}
.btn-amber:active { transform: scale(0.98); opacity: .9; }

.btn-teal-ghost {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 18rpx 0; border-radius: var(--r-md);
  background: transparent; box-shadow: inset 0 0 0 2rpx var(--secondary);
  color: var(--secondary); font-size: 28rpx; font-weight: 600; white-space: nowrap;
  transition: all .15s ease;
}
.btn-teal-ghost:active { background: rgba(20,224,191,.1); transform: scale(0.98); }

.btn-outline {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 16rpx 28rpx; border-radius: var(--r-md);
  border: 1rpx solid var(--outline-muted);
  color: var(--on-surface); font-size: 28rpx; white-space: nowrap;
}
.btn-outline:active { background: var(--sc-high); }

/* ---------- 球队圆标（三字码） ---------- */

.circle-xl {
  width: 108rpx; height: 108rpx; border-radius: var(--r-full);
  background: var(--sc-low); border: 1rpx solid var(--sc-variant);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-headline); font-size: 34rpx; font-weight: 700; color: var(--on-surface);
  box-shadow: inset 0 0 16rpx rgba(0,0,0,.4);
}
.circle-md {
  width: 68rpx; height: 68rpx; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 22rpx; font-weight: 600; color: var(--on-surface);
  background: var(--sc-low); border: 1rpx solid var(--sc-variant);
}
.circle-sm {
  width: 44rpx; height: 44rpx; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 18rpx; font-weight: 600; color: var(--on-surface);
  background: var(--sc-highest); border: 1rpx solid var(--sc-variant);
}

/* ---------- 队徽图标（CDN 远程加载） ---------- */
.crest-xl {
  width: 108rpx; height: 108rpx; border-radius: var(--r-full);
  background: var(--sc-low);
}
.crest-sm {
  width: 44rpx; height: 44rpx; border-radius: var(--r-full);
  background: var(--sc-highest);
}
.crest-md {
  width: 68rpx; height: 68rpx; border-radius: var(--r-full);
  background: var(--sc-low);
}
.crest-fb {
  /* 队徽未收录时保留纯色圆标兜底，与 crest 互斥显示 */
}

/* ---------- 列表行 ---------- */

.menu-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx; border-bottom: 1rpx solid var(--outline-muted);
}
.menu-row:last-child { border-bottom: none; }

/* ---------- 弹窗与抽屉（Modals & Bottom Sheet） ---------- */

.modal-backdrop {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 999;
  opacity: 0; pointer-events: none;
  transition: opacity .25s ease;
}
.modal-backdrop.show { opacity: 1; pointer-events: auto; }

.bottom-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--sc);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  border-top: 1rpx solid var(--outline-muted);
  box-shadow: 0 -16rpx 48rpx rgba(0,0,0,.6);
  z-index: 1000;
  transform: translateY(100%);
  transition: transform .3s cubic-bezier(0.16, 1, 0.3, 1);
  padding-bottom: env(safe-area-inset-bottom, 32rpx);
}
.bottom-sheet.show { transform: translateY(0); }

.sheet-handle {
  width: 72rpx; height: 8rpx; border-radius: var(--r-full);
  background: var(--outline-muted);
  margin: 20rpx auto 16rpx;
}

.center-modal {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.92);
  width: calc(100% - 64rpx); max-width: 680rpx;
  background: var(--sc);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--line-strong);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,.8);
  z-index: 1000;
  opacity: 0; pointer-events: none;
  transition: all .25s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}
.center-modal.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1; pointer-events: auto;
}

/* ---------- 纯 CSS 矢量图标集 (替代粗糙 Emoji) ---------- */

.v-icon {
  display: inline-flex; align-items: center; justify-content: center;
  position: relative; vertical-align: middle;
}

