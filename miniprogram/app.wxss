  border-top: 1rpx solid rgba(0, 0, 0, 0.08) !important;
}
.theme-light .sheet-handle {
  background: #CBD5E1 !important;
}
.theme-light .modal-mask,
.theme-light .modal-backdrop {
  background: rgba(0, 0, 0, 0.45) !important;
}
.theme-light .center-modal,
.theme-light .nick-modal {
  background: #FFFFFF !important;
  border-color: rgba(217, 119, 6, 0.4) !important;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.12) !important;
}
.theme-light .modal-input-row {
  background: #F1F4F8 !important;
